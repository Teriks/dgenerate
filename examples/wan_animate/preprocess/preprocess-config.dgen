#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Same simplified path as animate/animate-config.dgen: wan-driving= plus
# --wan-animate-preprocess. Official Wan2.2 animate demo assets.

\setp image "https://raw.githubusercontent.com/Wan-Video/Wan2.2/main/examples/wan_animate/animate/image.jpeg"
\setp driving "https://raw.githubusercontent.com/Wan-Video/Wan2.2/main/examples/wan_animate/animate/video.mp4"

Wan-AI/Wan2.2-Animate-14B-Diffusers
--model-type wan-animate
--dtype bfloat16
--model-sequential-offload
--wan-animate-preprocess
--inference-steps 20
--guidance-scales 1
--video-fps 30
--gen-seeds 42
--output-size 832x480
--animation-format mp4
--output-path wan-animate-preprocess
--image-seeds "{{ image }};wan-driving={{ driving }};frame-end=48"
--prompts "A fantasy woman with pale lavender skin, glowing yellow eyes, pointed ears, and long dark hair, wearing dark ornate armor with gold accents. She performs the motion from the driving video. Cinematic lighting, ultrarealistic detail."
