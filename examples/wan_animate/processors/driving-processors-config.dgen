#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Derive pose and face from wan-driving= with dedicated processors
# instead of --wan-animate-preprocess. --wan-pose-image-processors runs
# openpose on the driving frames; --wan-face-image-processors uses yolo
# crop mode for a square face crop. --wan-driving-image-processors can
# also alter the driving clip before those chains run (flip here).

Wan-AI/Wan2.2-Animate-14B-Diffusers
--model-type wan-animate
--dtype bfloat16
--model-sequential-offload
--inference-steps 20
--guidance-scales 1
--video-fps 30
--gen-seeds 1
--output-size 832x480
--animation-format mp4
--output-path wan-animate-driving-processors
--wan-driving-image-processors flip
--wan-pose-image-processors "openpose;include-hand=true"
--wan-face-image-processors "yolo;model=Bingsu/adetailer;weight-name=face_yolov8n.pt;crops=True;crop-square=True;crop-scale=1.4;crop-size=512"
--image-seeds "../../media/man-fighting-pose.jpg;wan-driving=../../media/rickroll-roll.gif;frame-end=24"
--prompts "A boxer dances in place. The camera stays fixed."
