#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Hunyuan-DiT v1.2 GGUF, Diffusers tensor names (no -comfy).
# https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants

Tencent-Hunyuan/HunyuanDiT-v1.2-Diffusers
--model-type hydit
--dtype float16
--transformer https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/transformer-Q4_K.gguf
--inference-steps 50
--guidance-scales 5
--gen-seeds 1
--output-path hydit-gguf
--output-size 1024
--prompts "A porcelain vase with blue floral patterns on a wooden table, soft studio lighting, product photography"
