#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Fantasy Vision DiT, a Hunyuan-DiT v1.2 fine-tune.
# https://civitai.com/models/638641/fantasy-vision-dit
# The file is the transformer only. BERT, T5, and the VAE load from
# Tencent-Hunyuan/HunyuanDiT-v1.2-Diffusers.

\set civit_ai_token %CIVIT_AI_TOKEN%

{% if not civit_ai_token.strip() %}
    \print Set CIVIT_AI_TOKEN environmental variable to run this example!
    \exit
{% endif %}

https://civitai.com/api/download/models/714161?fileId=628851
--model-type hydit
--dtype float16
--inference-steps 50
--guidance-scales 5
--gen-seeds 1
--output-path hydit-civitai
--output-size 1024
--prompts "A hilltop castle at dusk, banners in the wind, warm torchlight, fantasy illustration"
