#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# RegionE on Qwen-Image-Edit-2509 (Edit-Plus). Requires 28 inference steps and input image(s).

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 24 %}
    \set optimization --quantizer bnb;bits=4 --quantizer-map text_encoder
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 24 %}
    \set optimization --quantizer sdnq;type=int4 --quantizer-map text_encoder
{% else %}
    \set optimization --model-sequential-offload
{% endif %}


Qwen/Qwen-Image-Edit-2509
--model-type qwen-image-edit {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 28
--guidance-scales 4
--image-seeds "images: ../../media/beach.jpg, ../../media/horse1.jpg"
--gen-seeds 1
--output-path qwen-image-edit-plus-regione
--output-size 1024
--regione-thresholds 0.80
--regione-cache-thresholds 0.03
--prompts "Put the horse on the beach"
