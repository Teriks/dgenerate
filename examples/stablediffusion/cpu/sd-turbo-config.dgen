#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# SD-Turbo is distilled for one step at guidance 0. The checkpoint's
# own scheduler is already correct. The tiny autoencoder replaces the full VAE.

stabilityai/sd-turbo
--dtype float32
--device cpu
--vae AutoencoderTiny;model=madebyollin/taesd
--inference-steps 1
--guidance-scales 0
--gen-seeds 1
--output-size 512
--output-path sd-turbo
--prompts "a small puppy"
