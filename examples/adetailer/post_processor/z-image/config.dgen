#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Z-Image Turbo is public. Adetailer reuses this pipeline to inpaint detections.
# Turbo uses guidance 0. The face pass uses the same step count and a light strength.

\setp gpu_memory_gib total_memory(unit='gib')

{% if not have_cuda() or gpu_memory_gib <= 16 %}
    \set optimization --model-sequential-offload
{% endif %}


Tongyi-MAI/Z-Image-Turbo
--model-type z-image {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 8
--guidance-scales 0
--gen-seeds 1
--output-path z-image-adetailer
--output-size 1024
--post-processors adetailer;\
                  model=Bingsu/adetailer;\
                  weight-name=face_yolov8n.pt;\
                  prompt="a detailed face, sharp eyes";\
                  guidance-scale=0;\
                  inference-steps=8;\
                  strength=0.6
--prompts "photo of a woman standing in a sunlit kitchen, looking at the camera"
