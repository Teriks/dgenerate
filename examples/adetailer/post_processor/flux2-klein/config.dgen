#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Flux.2 Klein 4B is public and has an inpaint pipeline, so adetailer can run.
# Full Flux.2 does not. Distilled Klein ignores guidance above 1.
# Klein has no negative prompt.

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 12 %}
    \set optimization --quantizer bnb;bits=4
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 12 %}
    \set optimization --quantizer sdnq;type=int4
{% else %}
    \set optimization --model-sequential-offload
{% endif %}


black-forest-labs/FLUX.2-klein-4B
--model-type flux2 {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 4
--guidance-scales 4
--gen-seeds 1
--output-path flux2-klein-adetailer
--output-size 1024
--post-processors adetailer;\
                  model=Bingsu/adetailer;\
                  weight-name=face_yolov8n.pt;\
                  prompt="a detailed face, sharp eyes";\
                  guidance-scale=1;\
                  inference-steps=4;\
                  strength=0.4
--prompts "photo of a woman standing in a sunlit kitchen, looking at the camera"
