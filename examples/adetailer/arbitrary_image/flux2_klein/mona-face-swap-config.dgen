#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Arbitrary image. The detector builds the mask. Do not put a mask in --image-seeds.
# Flux.2 Klein 4B is public and has an inpaint pipeline. Full Flux.2 does not.
# Distilled Klein ignores guidance above 1 and has no negative prompt.

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 12 %}
    \set optimization --quantizer bnb;bits=4
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 12 %}
    \set optimization --quantizer sdnq;type=int4
{% else %}
    \set optimization --model-sequential-offload
{% endif %}


black-forest-labs/FLUX.2-klein-4B
--model-type flux2 {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 4
--guidance-scales 4
--image-seeds ../../../media/monalisa.png
--adetailer-detectors Bingsu/adetailer;weight-name=face_yolov8n.pt
--image-seed-strengths 0.45
--gen-seeds 1
--output-path flux2-klein-mona-face-swap
--output-size 800
--prompts "a smiling woman's face, detailed eyes"
