#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Arbitrary image on Qwen-Image Edit. The detector builds the mask.
# Edit-plus has no inpaint pipeline, so this is --model-type qwen-image-edit.
# --guidance-scales is true CFG.

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 24 %}
    \set optimization --quantizer bnb;bits=4
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 24 %}
    \set optimization --quantizer sdnq;type=int4
{% else %}
    \set optimization --model-sequential-offload
{% endif %}


Qwen/Qwen-Image-Edit
--model-type qwen-image-edit {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 50
--guidance-scales 4
--image-seeds ../../../media/monalisa.png
--adetailer-detectors Bingsu/adetailer;weight-name=face_yolov8n.pt
--image-seed-strengths 0.4
--gen-seeds 1
--output-path qwen-image-edit-mona-face-swap
--output-size 800
--prompts "a smiling woman's face, detailed eyes"
