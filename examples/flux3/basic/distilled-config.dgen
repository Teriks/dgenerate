#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# FLUX.3 Image Klein, distilled. 16 steps and no classifier-free guidance.
# The checkpoint is gated. The prompt is encoded as given.
# --pipeline-prompt-enhance loads the Qwen3.5 upsampler and rewrites it first.
# --prompt-upsampler names a different upsampler URI and turns that on.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or pass --auth-token.
    \exit
{% endif %}

black-forest-labs/flux-3-image-klein
--model-type flux3
--dtype bfloat16
--model-sequential-offload
--inference-steps 16
--guidance-scales 1
--gen-seeds 1
--output-path flux3-klein
--output-size 1024
--prompts "A red fox in a snow-covered forest clearing at golden hour"
