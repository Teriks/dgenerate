#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Reference edit. --image-seeds are references, up to 10, with no mask and
# no strength. One reference keeps its own size unless --output-size is set.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or pass --auth-token.
    \exit
{% endif %}

black-forest-labs/flux-3-image-klein
--model-type flux3
--dtype bfloat16
--model-sequential-offload
--inference-steps 16
--guidance-scales 1
--image-seeds "../../media/man-fighting-pose.jpg"
--gen-seeds 1
--output-path flux3-klein-edit
--output-size 1024
--prompts "the same person standing in a snow-covered forest clearing at golden hour"
