#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Reference edit with the checkpoint Qwen3.5 upsampler. --image-seeds are
# references, with no mask and no strength. The upsampler sees those images
# and uses its edit system prompt. Text-to-image with the same flag is
# examples/flux3/pipeline_prompt_enhance/distilled-config.dgen.
# The checkpoint is gated.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or pass --auth-token.
    \exit
{% endif %}

black-forest-labs/flux-3-image-klein
--model-type flux3
--dtype bfloat16
--model-sequential-offload
--pipeline-prompt-enhance
--inference-steps 16
--guidance-scales 1
--image-seeds "../../media/man-fighting-pose.jpg"
--gen-seeds 1
--output-path flux3-klein-edit-enhance
--output-size 1024
--prompts "the same person standing in a snow-covered forest clearing at golden hour"
