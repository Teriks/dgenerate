#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Spectrum on distilled Klein. The joint single blocks are the forecast cache.
# Sixteen steps hold the skip interval fixed.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or pass --auth-token.
    \exit
{% endif %}

black-forest-labs/flux-3-image-klein
--model-type flux3
--dtype bfloat16
--model-sequential-offload
--inference-steps 16
--guidance-scales 1
--spectrum
--gen-seeds 1
--output-path flux3-klein-spectrum
--output-size 1024
--prompts "A red fox in a snow-covered forest clearing at golden hour"
