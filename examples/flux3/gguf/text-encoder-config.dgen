#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Distilled GGUF transformer and the ComfyUI int8 ConvRot Qwen3-VL encoder.
# The encoder file is gated: black-forest-labs/flux-3-image-klein-comfy.
# Packed int8 layers stay packed. No quantizer on this line.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or pass --auth-token.
    \exit
{% endif %}

black-forest-labs/flux-3-image-klein
--model-type flux3
--dtype bfloat16
--model-sequential-offload
--transformer https://huggingface.co/molbal/Flux-3-Klein-GGUF/blob/main/flux3_image_klein_sd-Q4_K_M.gguf
--text-encoders "Qwen3VLForConditionalGeneration;model=https://huggingface.co/black-forest-labs/flux-3-image-klein-comfy/blob/main/text_encoders/qwen3vl_4b_int8_convrot.safetensors"
--inference-steps 16
--guidance-scales 1
--gen-seeds 1
--output-path flux3-klein-gguf-encoder
--output-size 1024
--prompts "A red fox in a snow-covered forest clearing at golden hour"
