#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Klein base Q4_K_M GGUF. 50 steps, guidance 3.5.
# https://huggingface.co/molbal/Flux-3-Klein-GGUF

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or pass --auth-token.
    \exit
{% endif %}

black-forest-labs/flux-3-image-klein-base
--model-type flux3
--dtype bfloat16
--model-sequential-offload
--transformer https://huggingface.co/molbal/Flux-3-Klein-GGUF/blob/main/flux3_image_klein_base-Q4_K_M.gguf
--inference-steps 50
--guidance-scales 3.5
--gen-seeds 1
--output-path flux3-klein-base-gguf
--output-size 1024
--prompts "A red fox in a snow-covered forest clearing at golden hour"
