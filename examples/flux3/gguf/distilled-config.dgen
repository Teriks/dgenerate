#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Distilled Klein with a public Q4_K_M GGUF transformer.
# https://huggingface.co/molbal/Flux-3-Klein-GGUF
# The pipeline repo is gated and still supplies Qwen3-VL, the upsampler, and the VAE.
# Comfy names (emb_in, content_mode_blocks) are renamed on load.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or pass --auth-token.
    \exit
{% endif %}

black-forest-labs/flux-3-image-klein
--model-type flux3
--dtype bfloat16
--model-sequential-offload
--transformer https://huggingface.co/molbal/Flux-3-Klein-GGUF/blob/main/flux3_image_klein_sd-Q4_K_M.gguf
--inference-steps 16
--guidance-scales 1
--gen-seeds 1
--output-path flux3-klein-gguf
--output-size 1024
--prompts "A red fox in a snow-covered forest clearing at golden hour"
