#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Motif-Video GGUF as the model. The text encoder and Wan VAE load from
# Motif-Technologies/Motif-Video-2B. config.dgen uses --transformer.

https://huggingface.co/Motif-Technologies/Motif-Video-2B-GGUF/blob/main/motifv-2b-dev-Q4_K_M.gguf
--model-type motif-video
--dtype bfloat16
--model-sequential-offload
--inference-steps 30
--guidance-scales 5
--video-lengths 4
--video-fps 24
--animation-format mp4
--gen-seeds 1
--output-path motif-video-gguf-as-model
--output-size 832x480
--prompts "A red kite glides above a windswept coastal meadow at golden hour; smooth cinematic camera movement"
