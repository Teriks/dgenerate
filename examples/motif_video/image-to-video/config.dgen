#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Animate the example portrait from the first frame.

Motif-Technologies/Motif-Video-2B
--model-type motif-video
--image-seeds ../../media/horse1.jpg
--dtype bfloat16
--model-sequential-offload
--inference-steps 50
--guidance-scales 5
--video-lengths 5
--video-fps 24
--animation-format mp4
--gen-seeds 1
--output-path motif-video-i2v
--output-size 832x480
--prompts "The kite lifts and drifts gently across the sky as the grass moves in the breeze; worst quality, blurry, jittery, distorted"
