#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Pruned Q4_K_M transformer and the ComfyUI int8 ConvRot Qwen3-VL encoder.
# https://huggingface.co/Comfy-Org/MiniMax-H3-Image

MiniMaxAI/MiniMax-H3-Image
--model-type minimax-h3-image
--dtype bfloat16
--model-sequential-offload
--transformer https://huggingface.co/unsloth/MiniMax-H3-Image-GGUF/blob/main/minimax_h3_image_pruned-Q4_K_M.gguf
--text-encoders "Qwen3VLForConditionalGeneration;model=https://huggingface.co/Comfy-Org/MiniMax-H3-Image/blob/main/text_encoders/qwen3vl_32b_minimax_h3_int8_convrot.safetensors"
--gen-seeds 1
--output-path minimax-h3-image-gguf-encoder
--output-size 2048
--prompts "A red fox standing in a snowy pine forest at sunrise, sharp detail"
