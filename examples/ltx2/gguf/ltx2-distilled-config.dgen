#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# LTX-2 19B distilled transformer as a Comfy GGUF. Gemma 3, the connectors,
# and both VAEs still come from Lightricks/LTX-2. The parent scheduler is the
# dev schedule (dynamic shifting). use-dynamic-shifting=false selects the
# distilled 8-value sigma table, so do not pass --inference-steps. Guidance
# stays at 1.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

Lightricks/LTX-2
--model-type ltx2
--dtype bfloat16
--model-sequential-offload
--transformer https://huggingface.co/Kijai/LTXV2_comfy/blob/main/diffusion_models/ltx-2-19b-distilled_Q4_K_M.gguf
--scheduler FlowMatchEulerDiscreteScheduler;use-dynamic-shifting=false
--guidance-scales 1
--gen-seeds 1
--output-size 640x384
--video-lengths 2
--animation-format mp4
--output-path ltx2-gguf-distilled
--prompts "A woman in a red coat walks along a dirt path through a green field, then stops and looks back at the camera. The camera stays fixed."
