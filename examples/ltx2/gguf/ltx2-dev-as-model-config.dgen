#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# LTX-2 19B dev GGUF as the model. Gemma 3, the connectors, and both VAEs
# load from Lightricks/LTX-2. The file is recognized as LTX-2, not LTX-2.5,
# because it has no keyframes_abs_pos_embedding and no prompt_adaln_single.
# ltx2-dev-config.dgen passes the same file to --transformer.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

https://huggingface.co/Kijai/LTXV2_comfy/blob/main/diffusion_models/ltx-2-19b-dev_Q4_K_M.gguf
--model-type ltx2
--dtype bfloat16
--model-sequential-offload
--inference-steps 30
--guidance-scales 4
--ltx-audio-guidance-scales 4
--gen-seeds 1
--output-size 640x384
--video-lengths 2
--animation-format mp4
--output-path ltx2-gguf-dev-as-model
--prompts "A woman in a red coat walks along a dirt path through a green field, then stops and looks back at the camera. The camera stays fixed."
