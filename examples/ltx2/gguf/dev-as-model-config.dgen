#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# LTX-2.5 dev GGUF as the model. Gemma, the video VAE, and the audio VAE load
# from Lightricks/LTX-2.5-Diffusers. dev-config.dgen passes the file to
# --transformer. The published scheduler is the distilled table; dynamic
# shifting makes --inference-steps apply.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

https://huggingface.co/vantagewithai/LTX-2.5-GGUF/blob/main/dev/ltx-2.5-22b-dev-transformer-Q4_K_S.gguf
--model-type ltx2
--dtype bfloat16
--model-sequential-offload
--scheduler FlowMatchEulerDiscreteScheduler;use-dynamic-shifting=true;shift-terminal=0.1
--inference-steps 30
--guidance-scales 3
--ltx-audio-guidance-scales 7
--ltx-stg-scales 1
--ltx-modality-scales 3
--ltx-stg-blocks 28
--guidance-rescales 0.7
--ltx-audio-guidance-rescales 0.7
--gen-seeds 1
--output-size 640x384
--video-lengths 2
--animation-format mp4
--output-path ltx-gguf-dev-as-model
--prompts "A woman in a red coat walks along a dirt path through a green field, then stops and looks back at the camera. The camera stays fixed."
