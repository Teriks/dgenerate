#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# --ltx-video-decoder diffusion uses the checkpoint diffusion decoder.
# conv, the default, is the convolutional VAE. The decode is part of this generation.
# Linux loads NATTEN through the kernels package. Leave DIFFUSERS_DISABLE_REMOTE_CODE unset.
# Windows has no NATTEN build. That window runs with Triton, or is gathered in PyTorch.
# --ltx-diffusion-decode-tile splits stages 4 and 5. 384x384x24 is the size used
# when NATTEN is missing. Omit the option when NATTEN is available to decode in one pass.

\set token %HF_TOKEN%
\setp gpu_memory_gib total_memory(unit='gib')

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

{% if not have_cuda() or gpu_memory_gib < 16 %}
    \print Skipping the LTX diffusion decoder example. It needs a CUDA GPU with at least 16 GiB.
    \exit
{% endif %}

Lightricks/LTX-2.5-Diffusers
--model-type ltx2
--dtype bfloat16
--model-sequential-offload
--ltx-video-decoder diffusion
--ltx-diffusion-decode-tile 384x384x24
--guidance-scales 1
--gen-seeds 1
--output-size 640x384
--video-lengths 2
--animation-format mp4
--output-path ltx-diffusion-decode
--prompts "A tabby cat walks across a sunlit oak floor. The camera stays fixed. Claws on wood."
