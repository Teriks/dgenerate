#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# LTX-2.5 dev diffusion-model safetensors from CivitAI. Gemma, the video VAE,
# and the audio VAE load from Lightricks/LTX-2.5-Diffusers. The published
# scheduler is the distilled table; dynamic shifting makes --inference-steps apply.
# https://civitai.com/models/2851515/ltx-25

\set token %HF_TOKEN%
\set civit_ai_token %CIVIT_AI_TOKEN%

{% if not civit_ai_token.strip() %}
    \print Set CIVIT_AI_TOKEN environmental variable to run this example!
    \exit
{% endif %}

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

https://civitai.com/api/download/models/3220143?fileId=3102620
--model-type ltx2
--dtype bfloat16
--model-sequential-offload
--scheduler FlowMatchEulerDiscreteScheduler;use-dynamic-shifting=true;shift-terminal=0.1
--inference-steps 30
--guidance-scales 3
--ltx-audio-guidance-scales 7
--ltx-stg-scales 1
--ltx-modality-scales 3
--ltx-stg-blocks 28
--guidance-rescales 0.7
--ltx-audio-guidance-rescales 0.7
--gen-seeds 1
--output-size 640x384
--video-lengths 2
--animation-format mp4
--output-path ltx-civitai-dev
--prompts "A woman in a red coat walks along a dirt path through a green field, then stops and looks back at the camera. The camera stays fixed."
