#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# The gif path is the opening clip. last-frame= is the closing clip.
# An end clip needs a fixed length, so --video-lengths is required here.
# The gifs play at 25 fps, so --video-fps 25 keeps the motion speed.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

Lightricks/LTX-2.5-Diffusers
--model-type ltx2
--dtype bfloat16
--model-sequential-offload
--guidance-scales 1
--video-fps 25
--gen-seeds 1
--output-size 512x512
--video-lengths 4
--animation-format mp4
--output-path ltx-first-last-clip
--image-seeds "../../media/rickroll-roll.gif;last-frame=../../media/kitten.gif"
--prompts "A singer in a dark blazer and striped shirt sways at a vintage microphone, then the shot cuts to a small kitten looking around. The camera does not move."
