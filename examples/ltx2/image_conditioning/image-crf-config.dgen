#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# --ltx-image-crfs recompresses the conditioning still before the VAE encode.
# Omit it and LTX-2.5 uses 18. 0 skips recompression.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

Lightricks/LTX-2.5-Diffusers
--model-type ltx
--dtype bfloat16
--model-sequential-offload
--ltx-image-crfs 18
--guidance-scales 1
--gen-seeds 1
--output-size 640x384
--video-lengths 2
--animation-format mp4
--output-path ltx-image-crf
--image-seeds https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/diffusers/astronaut.jpg
--prompts "The astronaut turns the helmet toward the camera and lifts one gloved hand. The suit and background stay the same."
