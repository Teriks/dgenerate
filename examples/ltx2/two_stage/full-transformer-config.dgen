#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Full transformer for stage 1, distilled LoRA for the refine.
# --ltx-stage-loras is loaded only for stage 2, then removed.
# --output-size must be divisible by 64.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

Lightricks/LTX-2.5-Diffusers
--model-type ltx
--dtype bfloat16
--model-sequential-offload
--transformer Lightricks/LTX-2.5-Diffusers;subfolder=transformer_full
--scheduler FlowMatchEulerDiscreteScheduler;use-dynamic-shifting=true;shift-terminal=0.1
--ltx-latent-upscale
--inference-steps 30
--guidance-scales 3
--ltx-audio-guidance-scales 7
--ltx-stg-scales 1
--ltx-modality-scales 3
--ltx-stg-blocks 28
--guidance-rescales 0.7
--ltx-audio-guidance-rescales 0.7
--ltx-stage-loras "Lightricks/LTX-2.5-Diffusers;weight-name=ltx-2.5-22b-distilled-lora-450-bf16.safetensors"
--gen-seeds 1
--output-size 768x512
--video-lengths 5
--video-fps 24
--animation-format mp4
--output-path ltx-two-stage-full
--prompts "A woman in a red coat walks along a dirt path through a green field, then stops and looks back at the camera. Boots on gravel. The camera stays fixed."
