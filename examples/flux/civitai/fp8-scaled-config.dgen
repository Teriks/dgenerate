#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Flux.1 dev scaled FP8 safetensors from CivitAI. The file is the transformer.
# CLIP-L, T5, and the VAE load from black-forest-labs/FLUX.1-dev.
# https://civitai.com/models/1558896/flux1-dev-fp8-scaled
# safetensors-config.dgen is a full bf16 checkpoint that names those modules.

\set token %HF_TOKEN%
\set civit_ai_token %CIVIT_AI_TOKEN%

{% if not civit_ai_token.strip() %}
    \print Set CIVIT_AI_TOKEN environmental variable to run this example!
    \exit
{% endif %}

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 15 %}
    \set te_quant --quantizer bnb;bits=4 --quantizer-map text_encoder
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 15 %}
    \set te_quant --quantizer sdnq;type=int4 --quantizer-map text_encoder
{% endif %}

https://civitai.com/api/download/models/1764064?fileId=1664924
--model-type flux {{ te_quant }}
--dtype bfloat16
--model-cpu-offload
--inference-steps 20
--guidance-scales 3.5
--gen-seeds 1
--output-path flux-civitai-fp8-scaled
--output-size 1024
--prompts "Photo of a horse standing near the open door of a red barn, high resolution"
