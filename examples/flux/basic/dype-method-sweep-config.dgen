#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Compare DyPE position encodings on Flux.1 Dev above its
# 1024-pixel reference. Each method produces one combinatoric render.
# Flux.1 Dev develops a fine repeating texture with yarn's constant
# magnitude scale, so this uses --dype-mscales decay, which fades the
# scale out over the final denoising steps.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or pass --auth-token to run this example.
    \exit
{% endif %}

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 15 %}
    \set optimization --quantizer bnb;bits=4
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 15 %}
    \set optimization --quantizer sdnq;type=int4
{% else %}
    \set optimization --model-sequential-offload
{% endif %}


black-forest-labs/FLUX.1-dev
--model-type flux {{ optimization }}
--dtype bfloat16
--inference-steps 30
--guidance-scales 3.5
--gen-seeds 1
--dype
--dype-methods yarn ntk base
--dype-mscales decay
--output-path flux1-dype-method-sweep
--output-size 1344
--prompts "Photo of a horse standing near the open door of a red barn, high resolution"
