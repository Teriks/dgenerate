#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Matches the Diffusers FluxInpaintPipeline docstring: CompVis
# latent-diffusion dog/bench image + face mask, yellow-cat prompt.
# White mask pixels are repainted (~13% of the frame). FLUX.1-schnell
# is gated; set HF_TOKEN or pass --auth-token.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 15 %}
    \set optimization --quantizer bnb;bits=4
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 15 %}
    \set optimization --quantizer sdnq;type=int4
{% else %}
    \set optimization --model-sequential-offload
{% endif %}


\set image https://raw.githubusercontent.com/CompVis/latent-diffusion/main/data/inpainting_examples/overture-creations-5sI6fQgYIuo.png
\set mask https://raw.githubusercontent.com/CompVis/latent-diffusion/main/data/inpainting_examples/overture-creations-5sI6fQgYIuo_mask.png

black-forest-labs/FLUX.1-schnell
--model-type flux {{ optimization }}
--dtype bfloat16
--inference-steps 4
--guidance-scales 0
--image-seeds "{{ image }};mask={{ mask }}"
--image-seed-strengths 0.6
--gen-seeds 1
--output-path flux-inpaint
--output-size 1024
--prompts "Face of a yellow cat, high resolution, sitting on a park bench"
