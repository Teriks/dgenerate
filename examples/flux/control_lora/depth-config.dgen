#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Flux.1 Dev with the Black Forest Labs depth Control LoRA.
# MiDaS builds the depth map the LoRA expects.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 24 %}
    \set optimization --quantizer bnb;bits=4
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 24 %}
    \set optimization --quantizer sdnq;type=int4
{% else %}
    \set optimization --model-sequential-offload
{% endif %}

black-forest-labs/FLUX.1-dev
--model-type flux {{ optimization }}
--dtype bfloat16
--inference-steps 28
--guidance-scales 30
--output-path depth
--output-size 1024
--vae-tiling
--vae-slicing
--prompts "A small wooden cabin beside a still lake, mist rolling over the water, soft morning light."
--control-loras "black-forest-labs/FLUX.1-Depth-dev-lora"
--image-seeds "../../media/monalisa.png"
--control-image-processors "midas;output-file=depth/depth.png"
