#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 15 %}
    \set optimization --quantizer bnb;bits=4
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 15 %}
    \set optimization --quantizer sdnq;type=int4
{% else %}
    \set optimization --model-sequential-offload
{% endif %}

# Spectrum on FLUX.1-Krea-dev at its tuned 28 steps. The skip window
# grows after every full pass, so a 28-step run skips a larger share of
# steps than the 50-step Flux Dev example. Four warmup passes keep the
# composition steps exact. Each flex value is one combinatoric render
# with the same seed:
#
#   flex 0     16 of 28 full passes, about 1.75x
#   flex 0.75  10 of 28 full passes, about 2.8x
#   flex 1.5    9 of 28 full passes, about 3.1x
#
# The first invocation is a baseline without Spectrum for comparison.

\set common --model-type flux {{ optimization }} --dtype bfloat16 --inference-steps 28 --guidance-scales 4.5 --seeds 41205538216 --output-size 1024 --prompts "Photo of a horse standing near the open door of a red barn, high resolution"

black-forest-labs/FLUX.1-Krea-dev {{ common }}
--output-path flux-krea-dev-baseline

black-forest-labs/FLUX.1-Krea-dev {{ common }}
--spectrum
--spectrum-warmup-steps 4
--spectrum-flex-windows 0 0.75 1.5
--output-path flux-krea-dev-spectrum
