#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 15 %}
    \set optimization --quantizer bnb;bits=4
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 15 %}
    \set optimization --quantizer sdnq;type=int4
{% else %}
    \set optimization --model-sequential-offload
{% endif %}

# Scale Flux's default sigma schedule by 0.95.

# sigmas is a numpy array of evenly spaced values from 1 down to 1/steps.
# Flux applies its resolution-dependent shift to the expression result.
# This expression parser uses asteval. Numpy is available as np.
# Python builtins such as max and min are available too.

black-forest-labs/FLUX.1-dev
--model-type flux {{ auth_token }} {{ optimization }}
--dtype bfloat16
--inference-steps 50
--guidance-scales 3.5
--gen-seeds 1
--sigmas "expr: sigmas * 0.95"
--output-path sigmas_expr
--output-size 1024x1024
--prompts "a horse standing inside a barn"