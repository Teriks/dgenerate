#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# ByteDance Hyper-SD 8-step LoRA on a city96 Flux Dev GGUF.
# The LoRA stays an adapter on the packed transformer. Fuse scale 0.125.
# DistillT5 replaces T5-XXL, so the text encoder is not quantized again.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

black-forest-labs/FLUX.1-dev
--model-type flux
--dtype bfloat16
--model-cpu-offload
--transformer https://huggingface.co/city96/FLUX.1-dev-gguf/blob/main/flux1-dev-Q4_K_S.gguf
--loras "ByteDance/Hyper-SD;weight-name=Hyper-FLUX.1-dev-8steps-lora.safetensors"
--lora-fuse-scale 0.125
--text-encoders + DistillT5EncoderModel;model=LifuWang/DistillT5
--vae AutoencoderTiny;model=madebyollin/taef1
--inference-steps 8
--guidance-scales 3.5
--gen-seeds 1
--output-path flux-gguf-hyper-sd
--output-size 1024
--prompts "Photo of a horse standing near the open door of a red barn, high resolution"
