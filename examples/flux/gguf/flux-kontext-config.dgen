#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Replace the Kontext DiT with a pre-quantized QuantStack GGUF file. The
# Hugging Face repo still supplies the VAE and text encoders. T5 is
# quantized separately with bitsandbytes, or sdnq if bitsandbytes is
# not available.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 15 %}
    \set te_quant --quantizer bnb;bits=4 --quantizer-map text_encoder
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 15 %}
    \set te_quant --quantizer sdnq;type=int4 --quantizer-map text_encoder
{% endif %}

black-forest-labs/FLUX.1-Kontext-dev
--model-type flux-kontext {{ te_quant }}
--dtype bfloat16
--model-cpu-offload
--transformer https://huggingface.co/QuantStack/FLUX.1-Kontext-dev-GGUF/blob/main/flux1-kontext-dev-Q4_K_S.gguf
--image-seeds "../../media/monalisa.png"
--inference-steps 30
--guidance-scales 3.5
--gen-seeds 1
--output-path flux-gguf-kontext
--output-size 1024
--prompts "The monalisa wearing a red top hat"
