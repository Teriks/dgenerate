#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# FLUX.1 schnell with Kijai's FP8 (e4m3fn) transformer file. It has no
# weight scales: every tensor, biases and norms included, is plain FP8
# storage. The repository still supplies the CLIP-L and T5-XXL text encoders
# and the VAE.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or pass --auth-token to run this example.
    \exit
{% endif %}

black-forest-labs/FLUX.1-schnell
--model-type flux
--dtype bfloat16
--model-sequential-offload
--transformer https://huggingface.co/Kijai/flux-fp8/blob/main/flux1-schnell-fp8-e4m3fn.safetensors
--max-sequence-length 256
--inference-steps 4
--guidance-scales 0
--gen-seeds 1
--output-path flux-comfy-quant-schnell
--output-size 1024
--prompts "Photo of a horse standing near the open door of a red barn, high resolution"
