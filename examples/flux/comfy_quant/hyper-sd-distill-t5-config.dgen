#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# ByteDance Hyper-SD 8-step LoRA on Black Forest Labs' FP8 Flux Dev
# transformer. The LoRA stays an adapter on the packed weights.
# Fuse scale 0.125. DistillT5 replaces T5-XXL.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or pass --auth-token to run this example.
    \exit
{% endif %}

black-forest-labs/FLUX.1-dev
--model-type flux
--dtype bfloat16
--model-sequential-offload
--transformer https://huggingface.co/black-forest-labs/FLUX.1-dev-FP8/blob/main/flux1-dev-fp8.safetensors
--loras "ByteDance/Hyper-SD;weight-name=Hyper-FLUX.1-dev-8steps-lora.safetensors"
--lora-fuse-scale 0.125
--text-encoders + DistillT5EncoderModel;model=LifuWang/DistillT5
--vae AutoencoderTiny;model=madebyollin/taef1
--inference-steps 8
--guidance-scales 3.5
--gen-seeds 1
--output-path flux-comfy-quant-hyper-sd-distill-t5
--output-size 1024
--prompts "Photo of a horse standing near the open door of a red barn, high resolution"
