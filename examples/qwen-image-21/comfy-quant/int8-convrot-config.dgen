#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Qwen-Image 2.1 with ComfyUI's INT8 ConvRot transformer. Fused projection
# weights are split on load and stay packed. Qwen-Image 2.1 defaults to 40
# steps and unguided generation.

Qwen/Qwen-Image-2.1
--model-type qwen-image-21
--dtype bfloat16
--model-sequential-offload
--transformer https://huggingface.co/Comfy-Org/Qwen-Image-2.1/blob/main/diffusion_models/qwen_image_2.1_int8_convrot.safetensors
--qwen21-output-resolution 1024
--gen-seeds 1
--output-path qwen-image-21-comfy-quant
--prompts "A small red fox reading a map beside a mossy forest stream, soft morning light"
