#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# An IC-LoRA and a normal LoRA together. The union control IC-LoRA follows
# the canny edges of the control clip, and the style LoRA from --loras
# renders it as a fantasy anime illustration.

# Both are fused into the transformer. scale= on each URI is its weight.

# The union control IC-LoRA reads the control clip at half the output size,
# so the output width and height must be divisible by 64.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

Lightricks/LTX-2.5-Diffusers
--model-type ltx
--dtype bfloat16
--model-sequential-offload
--ic-lora "Lightricks/LTX-2.3-22b-IC-LoRA-Union-Control;weight-name=ltx-2.3-22b-ic-lora-union-control-ref0.5.safetensors"
--loras "vrgamedevgirl84/LTX_2.3_Fantasy_Anime_Style_LoRa;scale=1.0;weight-name=Fantasy_Anime.safetensors"
--guidance-scales 1
--video-fps 25
--gen-seeds 1
--output-size 512x512
--video-lengths 4
--animation-format mp4
--output-path ltx-ic-lora-canny-anime
--image-seeds ../../../media/rickroll-roll.gif
--control-image-processors "canny;lower=50;upper=100"
--prompts "A cinematic fantasy anime cel-shaded illustration. A young bard with silver hair and a flowing blue coat sings and sways at an ornate brass microphone. A black wrought iron lattice window glows with moonlight behind him. Hand-drawn linework, painted shading, magical atmosphere. The camera does not move."
