#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# IC-LoRA control. With --ic-lora, a plain --image-seeds path is the control
# clip. --control-image-processors turns it into canny edges, and the union
# control IC-LoRA follows those edges. The control frames are guidance only,
# they do not appear in the output.

# To also give a first frame, use: --image-seeds "first.png;control=clip.gif"

# The IC-LoRA reads the control clip at half the output size (its
# reference_downscale_factor metadata is 2), so the output width and height
# must be divisible by 64.

# Normal --loras can be loaded at the same time, they are fused together
# with the IC-LoRA. See canny-anime-lora-config.dgen.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

Lightricks/LTX-2.5-Diffusers
--model-type ltx
--dtype bfloat16
--model-sequential-offload
--ic-lora "Lightricks/LTX-2.3-22b-IC-LoRA-Union-Control;weight-name=ltx-2.3-22b-ic-lora-union-control-ref0.5.safetensors"
--guidance-scales 1
--video-fps 25
--gen-seeds 1
--output-size 512x512
--video-lengths 4
--animation-format mp4
--output-path ltx-ic-lora-canny
--image-seeds ../../../media/rickroll-roll.gif
--control-image-processors "canny;lower=50;upper=100"
--prompts "A man in a shiny silver suit sings and sways at a vintage microphone. A black wrought iron lattice window glows with moonlight behind him. The camera does not move."
