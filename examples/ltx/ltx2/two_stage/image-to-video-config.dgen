#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Distilled LTX-2.5, two stages in one generation.
# --ltx-latent-upscale uses --output-size as the finished clip.
# Stage 1 runs at half of each side, then the latent upsampler and a 3-sigma refine.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

Lightricks/LTX-2.5-Diffusers
--model-type ltx
--dtype bfloat16
--model-sequential-offload
--ltx-latent-upscale
--guidance-scales 1
--ltx-audio-guidance-scales 1
--gen-seeds 1
--output-size 768x512
--ltx-video-lengths 5
--ltx-video-fps 24
--animation-format mp4
--output-path ltx-two-stage
--image-seeds https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/diffusers/astronaut.jpg
--prompts "The astronaut turns the helmet toward the camera and lifts one gloved hand in a slow wave. The camera pushes in. The suit, visor, and background stay the same."
