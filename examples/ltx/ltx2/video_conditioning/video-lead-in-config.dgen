#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# end= is an animated image, so the clip ends on it. The leading semicolon omits the first frame.
# An end clip needs a fixed length, so --video-lengths is required here.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

Lightricks/LTX-2.5-Diffusers
--model-type ltx
--dtype bfloat16
--model-sequential-offload
--guidance-scales 1
--video-fps 25
--gen-seeds 1
--output-size 512x512
--video-lengths 4
--animation-format mp4
--output-path ltx-video-lead-in
--image-seeds ";end=../../../media/rickroll-roll.gif"
--prompts "A singer in a dark blazer and striped shirt walks in from the left, takes the vintage microphone stand in one hand, and starts to sway and sing. Soft white light streams through the lattice window behind him. The camera does not move."
