#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# --ltx-prompt-enhancer rewrites the prompt before denoising.
# Omit --ltx-system-prompt and LTX-2.5 uses its built-in system prompt.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

Lightricks/LTX-2.5-Diffusers
--model-type ltx
--dtype bfloat16
--model-sequential-offload
--ltx-prompt-enhancer google/gemma-4-E2B-it
--guidance-scales 1
--gen-seeds 1
--output-size 640x384
--ltx-video-lengths 2
--animation-format mp4
--output-path ltx-enhanced
--prompts "A red fox walks through snow."
