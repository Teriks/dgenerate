#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# An animated image as the opening clip. The rest of the clip continues from it.
# The gif plays at 25 fps, so --video-fps 25 keeps the motion speed.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

Lightricks/LTX-2.5-Diffusers
--model-type ltx
--dtype bfloat16
--model-sequential-offload
--guidance-scales 1
--video-fps 25
--gen-seeds 1
--output-size 512x512
--video-lengths 4
--animation-format mp4
--output-path ltx-video-extension
--image-seeds ../../media/rickroll-roll.gif
--prompts "A singer in a dark blazer and striped shirt sways at a vintage microphone and sings, then points at the camera with a grin. Soft white light streams through the lattice window behind him. The camera does not move."
