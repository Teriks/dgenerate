#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# The image path is the first frame. end= is the last frame.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

Lightricks/LTX-2.5-Diffusers
--model-type ltx
--dtype bfloat16
--model-sequential-offload
--guidance-scales 1
--gen-seeds 1
--output-size 640x384
--video-lengths 2
--animation-format mp4
--output-path ltx-first-last
--image-seeds "https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/diffusers/astronaut.jpg;end=https://raw.githubusercontent.com/CompVis/stable-diffusion/main/assets/stable-samples/img2img/sketch-mountains-input.jpg"
--prompts "The astronaut lowers one hand as the color photograph fades into this pencil sketch of mountains. The camera does not move."
