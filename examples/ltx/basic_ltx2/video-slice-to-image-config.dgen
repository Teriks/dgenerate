#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# frame-start= and frame-end= keep frames 16 through 40 of the gif as the opening clip.
# end= is a still image, so the clip ends on it.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

Lightricks/LTX-2.5-Diffusers
--model-type ltx
--dtype bfloat16
--model-sequential-offload
--guidance-scales 1
--video-fps 25
--gen-seeds 1
--output-size 512x512
--video-lengths 4
--animation-format mp4
--output-path ltx-video-slice-to-image
--image-seeds "../../media/rickroll-roll.gif;frame-start=16;frame-end=40;end=https://raw.githubusercontent.com/CompVis/stable-diffusion/main/assets/stable-samples/img2img/sketch-mountains-input.jpg"
--prompts "A singer in a dark blazer sways at a vintage microphone as the scene fades into this pencil sketch of mountains. The camera does not move."
