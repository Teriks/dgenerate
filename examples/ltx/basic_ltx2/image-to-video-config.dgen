#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# One --image-seeds image is the first frame.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

Lightricks/LTX-2.5-Diffusers
--model-type ltx
--dtype bfloat16
--model-sequential-offload
--guidance-scales 1
--gen-seeds 1
--output-size 640x384
--video-lengths 2
--animation-format mp4
--output-path ltx-image
--image-seeds https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/diffusers/astronaut.jpg
--prompts "The astronaut turns the helmet toward the camera and lifts one gloved hand in a slow wave. The camera pushes in. The suit, visor, and background stay the same."
