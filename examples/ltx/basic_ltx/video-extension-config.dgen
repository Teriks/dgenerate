#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Earlier LTX-Video, an animated image as the opening clip.
# The first 49 frames of the gif are kept and the rest of the clip continues from them.
# The gif plays at 25 fps, so --video-fps 25 keeps the motion speed.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

Lightricks/LTX-Video
--model-type ltx
--dtype bfloat16
--model-sequential-offload
--inference-steps 50
--guidance-scales 3
--video-fps 25
--gen-seeds 1
--output-size 512x512
--video-lengths 4.84
--animation-format mp4
--output-path ltx-video-extension
--image-seeds ../../media/rickroll-roll.gif
--prompts "A singer in a dark blazer and striped shirt sways at a vintage microphone, then steps back and spreads both arms wide. Soft white light streams through the lattice window behind him. The camera does not move.; worst quality, inconsistent motion, blurry, jittery, distorted"
