#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# HunyuanImage 2.1 with encoder-side prompt enhancement. The rewrite uses
# Qwen2.5-VL. ByT5 then encodes the rewritten prompt, including glyph text.

hunyuanvideo-community/HunyuanImage-2.1-Diffusers
--model-type hyimage-21
--dtype bfloat16
--model-sequential-offload
--inference-steps 50
--guidance-scales 3.5
--pipeline-prompt-enhance
--gen-seeds 1
--output-path hyimage21-pipeline-prompt-enhance
--output-size 2048
--prompts "A glass greenhouse in a rainstorm, reflections on the panes, cinematic photography"
