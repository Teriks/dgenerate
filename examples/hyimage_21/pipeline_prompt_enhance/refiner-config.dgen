#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# HunyuanImage 2.1 refiner with encoder-side prompt enhancement.
# The input image is a latent. The rewrite stays a description of the finished image.

hunyuanvideo-community/HunyuanImage-2.1-Refiner-Diffusers
--model-type hyimage-21-refiner
--dtype bfloat16
--model-sequential-offload
--inference-steps 4
--guidance-scales 3.25
--pipeline-prompt-enhance
--gen-seeds 1
--output-path hyimage21-refiner-pipeline-prompt-enhance
--output-size 2048
--image-seeds "https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/diffusers/ip_adapter_diner.png"
--prompts "A glass greenhouse in a rainstorm, reflections on the panes, cinematic photography"
