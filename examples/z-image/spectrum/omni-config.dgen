#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Spectrum on Z-Image Omni. The image seed is a condition image.

\setp gpu_memory_gib total_memory(unit='gib')

{% if not have_cuda() or gpu_memory_gib <= 16 %}
    \set optimization --model-sequential-offload
{% endif %}


Z-a-o/Z-Image-Turbo
--model-type z-image-omni {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 8
--guidance-scales 0
--image-seeds https://raw.githubusercontent.com/CompVis/stable-diffusion/main/assets/stable-samples/img2img/sketch-mountains-input.jpg
--gen-seeds 1
--output-path z-image-omni-spectrum
--output-size 1024
--spectrum
--prompts "A creative poster for the project Z-IMAGE-TURBO. A vintage steam locomotive becomes a giant zipper pull, unzipping thick winter snow to reveal a vibrant spring landscape underneath, detailed illustration"
