#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Tongyi-MAI/Z-Image-Turbo is public. 8 steps, guidance 0.
# Output size snaps to a multiple of 16.

\setp gpu_memory_gib total_memory(unit='gib')

{% if not have_cuda() or gpu_memory_gib <= 16 %}
    \set optimization --model-sequential-offload
{% endif %}


Tongyi-MAI/Z-Image-Turbo
--model-type z-image {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 8
--guidance-scales 0
--gen-seeds 1
--output-path z-image-turbo
--output-size 1024
--prompts "A red fox sitting in tall grass at sunrise, photo, sharp fur"
