#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Inpaint. The pipeline strength default is 1. The mask blends the image.
# It is not concatenated into the transformer.

\setp gpu_memory_gib total_memory(unit='gib')

{% if not have_cuda() or gpu_memory_gib <= 16 %}
    \set optimization --model-sequential-offload
{% endif %}


Tongyi-MAI/Z-Image-Turbo
--model-type z-image {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 8
--guidance-scales 0
--image-seeds "../../media/horse1.jpg;../../media/horse1-mask.jpg"
--image-seed-strengths 1
--gen-seeds 1
--output-path z-image-inpaint
--prompts "A horse standing on the surface of mars, photo"
