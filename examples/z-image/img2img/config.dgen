#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Matches Diffusers ZImageImg2ImgPipeline docs: CompVis sketch-mountains,
# strength 0.6, 8 steps, guidance 0.

\setp gpu_memory_gib total_memory(unit='gib')

{% if not have_cuda() or gpu_memory_gib <= 16 %}
    \set optimization --model-sequential-offload
{% endif %}


Tongyi-MAI/Z-Image-Turbo
--model-type z-image {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 8
--guidance-scales 0
--image-seeds https://raw.githubusercontent.com/CompVis/stable-diffusion/main/assets/stable-samples/img2img/sketch-mountains-input.jpg
--image-seed-strengths 0.6
--gen-seeds 42
--output-path z-image-img2img
--output-size 1024
--prompts "A fantasy landscape with mountains and a river, detailed, vibrant colors"
