#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Img2img. The pipeline strength default is 0.6.

\setp gpu_memory_gib total_memory(unit='gib')

{% if not have_cuda() or gpu_memory_gib <= 16 %}
    \set optimization --model-sequential-offload
{% endif %}


Tongyi-MAI/Z-Image-Turbo
--model-type z-image {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 8
--guidance-scales 0
--image-seeds "../../media/beach.jpg"
--image-seed-strengths 0.6
--gen-seeds 1
--output-path z-image-img2img
--output-size 1024
--prompts "A huge wave about to break over a tropical beach, photo"
