#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Matches Diffusers ZImageControlNetInpaintPipeline docs.
# Inpaint ControlNet needs Union 2.x (1.0 is rejected). Prefer 2.1 as in
# the Diffusers example. Official assets already use a modest white mask
# region; white is repainted. Use 25 steps: 2.x ControlNet loses Turbo's
# 8-step acceleration. This pipeline does not take image seed strength.

\setp gpu_memory_gib total_memory(unit='gib')

{% if not have_cuda() or gpu_memory_gib <= 16 %}
    \set optimization --model-sequential-offload
{% endif %}


\set image https://huggingface.co/alibaba-pai/Z-Image-Turbo-Fun-Controlnet-Union-2.0/resolve/main/asset/inpaint.jpg
\set mask https://huggingface.co/alibaba-pai/Z-Image-Turbo-Fun-Controlnet-Union-2.0/resolve/main/asset/mask.jpg
\set control https://huggingface.co/alibaba-pai/Z-Image-Turbo-Fun-Controlnet-Union-2.0/resolve/main/asset/pose.jpg

Tongyi-MAI/Z-Image-Turbo
--model-type z-image {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 25
--guidance-scales 0
--control-nets "https://huggingface.co/alibaba-pai/Z-Image-Turbo-Fun-Controlnet-Union-2.0/resolve/main/Z-Image-Turbo-Fun-Controlnet-Union-2.1.safetensors;scale=0.75"
--image-seeds "{{ image }};mask={{ mask }};control={{ control }}"
--gen-seeds 43
--output-path z-image-controlnet-inpaint
--output-size 992x1728
--prompts "A young woman on a sunny coastline, full-body vertical composition, body angled slightly right, left hand relaxed at her side, right arm bent with hand on her waist, fingers clearly visible. She wears a light white sleeveless dress, semi-sheer soft fabric fluttering in the sea breeze. Long vivid purple hair to her waist, blown by the wind, with a delicate black bow. Fair skin, gentle shy expression, eyes toward the distant horizon. Vast ocean and clear blue sky, warm golden sunlight on glittering water."
