#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Inpaint ControlNet needs the 2.0 union. The 1.0 file is rejected.
# This pipeline does not take image seed strength.
#
# horse1-mask.jpg is black on the horse and white on the background.
# White is repainted, so invert it and paint the horse, as in
# examples/inpaint_autocrop/hi-res-auto-cropped-config.dgen.
# Canny of that same photo guides the painted horse.

\setp gpu_memory_gib total_memory(unit='gib')

{% if not have_cuda() or gpu_memory_gib <= 16 %}
    \set optimization --model-sequential-offload
{% endif %}


Tongyi-MAI/Z-Image-Turbo
--model-type z-image {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 8
--guidance-scales 0
--control-nets "https://huggingface.co/alibaba-pai/Z-Image-Turbo-Fun-Controlnet-Union-2.0/resolve/main/Z-Image-Turbo-Fun-Controlnet-Union-2.0.safetensors;scale=0.75"
--image-seeds "../../media/horse1.jpg;mask=../../media/horse1-mask.jpg;control=../../media/horse1.jpg"
--mask-image-processors invert
--control-image-processors "canny;lower=50;upper=100;output-file=z-image-controlnet-inpaint/horse-canny.png"
--gen-seeds 1
--output-path z-image-controlnet-inpaint
--prompts "a pink horse from a fantasy world, standing and looking towards the viewer"
