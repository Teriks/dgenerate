#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Z-Image Base plus the 2-step distill LoRA. This is a normal --loras load.
# --quantizer sdnq on this full-precision repo quantizes while loading.
# Do not combine that with the prequantized Turbo checkpoint.

\set optimization --model-sequential-offload


Tongyi-MAI/Z-Image
--model-type z-image {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--loras "alibaba-pai/Z-Image-Fun-Lora-Distill;weight-name=Z-Image-Fun-Lora-Distill-2-Steps-2603.safetensors;scale=1.0"
--inference-steps 2
--guidance-scales 1
--gen-seeds 42
--output-path z-image-base-2step
--output-size 1024
--prompts "A ceramic fox figurine on a wooden desk, soft window light, photo"
