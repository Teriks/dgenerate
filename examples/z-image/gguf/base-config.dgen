#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Z-Image base with a GGUF transformer. The base and Turbo transformers
# share one config, so the loader uses Tongyi-MAI/Z-Image-Turbo for the
# module shape. This repository still supplies the text encoder and VAE.
# Guidance around 4, and 28 to 50 steps. Turbo's 8 steps and guidance 0
# are for the distilled checkpoint only.

\setp gpu_memory_gib total_memory(unit='gib')
\set te_quant
\set offload

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 12 %}
    \set te_quant --quantizer bnb;bits=4 --quantizer-map text_encoder
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 12 %}
    \set te_quant --quantizer sdnq;type=int4 --quantizer-map text_encoder
{% endif %}

{% if not have_cuda() or gpu_memory_gib <= 16 %}
    \set offload --model-sequential-offload
{% endif %}

Tongyi-MAI/Z-Image
--model-type z-image {{ te_quant }} {{ offload }}
--dtype bfloat16
--transformer https://huggingface.co/jayn7/Z-Image-GGUF/blob/main/z_image-Q4_K_S.gguf
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 28
--guidance-scales 4
--gen-seeds 1
--output-path z-image-gguf-base
--output-size 1024
--prompts "A red fox sitting in tall grass at sunrise, photo, sharp fur"
