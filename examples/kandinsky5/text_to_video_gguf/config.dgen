#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Kandinsky 5 T2V Pro sft GGUF (Q4_K_S, ~14 GB):
# https://huggingface.co/Ada321/Kandinsky-5.0-T2V-Pro-sft-5s-Q4_K_S.gguf

kandinskylab/Kandinsky-5.0-T2V-Pro-sft-5s-Diffusers
--model-type kandinsky5-video
--transformer "https://huggingface.co/Ada321/Kandinsky-5.0-T2V-Pro-sft-5s-Q4_K_S.gguf/blob/main/kandinsky5Pro_t2v_sft_5s-Q4_K_S.gguf"
--dtype bfloat16
--model-sequential-offload
--inference-steps 50
--guidance-scales 5
--video-lengths 5
--video-fps 24
--animation-format mp4
--gen-seeds 1
--output-path kandinsky5-video-t2v-gguf
--output-size 1024x768
--prompts "A red kite glides above a windswept coastal meadow at golden hour; smooth cinematic camera movement; Static, 2D cartoon, cartoon, 2d animation, paintings, images, worst quality, low quality, ugly, deformed, walking backwards"
