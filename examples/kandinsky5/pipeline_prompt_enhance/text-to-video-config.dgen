#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Kandinsky 5 text-to-video. The rewrite describes the shot, including camera motion.

kandinskylab/Kandinsky-5.0-T2V-Lite-sft-5s-Diffusers
--model-type kandinsky5-video
--dtype bfloat16
--model-sequential-offload
--inference-steps 50
--guidance-scales 5
--video-lengths 5
--video-fps 24
--animation-format mp4
--pipeline-prompt-enhance
--gen-seeds 1
--output-path kandinsky5-t2v-pipeline-prompt-enhance
--output-size 768x512
--prompts "A red kite glides above a windswept coastal meadow at golden hour; smooth cinematic camera movement"
