#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Kandinsky 5 T2V Pro distilled GGUF, Diffusers tensor names (no -comfy).
# https://huggingface.co/Teriks/Kandinsky-5.0-T2V-Pro-distilled-5s-quants
# The older Pro sft file is kandinsky5Pro_t2v_sft_5s-Q4_K_S.gguf on a different repo.

kandinskylab/Kandinsky-5.0-T2V-Pro-distilled-5s-Diffusers
--model-type kandinsky5-video
--dtype bfloat16
--model-sequential-offload
--transformer https://huggingface.co/Teriks/Kandinsky-5.0-T2V-Pro-distilled-5s-quants/blob/main/transformer-Q4_K.gguf
--inference-steps 16
--guidance-scales 5
--video-lengths 5
--video-fps 24
--animation-format mp4
--gen-seeds 1
--output-path kandinsky5-t2v-pro-distilled-gguf
--output-size 1024x768
--prompts "A red kite glides above a windswept coastal meadow at golden hour, smooth cinematic camera movement; Static, 2D cartoon, cartoon, 2d animation, paintings, images, worst quality, low quality, ugly, deformed, walking backwards"
