#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Flux.2 dev with ComfyUI's FP8 mixed transformer: the blocks are scaled FP8,
# the rest bfloat16. The repository still supplies the VAE and the Mistral
# text encoder, quantized here like the GGUF example.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or pass --auth-token.
    \exit
{% endif %}

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 16 %}
    \set te_quant --quantizer bnb;bits=4 --quantizer-map text_encoder
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 16 %}
    \set te_quant --quantizer sdnq;type=int4 --quantizer-map text_encoder
{% endif %}

black-forest-labs/FLUX.2-dev
--model-type flux2 {{ te_quant }}
--dtype bfloat16
--model-sequential-offload
--transformer https://huggingface.co/Comfy-Org/flux2-dev/blob/main/split_files/diffusion_models/flux2_dev_fp8mixed.safetensors
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 20
--guidance-scales 4
--gen-seeds 1
--output-path flux2-comfy-quant-dev-fp8
--output-size 1024
--prompts "A cat holding a sign that says hello world"
