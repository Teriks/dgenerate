#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Flux.2 dev with a reference image (--image-seeds, no mask).
# Mistral can see the picture during --pipeline-prompt-enhance, so the
# built-in edit system prompt is used. Read each "Pipeline prompt enhance:"
# line before denoising.
#
# Run from this directory (or pass the full path to --file):
#   python examples/run.py --paths flux2/pipeline_prompt_enhance/image-conditioned-config.dgen

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or pass --auth-token.
    \exit
{% endif %}

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 24 %}
    \set optimization --quantizer bnb;bits=4
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 24 %}
    \set optimization --quantizer sdnq;type=int4
{% else %}
    \set optimization --model-sequential-offload
{% endif %}

black-forest-labs/FLUX.2-dev
--model-type flux2 {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 1
--guidance-scales 4
--image-seeds "../../media/man-fighting-pose.jpg"
--pipeline-prompt-enhance
--gen-seeds 1
--output-path output-enhance/flux2-image
--output-size 256
--prompts "Add a small paper sign beside the person that reads 「OPEN」. Leave the person unchanged."