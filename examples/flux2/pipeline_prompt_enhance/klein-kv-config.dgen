#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# FLUX.2 Klein KV with a reference image (--image-seeds, no mask).
# The Qwen3 text encoder does not see that image; --pipeline-prompt-enhance
# uses the text-to-image system prompt. If the picture cannot be attached,
# enhancement falls back the same way.
#
# Run from repo root via examples/run.py:
#   python examples/run.py --paths flux2/pipeline_prompt_enhance/klein-kv-config.dgen

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or pass --auth-token.
    \exit
{% endif %}

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 24 %}
    \set optimization --quantizer bnb;bits=4
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 24 %}
    \set optimization --quantizer sdnq;type=int4
{% else %}
    \set optimization --model-sequential-offload
{% endif %}

black-forest-labs/FLUX.2-klein-9b-kv
--model-type flux2-klein-kv {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 4
--image-seeds "../../media/beach.jpg"
--pipeline-prompt-enhance
--gen-seeds 1
--output-path output
--output-size 1024
--prompts "The same beach at night, moonlight on the water"
