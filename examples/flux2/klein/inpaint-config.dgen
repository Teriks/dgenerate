#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Klein inpaint. Full Flux.2 has no inpaint class.
# horse1-mask.jpg is black on the horse and white on the background.
# White is repainted, so this changes the field and keeps the horse.
# The init image also stays packed as a condition every step, so use
# strength 1 and guidance nearer the Diffusers inpaint default (8).
# image_reference / reference= is left unset.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or pass --auth-token.
    \exit
{% endif %}

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 24 %}
    \set optimization --quantizer bnb;bits=4
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 24 %}
    \set optimization --quantizer sdnq;type=int4
{% else %}
    \set optimization --model-sequential-offload
{% endif %}


black-forest-labs/FLUX.2-klein-base-9B
--model-type flux2 {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 50
--guidance-scales 8
--image-seeds "../../media/horse1.jpg;../../media/horse1-mask.jpg"
--image-seed-strengths 1
--gen-seeds 1
--output-path flux2-klein-inpaint
--prompts "A horse standing on the surface of mars, photo"
