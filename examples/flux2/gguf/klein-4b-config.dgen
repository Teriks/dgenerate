#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Flux.2 Klein 4B with an Unsloth GGUF transformer. Hidden width 3072 selects
# the Klein 4B config. A 9B file (width 4096) is the same --model-type with
# black-forest-labs/FLUX.2-klein-base-9B and
# unsloth/FLUX.2-klein-base-9B-GGUF flux-2-klein-base-9b-Q4_K_S.gguf.

# Distilled Klein ignores guidance above 1. Four steps is the short schedule.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or pass --auth-token.
    \exit
{% endif %}

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 12 %}
    \set te_quant --quantizer bnb;bits=4 --quantizer-map text_encoder
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 12 %}
    \set te_quant --quantizer sdnq;type=int4 --quantizer-map text_encoder
{% endif %}

black-forest-labs/FLUX.2-klein-4B
--model-type flux2 {{ te_quant }}
--dtype bfloat16
--model-sequential-offload
--transformer https://huggingface.co/unsloth/FLUX.2-klein-4B-GGUF/blob/main/flux-2-klein-4b-Q4_K_S.gguf
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 4
--guidance-scales 4
--gen-seeds 1
--output-path flux2-gguf-klein-4b
--output-size 1024
--prompts "A cat holding a sign that says hello world"
