#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Experimental DyPE Z-Image adapter above its 1024-pixel
# default DyPE reference.

\setp gpu_memory_gib total_memory(unit='gib')

{% if not have_cuda() or gpu_memory_gib <= 16 %}
    \set optimization --model-sequential-offload
{% endif %}


Tongyi-MAI/Z-Image-Turbo
--model-type z-image {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 9
--guidance-scales 0
--gen-seeds 1
--dype
--dype-methods yarn
--output-path z-image-turbo-dype
--output-size 1344
--prompts "Young Chinese woman in red Hanfu, intricate embroidery, elaborate golden hair ornaments, standing beneath a pagoda at night, cinematic portrait"
