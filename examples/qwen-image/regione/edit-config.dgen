#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# RegionE on Qwen-Image-Edit. Requires exactly 28 inference steps and an input image.
# Upstream presets for this pipeline use threshold 0.80 and cache_threshold 0.03.

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 24 %}
    \set optimization --quantizer bnb;bits=4 --quantizer-map text_encoder
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 24 %}
    \set optimization --quantizer sdnq;type=int4 --quantizer-map text_encoder
{% else %}
    \set optimization --model-sequential-offload
{% endif %}


Qwen/Qwen-Image-Edit
--model-type qwen-image-edit {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 28
--guidance-scales 4
--image-seeds https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/diffusers/yarn-art-pikachu.png
--gen-seeds 1
--output-path qwen-image-edit-regione
--output-size 1024
--regione-thresholds 0.80
--regione-cache-thresholds 0.03
--prompts "Make Pikachu hold a sign that says 'Qwen Edit is awesome', yarn art style, detailed, vibrant colors"
