#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Matches the Diffusers QwenImageInpaintPipeline docstring:
# CompVis latent-diffusion dog/bench image + face mask, yellow-cat prompt.
# White mask pixels are repainted. Strength 0.85 as in that example.

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 24 %}
    \set optimization --quantizer bnb;bits=4
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 24 %}
    \set optimization --quantizer sdnq;type=int4
{% else %}
    \set optimization --model-sequential-offload
{% endif %}


\set image https://raw.githubusercontent.com/CompVis/latent-diffusion/main/data/inpainting_examples/overture-creations-5sI6fQgYIuo.png
\set mask https://raw.githubusercontent.com/CompVis/latent-diffusion/main/data/inpainting_examples/overture-creations-5sI6fQgYIuo_mask.png

Qwen/Qwen-Image
--model-type qwen-image {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 50
--guidance-scales 4
--image-seeds "{{ image }};mask={{ mask }}"
--image-seed-strengths 0.85
--gen-seeds 1
--output-path qwen-image-inpaint
--output-size 1024
--prompts "Face of a yellow cat, high resolution, sitting on a park bench"
