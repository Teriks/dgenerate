#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# One inpainting ControlNet. The image and mask are control_image and
# control_mask. Do not add a separate control= file.
#
# Use InstantX/Qwen-Image-ControlNet-Inpainting here (extra_condition_channels=4).
# InstantX/Qwen-Image-ControlNet-Union is for structural control only and will
# fail with a channel mismatch if used with a mask.
#
# horse1-mask.jpg is black on the horse and white on the background.
# White is repainted. Leaving that mask as-is paints ~96% of the frame
# (the field). Invert it so the horse is painted instead, same pattern as
# InstantX's demo masks (~small white region) and
# examples/z-image/controlnet/inpaint-config.dgen.
# For field replacement with this mask, use examples/qwen-image/inpaint
# (strength-based) instead.

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 24 %}
    \set optimization --quantizer bnb;bits=4
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 24 %}
    \set optimization --quantizer sdnq;type=int4
{% else %}
    \set optimization --model-sequential-offload
{% endif %}


Qwen/Qwen-Image
--model-type qwen-image {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 30
--guidance-scales 4
--control-nets "InstantX/Qwen-Image-ControlNet-Inpainting;scale=1"
--image-seeds "../../media/horse1.jpg;mask=../../media/horse1-mask.jpg"
--mask-image-processors invert
--gen-seeds 1
--output-path qwen-image-controlnet-inpaint
--output-size 1024
--prompts "A pink fantasy horse standing in a green grassy field under a blue sky, photo"
