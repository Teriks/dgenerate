#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Matches InstantX / Diffusers QwenImageControlNetInpaintPipeline docs.
# Use InstantX/Qwen-Image-ControlNet-Inpainting (extra_condition_channels=4).
# InstantX/Qwen-Image-ControlNet-Union is structural-only and will fail with
# a channel mismatch if used with a mask.
#
# Official assets already use a small white region (~10% of the frame).
# White is repainted. InstantX recommends a descriptive whole-image prompt.

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 24 %}
    \set optimization --quantizer bnb;bits=4
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 24 %}
    \set optimization --quantizer sdnq;type=int4
{% else %}
    \set optimization --model-sequential-offload
{% endif %}


\set image https://huggingface.co/InstantX/Qwen-Image-ControlNet-Inpainting/resolve/main/assets/images/image1.png
\set mask https://huggingface.co/InstantX/Qwen-Image-ControlNet-Inpainting/resolve/main/assets/masks/mask1.png

Qwen/Qwen-Image
--model-type qwen-image {{ optimization }}
--dtype bfloat16
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 30
--guidance-scales 4
--control-nets "InstantX/Qwen-Image-ControlNet-Inpainting;scale=1"
--image-seeds "{{ image }};mask={{ mask }}"
--gen-seeds 42
--output-path qwen-image-controlnet-inpaint
--output-size 1328
--prompts "A green taxi driving on the road in the city, photo"
