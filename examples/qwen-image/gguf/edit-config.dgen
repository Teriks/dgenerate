#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Qwen-Image Edit with a QuantStack GGUF transformer. Edit uses the same
# module as Qwen-Image, so the loader keeps that config. The parent repo
# still supplies the text encoder and VAE. The image seed is the picture
# to change. There is no strength.

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 16 %}
    \set te_quant --quantizer bnb;bits=4 --quantizer-map text_encoder
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 16 %}
    \set te_quant --quantizer sdnq;type=int4 --quantizer-map text_encoder
{% endif %}

Qwen/Qwen-Image-Edit
--model-type qwen-image-edit {{ te_quant }}
--dtype bfloat16
--model-sequential-offload
--transformer https://huggingface.co/QuantStack/Qwen-Image-Edit-GGUF/blob/main/Qwen_Image_Edit-Q4_K_S.gguf
--scheduler FlowMatchEulerDiscreteScheduler
--inference-steps 50
--guidance-scales 4
--image-seeds https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/diffusers/yarn-art-pikachu.png
--gen-seeds 1
--output-path qwen-image-edit-gguf
--output-size 1024
--prompts "Make Pikachu hold a sign that says 'Qwen Edit is awesome', yarn art style, detailed, vibrant colors"
