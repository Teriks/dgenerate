#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# SD3.5 Large with the transformer from ComfyUI's scaled FP8 checkpoint.
# DistillT5 replaces T5-XXL. The fused attention qkv weights are split on
# load and stay packed. variant=null opts DistillT5 out of --variant fp16.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

stabilityai/stable-diffusion-3.5-large
--model-type sd3
--variant fp16
--dtype float16
--model-cpu-offload
--transformer https://huggingface.co/Comfy-Org/stable-diffusion-3.5-fp8/blob/main/sd3.5_large_fp8_scaled.safetensors
--text-encoders + + DistillT5EncoderModel;model=LifuWang/DistillT5;variant=null
--inference-steps 28
--guidance-scales 5
--gen-seeds 1
--output-path sd3-comfy-quant-35-large-distill-t5
--output-size 1024
--prompts "Photo of a horse standing near the open door of a red barn, high resolution"
