#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# ByteDance Hyper-SD 4-step CFG LoRA for Stable Diffusion 3 Medium.
# Fuse scale 0.125, guidance 3. DistillT5 replaces T5-XXL.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

{% if have_cuda() and have_feature('bitsandbytes') and total_memory(unit='gib') > 24 %}
    \set optimization --quantizer bnb;bits=8
{% else %}
    \set optimization --model-sequential-offload
{% endif %}

stabilityai/stable-diffusion-3-medium-diffusers
--model-type sd3 {{ optimization }}
--variant fp16
--dtype float16
--loras "ByteDance/Hyper-SD;weight-name=Hyper-SD3-4steps-CFG-lora.safetensors"
--lora-fuse-scale 0.125
--text-encoders + + DistillT5EncoderModel;model=LifuWang/DistillT5
--vae AutoencoderTiny;model=madebyollin/taesd3
--inference-steps 4
--guidance-scales 3
--gen-seeds 2
--output-path sd3-hyper-sd-distill-t5
--prompts "Photo of a horse standing near the open door of a red barn, high resolution; artwork"
