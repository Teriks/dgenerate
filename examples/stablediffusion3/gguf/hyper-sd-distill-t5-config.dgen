#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# ByteDance Hyper-SD 4-step CFG LoRA on a city96 SD3 Medium GGUF.
# The LoRA stays an adapter on the packed transformer. Fuse scale 0.125,
# guidance 3. DistillT5 replaces T5-XXL.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

stabilityai/stable-diffusion-3-medium-diffusers
--model-type sd3
--variant fp16
--dtype float16
--model-cpu-offload
--transformer https://huggingface.co/city96/stable-diffusion-3-medium-gguf/blob/main/sd3_medium-Q4_K_S.gguf
--loras "ByteDance/Hyper-SD;weight-name=Hyper-SD3-4steps-CFG-lora.safetensors"
--lora-fuse-scale 0.125
--text-encoders + + DistillT5EncoderModel;model=LifuWang/DistillT5;variant=null
--vae AutoencoderTiny;model=madebyollin/taesd3
--inference-steps 4
--guidance-scales 3
--gen-seeds 1
--output-path sd3-gguf-hyper-sd-distill-t5
--output-size 1024
--prompts "Photo of a horse standing near the open door of a red barn, high resolution"
