#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# SD3 Medium GGUF transformer, with city96's T5-XXL GGUF as the third
# text encoder. "+ +" keeps both CLIP encoders from the repository.
# The T5 file is already quantized. Do not set quantizer on that URI.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

stabilityai/stable-diffusion-3-medium-diffusers
--model-type sd3
--variant fp16
--dtype float16
--model-cpu-offload
--transformer https://huggingface.co/city96/stable-diffusion-3-medium-gguf/blob/main/sd3_medium-Q4_K_S.gguf
--text-encoders + + "T5EncoderModel;model=https://huggingface.co/city96/t5-v1_1-xxl-encoder-gguf/blob/main/t5-v1_1-xxl-encoder-Q4_K_S.gguf"
--inference-steps 28
--guidance-scales 5
--gen-seeds 1
--output-path sd3-gguf-text-encoder
--output-size 1024
--prompts "Photo of a horse standing near the open door of a red barn, high resolution"
