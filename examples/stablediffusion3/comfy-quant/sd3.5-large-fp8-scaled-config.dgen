#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# SD3.5 Large with the transformer from ComfyUI's scaled FP8 checkpoint. That
# file also bundles the text encoders, which --transformer ignores; the
# repository supplies them here, with T5 quantized like the GGUF example. The
# fused attention qkv weights are split on load and stay packed.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

\setp gpu_memory_gib total_memory(unit='gib')

{% if have_cuda() and have_feature('bitsandbytes') and gpu_memory_gib > 15 %}
    \set te_quant --quantizer bnb;bits=4 --quantizer-map text_encoder_3
{% elif have_cuda() and have_feature('sdnq') and gpu_memory_gib > 15 %}
    \set te_quant --quantizer sdnq;type=int4 --quantizer-map text_encoder_3
{% endif %}

stabilityai/stable-diffusion-3.5-large
--model-type sd3 {{ te_quant }}
--variant fp16
--dtype float16
--model-cpu-offload
--transformer https://huggingface.co/Comfy-Org/stable-diffusion-3.5-fp8/blob/main/sd3.5_large_fp8_scaled.safetensors
--inference-steps 28
--guidance-scales 5
--gen-seeds 1
--output-path sd3-comfy-quant-35-large
--output-size 1024
--prompts "Photo of a horse standing near the open door of a red barn, high resolution"
