#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Krea 2 Turbo INT8 Comfy checkpoint from CivitAI. "turbo" in the file name
# selects krea/Krea-2-Turbo for the text encoder and VAE.
# https://civitai.com/models/2726029/krea-2-turbo-official-comfy-org-checkpoints-krea2

\set civit_ai_token %CIVIT_AI_TOKEN%

{% if not civit_ai_token.strip() %}
    \print Set CIVIT_AI_TOKEN environmental variable to run this example!
    \exit
{% endif %}

https://civitai.com/api/download/models/3091481?fileId=2971089
--model-type krea2
--dtype bfloat16
--model-sequential-offload
--inference-steps 8
--guidance-scales 0
--gen-seeds 1
--output-path krea2-civitai-turbo
--output-size 1024
--prompts "A glass greenhouse in a rainstorm, reflections on the panes, cinematic photography"
