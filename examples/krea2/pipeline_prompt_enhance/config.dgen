#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Krea uses Qwen3VLModel without a language-model head, so the rewrite is
# text-only. An input image does not switch to the edit system prompt.

krea/Krea-2-Raw
--model-type krea2
--dtype bfloat16
--model-sequential-offload
--pipeline-prompt-enhance
--gen-seeds 1
--output-path output
--prompts "A small red fox reading a map beside a mossy forest stream"
