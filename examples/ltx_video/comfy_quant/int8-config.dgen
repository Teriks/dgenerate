#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# LTX-Video (2B) transformer, int8 tensorwise, ComfyUI tensor names.
# https://huggingface.co/Teriks/LTX-Video-quants
# The city96 GGUF is a different file. This parent is Lightricks/LTX-Video, not LTX-2.5.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or pass --auth-token.
    \exit
{% endif %}

Lightricks/LTX-Video
--model-type ltx-video
--dtype bfloat16
--model-cpu-offload
--transformer https://huggingface.co/Teriks/LTX-Video-quants/blob/main/transformer-int8_tensorwise-comfy.safetensors
--inference-steps 50
--guidance-scales 3
--video-fps 25
--gen-seeds 1
--output-size 768x512
--video-lengths 4.84
--animation-format mp4
--output-path ltx-video-int8
--prompts "A red kite glides above a windswept coastal meadow at golden hour, smooth cinematic camera movement"
