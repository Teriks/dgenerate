#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Same GGUF transformer, with one image as the first frame.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or --auth-token to run this example!
    \exit
{% endif %}

Lightricks/LTX-Video
--model-type ltx
--dtype bfloat16
--model-cpu-offload
--transformer https://huggingface.co/city96/LTX-Video-gguf/blob/main/ltx-video-2b-v0.9-Q3_K_S.gguf
--inference-steps 50
--guidance-scales 3
--video-fps 25
--gen-seeds 1
--output-size 768x512
--video-lengths 4.84
--animation-format mp4
--output-path ltx-video-gguf-image
--image-seeds https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/diffusers/astronaut.jpg
--prompts "The astronaut turns the helmet toward the camera and lifts one gloved hand in a slow wave. The camera pushes in. The suit, visor, and background stay the same.; worst quality, inconsistent motion, blurry, jittery, distorted"
