#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Curve Q4_0 transformer and the ComfyUI int8 ConvRot Qwen3-VL encoder.
# https://huggingface.co/Comfy-Org/MiniMax-H3
# Packed int8 layers stay packed. No quantizer on the encoder line.

MiniMaxAI/MiniMax-H3
--model-type minimax-h3-video
--dtype bfloat16
--model-sequential-offload
--transformer https://huggingface.co/joeygambino/MiniMax-H3-curve-GGUF/blob/main/fl2va/MiniMax-H3-fl2va-curve-Q4_0.gguf
--text-encoders "Qwen3VLForConditionalGeneration;model=https://huggingface.co/Comfy-Org/MiniMax-H3/blob/main/text_encoders/qwen3vl_32b_minimax_h3_int8_convrot.safetensors"
--inference-steps 30
--video-lengths 5
--video-fps 24
--animation-format mp4
--gen-seeds 1
--output-path minimax-h3-gguf-encoder
--output-size 1024x576
--prompts "A red fox trotting through a snowy pine forest, snow crunching underfoot"
