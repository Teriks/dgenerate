#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Same character swap as config.dgen, on the Ref2VA curve Q4_0 GGUF and
# an int8 Qwen3-VL encoder that keeps the language-model head. The LoRA
# is added on each packed linear and the GGUF weights stay packed.
# The boxer is examples/media/man-fighting-pose.jpg.
# The dance is examples/media/rickroll-roll.gif.

MiniMaxAI/MiniMax-H3
--model-type minimax-h3-video
--dtype bfloat16
--model-sequential-offload
--transformer https://huggingface.co/joeygambino/MiniMax-H3-curve-GGUF/blob/main/ref2va/MiniMax-H3-ref2va-curve-Q4_0.gguf
--text-encoders "Qwen3VLForConditionalGeneration;model=https://huggingface.co/Teriks/MiniMax-H3-Qwen3VL-text-encoder/blob/main/text_encoder-int8_tensorwise.safetensors"
--loras "https://huggingface.co/akatz-ai/MiniMax-H3-Character-Swap-LoRA/blob/main/h3_character_swap_v1.5.safetensors;scale=1.0"
--inference-steps 30
--video-lengths 5
--video-fps 24
--animation-format mp4
--gen-seeds 1
--output-path minimax-h3-character-swap-gguf
--output-size 960x544
--reference-image-processors "resize;size=768x512;align=32" + "resize;size=256x256;align=32"
--image-seeds "reference=../../media/man-fighting-pose.jpg, ../../media/rickroll-roll.gif"
--prompts "Replace the dancer in the video with the boxer in the image. Keep the boxer's face, hair, and clothing. Follow the dancer's pose, gaze, expression, and movement. Preserve the scene."
