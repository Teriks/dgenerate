#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Pruned int8 ConvRot transformer and an int8 Qwen3-VL encoder that keeps
# the language-model head.
# https://huggingface.co/Comfy-Org/MiniMax-H3
# https://huggingface.co/Teriks/MiniMax-H3-Qwen3VL-text-encoder

MiniMaxAI/MiniMax-H3
--model-type minimax-h3-video
--dtype bfloat16
--model-sequential-offload
--transformer https://huggingface.co/Comfy-Org/MiniMax-H3/blob/main/diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors
--text-encoders "Qwen3VLForConditionalGeneration;model=https://huggingface.co/Teriks/MiniMax-H3-Qwen3VL-text-encoder/blob/main/text_encoder-int8_tensorwise.safetensors"
--inference-steps 30
--video-lengths 5
--video-fps 24
--animation-format mp4
--gen-seeds 1
--output-path minimax-h3-comfy-int8-encoder
--output-size 1024x576
--prompts "A red fox trotting through a snowy pine forest, snow crunching underfoot"
