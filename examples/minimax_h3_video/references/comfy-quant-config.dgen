#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Same references as config.dgen, on the pruned ref2va int8 transformer
# and an int8 Qwen3-VL encoder that keeps the language-model head. The
# parent repo supplies the VAEs.
# https://huggingface.co/Comfy-Org/MiniMax-H3

MiniMaxAI/MiniMax-H3
--model-type minimax-h3-video
--dtype bfloat16
--model-sequential-offload
--transformer https://huggingface.co/Comfy-Org/MiniMax-H3/blob/main/diffusion_models/minimax_h3_ref2va_pruned_int8_convrot.safetensors
--text-encoders "Qwen3VLForConditionalGeneration;model=https://huggingface.co/Teriks/MiniMax-H3-Qwen3VL-text-encoder/blob/main/text_encoder-int8_tensorwise.safetensors"
--inference-steps 30
--video-lengths 5
--video-fps 24
--animation-format mp4
--gen-seeds 1
--output-path minimax-h3-ref2va-comfy-int8
--output-size 1024x576
--reference-image-processors "resize;size=768x512;align=32" + "resize;size=256x256;align=32"
--image-seeds "reference=../../media/man-fighting-pose.jpg, ../../media/rickroll-roll.gif"
--prompts "The man in the image dances with the motion in the video"
