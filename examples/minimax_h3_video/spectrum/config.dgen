#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Spectrum on the packed video and audio sequence. 30 steps include the
# terminal sigma, so the model runs 29 times. The default schedule warms
# up for 4 of those and then predicts every other step. The output heads
# still run. 960x544 is the faster canvas.

MiniMaxAI/MiniMax-H3
--model-type minimax-h3-video
--dtype bfloat16
--model-sequential-offload
--inference-steps 30
--spectrum
--video-lengths 5
--video-fps 24
--animation-format mp4
--gen-seeds 1
--output-path minimax-h3-spectrum
--output-size 960x544
--prompts "A red fox trotting through a snowy pine forest, snow crunching underfoot"
