#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Pro GGUF transformer and a W4A8 Qwen2.5-VL encoder.
# "+" keeps CLIP from the Diffusers repository.
# The text encoder file includes the vision tower. No quantizer: the linears stay packed.
# The full Pro repository is gated.

\set token %HF_TOKEN%

{% if not token.strip() and not '--auth-token' in injected_args %}
    \print Set HF_TOKEN environmental variable or pass --auth-token.
    \exit
{% endif %}

kandinskylab/Kandinsky-6.0-Pro-5s-Diffusers
--model-type kandinsky6-video
--dtype bfloat16
--model-sequential-offload
--transformer "https://huggingface.co/realrebelai/Kandinsky-6.0-Pro-5s_GGUFs/blob/main/Diffusion Model/Full/Kandinsky-6.0-Pro-5s-Q4_K_S.gguf"
--text-encoders "Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/realrebelai/Kandinsky-6.0-Pro-5s_GGUFs/blob/main/Text Encoder/K6-Qwen2.5-VL-7B-w4a8.safetensors" +
--inference-steps 50
--guidance-scales 5
--video-lengths 5
--video-fps 24
--animation-format mp4
--gen-seeds 1
--output-path kandinsky6-pro-gguf-encoder
--output-size 864x480
--prompts "A red kite glides above a windswept coastal meadow at golden hour. Audio: wind and distant surf."
