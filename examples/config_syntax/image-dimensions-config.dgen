#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Template helpers for reading and scaling image dimensions.
# Useful when looping over source images of mixed sizes before
# --output-size / ControlNet Tile upscales.

# Original helper: WIDTHxHEIGHT string (or a tuple with format_size=False)
\print {{ image_size("../media/beach.jpg") }}
\setp dims image_size("../media/beach.jpg", False)
\print {{ dims }}

# Integer width / height for arithmetic in \setp
\setp w image_width("../media/beach.jpg") * 2
\setp h image_height("../media/beach.jpg") * 2
\print {{ w }}x{{ h }}

# Or scale a file / size string in one call
\setp out_size scale_size("../media/beach.jpg", 2)
\print {{ out_size }}

\setp half_size scale_size("1024x768", 0.5)
\print {{ half_size }}

# Scale width and height independently with a tuple or "WxH" factors
\setp wide scale_size("512x768", (2, 1))
\print {{ wide }}

\setp tall scale_size("512x768", "1x2")
\print {{ tall }}

# Typical loop pattern: double each source image's size.
# sized needs delayed expansion because the {% for %} continuation
# is rendered before \setp runs.
{% for i in unquote("../media/*.jpg", expand=True) %}
    \setp sized scale_size("{{ i }}", 2)
    \print {{ i }} -> {{ '{{ sized }}' }}
{% endfor %}
