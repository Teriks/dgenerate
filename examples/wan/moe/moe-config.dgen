#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Wan 2.2 MoE text to video. --wan-second-transformer is the low-noise
# expert. --wan-boundary-ratios is the switch point. --wan-low-noise-guidance-scales
# is CFG for that expert.

Wan-AI/Wan2.2-T2V-A14B-Diffusers
--model-type wan
--dtype bfloat16
--model-sequential-offload
--inference-steps 30
--guidance-scales 4
--wan-low-noise-guidance-scales 3
--video-fps 16
--gen-seeds 1
--output-size 832x480
--video-lengths 3
--animation-format mp4
--output-path wan-moe
--prompts "A woman in a red coat walks along a dirt path through a green field, then stops and looks back at the camera. The camera stays fixed."
