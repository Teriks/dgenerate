#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# LightX2V 4-step LoRA for the undistilled Wan 2.1 14B text-to-video model.
# Guidance stays at 1. flow-shift=5 with 4 steps is the LightX2V schedule:
# the shifted timesteps are about 999, 937, 833, and 625.
# https://huggingface.co/lightx2v/Wan2.1-Distill-Loras

Wan-AI/Wan2.1-T2V-14B-Diffusers
--model-type wan
--dtype bfloat16
--model-sequential-offload
--scheduler UniPCMultistepScheduler;flow-shift=5
--loras "lightx2v/Wan2.1-Distill-Loras;scale=1.0;weight-name=wan2.1_t2v_14b_lora_rank64_lightx2v_4step.safetensors"
--inference-steps 4
--guidance-scales 1
--video-fps 16
--gen-seeds 1
--output-size 832x480
--video-lengths 5
--animation-format mp4
--output-path wan-lightx2v-4step
--prompts "A cat and a dog baking a cake together in a kitchen. The cat is carefully measuring flour, while the dog is stirring the batter with a wooden spoon. The kitchen is cozy, with sunlight streaming through the window."
