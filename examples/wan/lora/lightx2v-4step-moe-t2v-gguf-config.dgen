#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# LightX2V 4-step MoE LoRAs with QuantStack GGUF experts. Same as
# examples/wan/lora/lightx2v-4step-moe-t2v-config.dgen.

Wan-AI/Wan2.2-T2V-A14B-Diffusers
--model-type wan
--dtype bfloat16
--model-sequential-offload
--scheduler UniPCMultistepScheduler;flow-shift=5
--transformer https://huggingface.co/QuantStack/Wan2.2-T2V-A14B-GGUF/blob/main/HighNoise/Wan2.2-T2V-A14B-HighNoise-Q4_K_S.gguf
--wan-second-transformer https://huggingface.co/QuantStack/Wan2.2-T2V-A14B-GGUF/blob/main/LowNoise/Wan2.2-T2V-A14B-LowNoise-Q4_K_S.gguf
--loras "lightx2v/Wan2.2-Distill-Loras;scale=1.0;weight-name=wan2.2_t2v_A14b_high_noise_lora_rank64_lightx2v_4step_1217.safetensors" "lightx2v/Wan2.2-Distill-Loras;scale=1.0;weight-name=wan2.2_t2v_A14b_low_noise_lora_rank64_lightx2v_4step_1217.safetensors;component=transformer_2"
--inference-steps 4
--guidance-scales 1
--video-fps 16
--gen-seeds 1
--output-size 832x480
--video-lengths 5
--animation-format mp4
--output-path wan-lightx2v-4step-moe-gguf
--prompts "A cat and a dog baking a cake together in a kitchen. The cat is carefully measuring flour, while the dog is stirring the batter with a wooden spoon. The kitchen is cozy, with sunlight streaming through the window."
