#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# LightX2V 4-step LoRAs for undistilled Wan 2.2 14B image-to-video.
# The first LoRA is the high-noise expert. component=transformer_2 puts the
# second LoRA on the low-noise expert. Guidance stays at 1. flow-shift=5
# with 4 steps and the checkpoint boundary of 0.9 uses the high-noise
# expert for the first two steps and the low-noise expert for the last two.
# The still is the Diffusers astronaut photo.
# When CPU memory is too small for both experts, dgenerate keeps each
# component on disk and copies one layer to the device for its forward.
# https://huggingface.co/lightx2v/Wan2.2-Distill-Loras

\setp image "https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/diffusers/astronaut.jpg"

Wan-AI/Wan2.2-I2V-A14B-Diffusers
--model-type wan
--dtype bfloat16
--model-sequential-offload
--scheduler UniPCMultistepScheduler;flow-shift=5
--loras "lightx2v/Wan2.2-Distill-Loras;scale=1.0;weight-name=wan2.2_i2v_A14b_high_noise_lora_rank64_lightx2v_4step_1022.safetensors" "lightx2v/Wan2.2-Distill-Loras;scale=1.0;weight-name=wan2.2_i2v_A14b_low_noise_lora_rank64_lightx2v_4step_1022.safetensors;component=transformer_2"
--inference-steps 4
--guidance-scales 1
--video-fps 16
--gen-seeds 1
--output-size 832x480
--video-lengths 5
--animation-format mp4
--output-path wan-lightx2v-4step-moe-i2v
--image-seeds {{ image }}
--prompts "An astronaut in a white spacesuit stands on the lunar surface, then walks forward. Dust lifts around the boots. Earth hangs in the black sky. The suit matches the first frame."
