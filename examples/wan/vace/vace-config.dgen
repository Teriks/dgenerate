#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# VACE control. control= is the control clip, reference= is a still for
# appearance. --control-image-processors turns the clip into canny edges.

Wan-AI/Wan2.1-VACE-1.3B-diffusers
--model-type wan
--dtype bfloat16
--model-sequential-offload
--inference-steps 30
--guidance-scales 5
--video-fps 16
--gen-seeds 1
--output-size 832x480
--video-lengths 3
--animation-format mp4
--output-path wan-vace
--control-image-processors canny
--image-seeds "control=../../media/rickroll-roll.gif;reference=../../media/man-fighting-pose.jpg;frame-end=24"
--prompts "A boxer dances energetically in place. The camera stays fixed."
