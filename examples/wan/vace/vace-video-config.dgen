#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# VACE source clip in the normal seed slot. On a VACE checkpoint a video
# here is the source clip, the same role as control= when control= is
# omitted. There is no mask, so the whole frame is generated from the
# footage. Canny on this path would be --seed-image-processors. The
# source clip is 8 fps.

\setp video "https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/diffusers/hiker.mp4"
\setp neg "Bright tones, overexposed, static, blurred details, subtitles, style, works, paintings, images, static, overall gray, worst quality, low quality, JPEG compression residue, ugly, incomplete, extra fingers, poorly drawn hands, poorly drawn faces, deformed, disfigured, misshapen limbs, fused fingers, still picture, messy background, three legs, many people in the background, walking backwards"

Wan-AI/Wan2.1-VACE-1.3B-diffusers
--model-type wan
--dtype bfloat16
--model-sequential-offload
--inference-steps 30
--guidance-scales 5
--video-fps 8
--gen-seeds 1
--output-size 832x480
--video-lengths 6
--animation-format mp4
--output-path wan-vace-video
--image-seeds {{ video }}
--prompts "A traveler in a bright red coat walks a rocky cliff trail above the sea at sunset. Wind pulls the coat, warm light on the rocks, cinematic, the camera follows from behind.;{{ neg }}"
