#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Video-to-video uses a text-to-video checkpoint. This is the 1.3B FP8 file;
# patch_embedding width 1536 selects Wan-AI/Wan2.1-T2V-1.3B-Diffusers.
# https://civitai.com/models/1307708/wan21-t2v-13b-fp8
# A video path in --image-seeds is the video-to-video input. There is no
# separate v2v weight file. text-to-video-config.dgen is the 14B T2V file.

\set civit_ai_token %CIVIT_AI_TOKEN%

{% if not civit_ai_token.strip() %}
    \print Set CIVIT_AI_TOKEN environmental variable to run this example!
    \exit
{% endif %}

\setp video "https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/diffusers/hiker.mp4"
\setp neg "Bright tones, overexposed, static, blurred details, subtitles, style, works, paintings, images, static, overall gray, worst quality, low quality, JPEG compression residue, ugly, incomplete, extra fingers, poorly drawn hands, poorly drawn faces, deformed, disfigured, misshapen limbs, fused fingers, still picture, messy background, three legs, many people in the background, walking backwards"

https://civitai.com/api/download/models/1475726?fileId=1377109
--model-type wan
--dtype bfloat16
--model-sequential-offload
--inference-steps 30
--guidance-scales 5
--video-fps 16
--gen-seeds 1
--output-size 832x480
--animation-format mp4
--output-path wan-civitai-v2v
--image-seeds {{ video }}
--image-seed-strengths 0.7
--prompts "A robot standing on a mountain top. The sun is setting in the background;{{ neg }}"
