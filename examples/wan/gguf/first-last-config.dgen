#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Wan first-last-frame transformer as a GGUF. last-frame= is the
# closing still. The repository still supplies the image encoder.

Wan-AI/Wan2.1-FLF2V-14B-720P-diffusers
--model-type wan
--dtype bfloat16
--model-sequential-offload
--transformer https://huggingface.co/city96/Wan2.1-FLF2V-14B-720P-gguf/blob/main/wan2.1-flf2v-14b-720p-Q4_K_S.gguf
--inference-steps 30
--guidance-scales 5
--video-fps 16
--gen-seeds 1
--output-size 1280x720
--video-lengths 3
--animation-format mp4
--output-path wan-flf2v-gguf
--image-seeds "../../media/earth.jpg;last-frame=../../media/mountain.png"
--prompts "The camera travels from the Earth toward a mountain range."
