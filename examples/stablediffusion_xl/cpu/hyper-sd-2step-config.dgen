#! /usr/bin/env dgenerate --file
#! dgenerate 6.0.0

# Two steps on CPU. Hyper-SD's 2-step LoRA uses DDIMScheduler with
# trailing timesteps and guidance 0. 1024 is the SDXL training resolution, and it is slow on CPU.

stabilityai/stable-diffusion-xl-base-1.0 --model-type sdxl
--dtype float32
--device cpu
--loras "ByteDance/Hyper-SD;weight-name=Hyper-SDXL-2steps-lora.safetensors"
--scheduler DDIMScheduler;timestep-spacing=trailing
--vae AutoencoderTiny;model=madebyollin/taesdxl
--inference-steps 2
--guidance-scales 0
--gen-seeds 1
--output-size 1024
--output-path sdxl-hyper-sd-2step
--prompts "a small puppy"
