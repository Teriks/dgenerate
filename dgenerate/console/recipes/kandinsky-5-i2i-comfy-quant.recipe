title: Kandinsky 5 Image Edit Lite (ComfyUI Quant)

@uri[{"label":"Model Path / HF Slug", "dir":true, "default":"kandinskylab/Kandinsky-5.0-I2I-Lite-sft-Diffusers", "optional":false, "file-types":["models"]}]
--model-type kandinsky5-image
@file[{"id":"image-seed", "label":"Condition Image", "arg":"--image-seeds", "optional":false, "mode":"input", "file-types":["images-in"]}]
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["bfloat16", "float16", "float32"], "default":"bfloat16"}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler"}]
@spectrum[{"id": "sp", "divider-after": true}]
@switchfile[{"id": "cd", "label":"Use Cache-DiT", "arg":"--cache-dit", "exclude":["sp"], "file-implies-switch":true, "file":{"label":"Cache-DiT YAML Config", "arg":"--cache-dit-config", "mode":"input", "optional":true, "file-types":["yaml"], "divider-after":true}}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"], "default":1}]
@torchcompile[{"model-type":"kandinsky5-image"}]
@quantizer[{"model-type": "kandinsky5-image", "map-default": "text_encoder"}]
@textencoders[{"model-type":"kandinsky5-image","arg":"--text-encoders", "divider-after":true}]
@submodelbuilder[{"id":"lora", "label":"LoRA", "arg":"--loras", "model":"LoRA"}]
@float[{"label":"LoRA Fuse Scale","arg":"--lora-fuse-scale","min":0, "enabled-when":{"id":"lora","not-empty":true}}]
@switch[{"label":"LoRA Disk Fuse", "arg":"--lora-disk-fuse", "enabled-when":{"id":"lora","not-empty":true}}]
@submodelbuilder[{"label": "Transformer", "arg": "--transformer", "model": "Transformer", "default": "https://huggingface.co/Teriks/Kandinsky-5.0-I2I-Lite-quants/blob/main/transformer-int8_tensorwise-comfy.safetensors", "divider-after": true, "suggestions": [{"label": "int8_tensorwise", "value": "https://huggingface.co/Teriks/Kandinsky-5.0-I2I-Lite-quants/blob/main/transformer-int8_tensorwise-comfy.safetensors"}, {"label": "float8_e4m3fn", "value": "https://huggingface.co/Teriks/Kandinsky-5.0-I2I-Lite-quants/blob/main/transformer-float8_e4m3fn-comfy.safetensors"}]}]
@imageprocessor[{"arg":"--seed-image-processors", "label":"Condition Image Processor", "enabled-when":{"id":"image-seed","not-empty":true}}]
@int[{"label":"Inference Steps","arg":"--inference-steps","default":50,"min":1,"id":"is","exclude":["ts"]}]
@sigmas[{"id":"sigmas","label":"Sigmas","arg":"--sigmas","base":[1.0,0.979612,0.959224,0.938837,0.918449,0.898061,0.877673,0.857286,0.836898,0.81651,0.796122,0.775735,0.755347,0.734959,0.714571,0.694184,0.673796,0.653408,0.63302,0.612633,0.592245,0.571857,0.551469,0.531082,0.510694,0.490306,0.469918,0.449531,0.429143,0.408755,0.388367,0.36798,0.347592,0.327204,0.306816,0.286429,0.266041,0.245653,0.225265,0.204878,0.18449,0.164102,0.143714,0.123327,0.102939,0.082551,0.062163,0.041776,0.021388,0.001],"exclude":["ts"]}]
@timesteps[{"id":"ts","label":"Timesteps (override)","arg":"--timesteps","default":"","exclude":["is","sigmas"]}]
@float[{"label":"Guidance Scale", "arg":"--guidance-scales", "default":3.5, "min":0}]
@int[{"label":"Max Sequence Length", "arg":"--max-sequence-length", "default":512, "min":1, "max":1023}]
@switch[{"id":"pipeline-prompt-enhance", "label":"Pipeline Prompt Enhance", "arg":"--pipeline-prompt-enhance", "divider-before":true}]
@stringfile[{"label":"Enhancer System Prompt", "arg":"--pipeline-prompt-enhance", "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@seeds[{"label":"Enhancer Seeds", "optional":true, "default":"", "seeds-arg":"--pipeline-prompt-enhance-seeds", "count-arg":"--pipeline-prompt-enhance-gen-seeds", "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@float[{"label":"Enhancer Temperature", "arg":"--pipeline-prompt-enhance-temperature", "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@float[{"label":"Enhancer Top-P", "arg":"--pipeline-prompt-enhance-top-p", "min":0, "max":1, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@int[{"label":"Enhancer Top-K", "arg":"--pipeline-prompt-enhance-top-k", "min":0, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@float[{"label":"Enhancer Presence Penalty", "arg":"--pipeline-prompt-enhance-presence-penalty", "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@int[{"label":"Enhancer Max New Tokens", "arg":"--pipeline-prompt-enhance-max-new-tokens", "min":1, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@int[{"label":"Enhancer Min New Tokens", "arg":"--pipeline-prompt-enhance-min-new-tokens", "min":0, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@float[{"label":"Enhancer GPU Headroom (GiB)", "arg":"--pipeline-prompt-enhance-gpu-headroom", "min":0, "divider-after":true, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@seeds[{"label":"Seeds"}]
@dir[{"label":"Output Directory", "arg":"--output-path", "default":"output"}]
@imageformat[{}]
@imagesize[{"label":"Output Size (WxH)", "arg":"--output-size", "default":"1024x1024"}]
@promptupscaler[{"label":"Prompt Upscaler", "arg":"--prompt-upscaler"}]
@imageprocessor[{"arg":"--post-processors", "label":"Post Processor"}]
@device[{}]
--prompts "add your prompt here"
