title: MiniMax-H3-Video References (GGUF)

# Pruned curve GGUF of the reference transformer. The parent repo supplies
# Qwen3-VL and the VAEs. Audio cannot be the only reference.

@uri[{"label":"Model Path / HF Slug", "dir":true, "default":"MiniMaxAI/MiniMax-H3", "optional":false, "file-types":["models"]}]
--model-type minimax-h3-video
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["bfloat16", "float16", "float32"], "default":"bfloat16"}]
@karrasscheduler[{"label":"Video Scheduler", "arg":"--scheduler", "filter":["MiniMaxH3Scheduler"]}]
@karrasscheduler[{"label":"Audio Scheduler", "arg":"--second-model-scheduler", "filter":["MiniMaxH3Scheduler"]}]
@switchfile[{"id": "cd", "label":"Use Cache-DiT", "arg":"--cache-dit", "file-implies-switch":true, "file":{"label":"Cache-DiT YAML Config", "arg":"--cache-dit-config", "mode":"input", "optional":true, "file-types":["yaml"], "divider-after":true}}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"], "default":1}]
@torchcompile[{"model-type":"minimax-h3-video"}]
@quantizer[{"model-type":"minimax-h3-video", "map-default":"text_encoder"}]
@textencoders[{"model-type":"minimax-h3-video","arg":"--text-encoders", "divider-after":true}]
@submodelbuilder[{"label":"Reference Transformer GGUF", "arg":"--transformer", "model":"Transformer", "default":"https://huggingface.co/joeygambino/MiniMax-H3-curve-GGUF/blob/main/ref2va/MiniMax-H3-ref2va-curve-Q4_0.gguf", "divider-after":true, "suggestions":[{"label":"ref2va curve Q4_0", "value":"https://huggingface.co/joeygambino/MiniMax-H3-curve-GGUF/blob/main/ref2va/MiniMax-H3-ref2va-curve-Q4_0.gguf"}, {"label":"ref2va curve Q5_1", "value":"https://huggingface.co/joeygambino/MiniMax-H3-curve-GGUF/blob/main/ref2va/MiniMax-H3-ref2va-curve-Q5_1.gguf"}, {"label":"ref2va curve Q8_0", "value":"https://huggingface.co/joeygambino/MiniMax-H3-curve-GGUF/blob/main/ref2va/MiniMax-H3-ref2va-curve-Q8_0.gguf"}, {"label":"ref2va Q4_0", "value":"https://huggingface.co/joeygambino/MiniMax-H3-GGUF/blob/main/ref2va/MiniMax-H3-ref2va-Q4_0.gguf"}, {"label":"ref2va Q5_1", "value":"https://huggingface.co/joeygambino/MiniMax-H3-GGUF/blob/main/ref2va/MiniMax-H3-ref2va-Q5_1.gguf"}]}]
@imageseed[{"id":"image-seed", "label":"References", "arg":"--image-seeds", "optional":false, "hide-float":true}]
@int[{"label":"Inference Steps","arg":"--inference-steps","default":30,"min":1}]
@float[{"label":"Video Length (seconds)", "arg":"--video-lengths", "default":5.17, "min":5, "max":15}]
@float[{"label":"Video FPS", "arg":"--video-fps", "default":24, "min":1}]
@dropdown[{"label":"Animation Format", "arg":"--animation-format", "options":["mp4", "gif", "webp", "apng", "frames"], "default":"mp4", "optional":false}]
@switch[{"id":"pipeline-prompt-enhance", "label":"Pipeline Prompt Enhance", "arg":"--pipeline-prompt-enhance", "divider-before":true}]
@stringfile[{"label":"Enhancer System Prompt", "arg":"--pipeline-prompt-enhance", "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@seeds[{"label":"Enhancer Seeds", "optional":true, "default":"", "seeds-arg":"--pipeline-prompt-enhance-seeds", "count-arg":"--pipeline-prompt-enhance-gen-seeds", "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@float[{"label":"Enhancer Temperature", "arg":"--pipeline-prompt-enhance-temperature", "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@float[{"label":"Enhancer Top-P", "arg":"--pipeline-prompt-enhance-top-p", "min":0, "max":1, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@int[{"label":"Enhancer Top-K", "arg":"--pipeline-prompt-enhance-top-k", "min":0, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@float[{"label":"Enhancer Presence Penalty", "arg":"--pipeline-prompt-enhance-presence-penalty", "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@int[{"label":"Enhancer Max New Tokens", "arg":"--pipeline-prompt-enhance-max-new-tokens", "min":1, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@int[{"label":"Enhancer Min New Tokens", "arg":"--pipeline-prompt-enhance-min-new-tokens", "min":0, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@float[{"label":"Enhancer GPU Headroom (GiB)", "arg":"--pipeline-prompt-enhance-gpu-headroom", "min":0, "divider-after":true, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@seeds[{"label":"Seeds"}]
@dir[{"label":"Output Directory", "arg":"--output-path", "default":"output"}]
@switch[{"label":"Output Configs", "arg":"--output-configs"}]
@imagesize[{"label":"Output Size (WxH)", "arg":"--output-size", "default":"1344x768"}]
@promptupscaler[{"label":"Prompt Upscaler", "arg":"--prompt-upscaler"}]
@imageprocessor[{"arg":"--post-processors", "label":"Post Processor"}]
@device[{}]
--prompts "The character speaks in time with the reference recording"
