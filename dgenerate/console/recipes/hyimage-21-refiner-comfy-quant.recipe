title: HunyuanImage 2.1 Refiner (ComfyUI Quant)

# Refiner transformer + refiner Diffusers slug. Requires a condition image (--image-seeds).

@uri[{"label":"Model Path / HF Slug", "dir":true, "default":"hunyuanvideo-community/HunyuanImage-2.1-Refiner-Diffusers", "optional":false, "file-types":["models"]}]
--model-type hyimage-21-refiner
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["bfloat16", "float16", "float32"], "default":"bfloat16"}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler", "filter":["FlowMatchEulerDiscreteScheduler"]}]
@switch[{"id":"sp", "label":"Use Spectrum", "arg":"--spectrum", "divider-after":true}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"], "default":1}]
@switch[{"label":"Torch Compile", "arg":"--torch-compile"}]
@quantizer[{"model-type":"hyimage-21-refiner", "divider-after":true, "map-default":"text_encoder"}]
@submodelbuilder[{"label":"Transformer", "arg":"--transformer", "model":"Transformer", "default":"https://huggingface.co/Comfy-Org/Hunyuan-Image-2.1/resolve/main/split_files/diffusion_models/hunyuanimage2.1_refiner_fp8_e4m3fn.safetensors", "divider-after":true}]
@imageseed[{"label":"Input Image", "arg":"--image-seeds", "file-types":["images-in"], "hide-float":true}]
@int[{"label":"Inference Steps", "arg":"--inference-steps", "default":4, "min":1}]
@float[{"label":"Distilled Guidance Scale", "arg":"--guidance-scales", "default":3.25, "min":0}]
@seeds[{"label":"Seeds"}]
@dir[{"label":"Output Directory", "arg":"--output-path", "default":"output"}]
@imageformat[{}]
@imagesize[{"label":"Output Size (WxH)", "arg":"--output-size", "default":"2048x2048"}]
@promptupscaler[{"label":"Prompt Upscaler", "arg":"--prompt-upscaler"}]
@imageprocessor[{"arg":"--post-processors", "label":"Post Processor"}]
@device[{}]
--prompts "add your prompt here"
