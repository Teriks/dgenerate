title: Z-Image (ControlNet)
order: 32

# Text-to-image union. Inpaint needs the 2.0 file instead, and no image seed strength.

@uri[{"label":"Model Path / HF Slug", "dir":true, "default": "Tongyi-MAI/Z-Image-Turbo", "optional":false, "file-types":["models"]}]
--model-type z-image
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["float16", "bfloat16", "float32"], "default":"bfloat16"}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler", "filter": ["FlowMatchEulerDiscreteScheduler"]}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"], "default":1}]
@switch[{"label":"Torch Compile", "arg":"--torch-compile", "divider-after":true}]
@submodelbuilder[{"label":"Control Net", "arg":"--control-nets", "model": "Control Net", "default": "https://huggingface.co/alibaba-pai/Z-Image-Turbo-Fun-Controlnet-Union/resolve/main/Z-Image-Turbo-Fun-Controlnet-Union.safetensors;scale=0.75"}]
@imageseed[{"label":"Control Image", "arg":"--image-seeds", "file-types":["images-in"], "default":"", "float":""}]
@imageprocessor[{"arg":"--control-image-processors", "label":"Control Image Processor", "divider-after":true}]
@int[{"label":"Inference Steps", "arg":"--inference-steps", "default":8, "min":1}]
@float[{"label":"Guidance Scale", "arg":"--guidance-scales", "default":0, "min":0}]
@seeds[{"label":"Seeds"}]
@dir[{"label":"Output Directory", "arg":"--output-path", "default":"output"}]
@imageformat[{}]
@imagesize[{"label":"Output Size (WxH)", "arg":"--output-size", "default":"1024x1024", "divider-after":true}]
@promptupscaler[{"label":"Prompt Upscaler", "arg":"--prompt-upscaler"}]
@imageprocessor[{"arg":"--post-processors", "label":"Post Processor"}]
@device[{}]
--prompts "add your prompt here"
