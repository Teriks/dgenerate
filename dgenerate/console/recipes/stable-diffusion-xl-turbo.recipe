title: Stable Diffusion XL Turbo

@uri[{"label":"Model Path / HF Slug", "dir":true, "default": "stabilityai/sdxl-turbo", "optional":false, "file-types":["models"]}]
@file[{"label": "Original Config (yaml)", "arg": "--original-config", "file-types": ["yaml"]}]
--model-type sdxl
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["float16", "bfloat16", "float32"], "default":"float32"}]
@dropdown[{"label":"Model variant", "arg":"--variant", "options":["fp16", "bf16"]}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler"}]
@checkboxwithtwointargs[{"id": "dc", "label":"Use DeepCache", "help-arg":"--deep-cache", "int1-label": "DeepCache Interval", "int1-arg":"--deep-cache-intervals", "int1":5, "int1-min":1, "int2-label":"DeepCache Branch ID", "int2":1, "int2-arg": "--deep-cache-branch-ids", "int2-min":0}]
@conditionalcheckboxes[{"id": "hd", "labels":["Use HiDiffusion", "HiDiffusion No Window Attention", "HiDiffusion No RAUNet"], "args":["--hi-diffusion", "--hi-diffusion-no-win-attn", "--hi-diffusion-no-raunet"]}]
@sada[{"id": "sada", "preset": "sdxl", "exclude": ["hd", "dc"], "divider-after": true}]
@spectrum[{"id": "sp", "exclude": ["hd", "dc", "sada"], "divider-after": true}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"]}]
@torchcompile[{"model-type":"sdxl"}]
@quantizer[{"model-type":"sdxl"}]
@textencoders[{"model-type":"sdxl","arg":"--text-encoders","divider-after":true}]
@submodelbuilder[{"id":"refiner", "label":"Refiner", "arg":"--sdxl-refiner", "model": "SDXL Refiner", "default":"stabilityai/stable-diffusion-xl-refiner-1.0"}]
@file[{"label": "Refiner Original Config (yaml)", "arg": "--second-model-original-config", "file-types": ["yaml"], "enabled-when":{"id":"refiner","not-empty":true}}]
@textencoders[{"label":"Refiner Text Encoder","model-type":"sdxl","arg":"--second-model-text-encoders", "enabled-when":{"id":"refiner","not-empty":true}}]
@karrasscheduler[{"label":"Refiner Scheduler", "arg":"--second-model-scheduler", "default":"UniPCMultistepScheduler", "enabled-when":{"id":"refiner","not-empty":true}}]
@checkboxwithtwointargs[{"label":"Refiner Use DeepCache", "help-arg":"--sdxl-refiner-deep-cache", "int1-label": "Refiner DeepCache Interval", "int1-arg":"--sdxl-refiner-deep-cache-intervals", "int1":5, "int1-min":1, "int2-label":"Refiner DeepCache Branch ID", "int2":1, "int2-arg": "--sdxl-refiner-deep-cache-branch-ids", "int2-min":0, "enabled-when":{"id":"refiner","not-empty":true}}]
@switch[{"label":"Refiner Edit Mode", "arg":"--sdxl-refiner-edit", "enabled-when":{"id":"refiner","not-empty":true}}]
@switchradio[{"labels":["Refiner CPU Offload", "Refiner Sequential Offload", "Refiner Group Offload"], "args":["--second-model-cpu-offload", "--second-model-sequential-offload", "--second-model-group-offload"], "enabled-when":{"id":"refiner","not-empty":true}}]
@quantizer[{"model-type":"sdxl", "label": "Refiner Quantizer", "arg":"--second-model-quantizer", "divider-after":true, "enabled-when":{"id":"refiner","not-empty":true}}]
@submodelbuilder[{"label":"VAE", "arg":"--vae", "model": "VAE", "default":"AutoencoderTiny;model=madebyollin/taesdxl"}]
@switch[{"label":"VAE Tiling", "arg":"--vae-tiling"}]
@switch[{"label":"VAE Slicing", "arg":"--vae-slicing", "divider-after":true}]
@submodelbuilder[{"id":"lora", "label":"LoRA", "arg":"--loras", "model": "LoRA"}]
@float[{"label":"LoRA Fuse Scale","arg":"--lora-fuse-scale","min":0, "enabled-when":{"id":"lora","not-empty":true}}]
@switch[{"label":"LoRA Disk Fuse", "arg":"--lora-disk-fuse", "enabled-when":{"any":[{"id":"lora","not-empty":true},{"id":"control-lora","not-empty":true}]}}]
@submodelbuilder[{"id":"control-net", "label":"Control Net", "arg":"--control-nets", "model": "Control Net"}]
@submodelbuilder[{"id":"control-lora","label":"Control LoRA","arg":"--control-loras","model":"Control LoRA","exclude":"control-net"}]
@float[{"label":"Control LoRA Fuse Scale","arg":"--control-lora-fuse-scale","min":0, "enabled-when":{"id":"control-lora","not-empty":true}}]
@submodelbuilder[{"label":"T2I Adapter", "arg":"--t2i-adapters", "model": "T2I Adapter"}]
@submodelbuilder[{"label":"UNet", "arg":"--unet", "model": "UNet"}]
@submodelbuilder[{"label":"Refiner UNet", "arg":"--second-model-unet", "model": "UNet", "divider-after":true, "enabled-when":{"id":"refiner","not-empty":true}}]
@submodelbuilder[{"id":"ip-adapter", "label":"IP Adapter", "arg":"--ip-adapters", "model": "IP Adapter"}]
@submodelbuilder[{"label":"Image Encoder", "arg":"--image-encoder", "model": "Image Encoder", "divider-after":true, "enabled-when":{"id":"ip-adapter","not-empty":true}}]
@imageseed[{"id":"image-seed", "label":"Image Seed", "arg":"--image-seeds", "file-types":["images-in", "videos-in"], "float-label":"Image Seed Strength", "float-arg":"--image-seed-strengths", "min":0.01, "max":1, "default":"", "float":""}]
@switch[{"label":"No Aspect Correction?", "arg":"--no-aspect", "enabled-when":{"id":"image-seed","not-empty":true}}]
@imageprocessor[{"arg":"--seed-image-processors", "label":"Seed Image Processor", "enabled-when":{"id":"image-seed","not-empty":true}}]
@imageprocessor[{"arg":"--mask-image-processors", "label":"Inpaint Mask Processor", "enabled-when":{"id":"image-seed","not-empty":true}}]
@imageprocessor[{"arg":"--control-image-processors", "label":"Control Image Processor", "enabled-when":{"id":"image-seed","not-empty":true}}]
@latentsprocessor[{"arg":"--img2img-latents-processors", "label":"Img2Img Latents Processor", "enabled-when":{"id":"image-seed","not-empty":true}}]
@latentsprocessor[{"arg":"--latents-processors", "label":"Raw Latents Processor", "divider-after":true, "enabled-when":{"id":"image-seed","not-empty":true}}]
@int[{"id":"is","label":"Inference Steps","arg":"--inference-steps","default":1,"min":1,"exclude":["ts"]}]
@sigmas[{"id":"sigmas","label":"Sigmas","arg":"--sigmas","base":[14.614641,0.029167],"exclude":["ts"]}]
@timesteps[{"id":"ts","label":"Timesteps (override)","arg":"--timesteps","default":"","exclude":["is","sigmas"]}]
@float[{"label":"Guidance Scale", "arg":"--guidance-scales", "default":0, "min":0}]
@float[{"label":"Guidance Rescale", "arg":"--guidance-rescales", "min":0}]
@float[{"label":"PAG Scale", "arg":"--pag-scales", "min":0}]
@float[{"label":"Adaptive PAG Scale", "arg":"--pag-adaptive-scales", "min":0}]
@string[{"label":"PAG Applied Layers", "arg":"--pag-applied-layers"}]
@float[{"label":"T2I Adapter Factor", "arg":"--sdxl-t2i-adapter-factors", "min":0}]
@float[{"label":"SDXL High Noise Fraction", "arg":"--sdxl-high-noise-fractions", "default":0.8, "min":0.001, "max":0.99, "enabled-when":{"id":"refiner","not-empty":true}}]
@float[{"label":"Aesthetic Score", "arg":"--sdxl-aesthetic-scores", "min":0}]
@float[{"label":"Negative Aesthetic Score", "arg":"--sdxl-negative-aesthetic-scores", "min":0}]
@string[{"label":"Crop Coords Top Left", "arg":"--sdxl-crops-coords-top-left"}]
@string[{"label":"Negative Crop Coords Top Left", "arg":"--sdxl-negative-crops-coords-top-left"}]
@string[{"label":"Original Size", "arg":"--sdxl-original-sizes"}]
@string[{"label":"Target Size", "arg":"--sdxl-target-sizes"}]
@string[{"label":"Negative Original Size", "arg":"--sdxl-negative-original-sizes"}]
@string[{"label":"Negative Target Size", "arg":"--sdxl-negative-target-sizes"}]
@int[{"label":"Refiner Inference Steps", "arg":"--second-model-inference-steps", "default":100, "min":1, "enabled-when":{"id":"refiner","not-empty":true}}]
