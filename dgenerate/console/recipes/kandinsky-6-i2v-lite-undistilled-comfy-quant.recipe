title: Kandinsky 6 Video Lite Undistilled Image to Video (ComfyUI Quant)

# int8 convrot ComfyUI quant of the undistilled Lite transformer.
# Undistilled Lite: 50 steps, guidance 5, FlowMatchEulerDiscreteScheduler, 5 seconds with audio.
# One still image is the first frame.

@uri[{"label":"Model Path / HF Slug", "dir":true, "default":"kandinskylab/Kandinsky-6.0-Lite-5s-Diffusers", "optional":false, "file-types":["models"]}]
--model-type kandinsky6-video
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["bfloat16", "float16", "float32"], "default":"bfloat16"}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler"}]
@spectrum[{"id": "sp", "divider-after": true}]
@switchfile[{"id": "cd", "label":"Use Cache-DiT", "arg":"--cache-dit", "exclude":["sp"], "file-implies-switch":true, "file":{"label":"Cache-DiT YAML Config", "arg":"--cache-dit-config", "mode":"input", "optional":true, "file-types":["yaml"], "divider-after":true}}]
@dype[{"exclude":["cd", "sp"],"divider-after":true}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"], "default":1}]
@torchcompile[{"model-type":"kandinsky6-video"}]
@quantizer[{"model-type":"kandinsky6-video", "map-default":"text_encoder"}]
@textencoders[{"model-type":"kandinsky6-video","arg":"--text-encoders", "divider-after":true}]
@imageseed[{"id":"image-seed", "label":"First Frame", "arg":"--image-seeds", "file-types":["images-in"], "optional":false, "hide-float":true}]
@imageprocessor[{"arg":"--seed-image-processors", "label":"First Frame Processor", "enabled-when":{"id":"image-seed","not-empty":true}}]
@submodelbuilder[{"label":"Transformer", "arg":"--transformer", "model":"Transformer", "default":"https://huggingface.co/kabachuha/Kandinsky-6.0-Lite-5s-int8-convrot/blob/main/Kandinsky-6.0-Lite-5s-int8-convrot.safetensors", "divider-after":true, "suggestions":[{"label":"int8-convrot", "value":"https://huggingface.co/kabachuha/Kandinsky-6.0-Lite-5s-int8-convrot/blob/main/Kandinsky-6.0-Lite-5s-int8-convrot.safetensors"}]}]
@int[{"id":"is","label":"Inference Steps","arg":"--inference-steps","default":50,"min":1,"exclude":["ts"]}]
@sigmas[{"id":"sigmas","label":"Sigmas","arg":"--sigmas","base":[1.0,0.979693,0.959387,0.93908,0.918774,0.898467,0.878161,0.857854,0.837548,0.817241,0.796935,0.776628,0.756322,0.736015,0.715709,0.695402,0.675096,0.654789,0.634482,0.614176,0.593869,0.573563,0.553256,0.53295,0.512643,0.492337,0.47203,0.451724,0.431417,0.411111,0.390804,0.370498,0.350191,0.329885,0.309578,0.289271,0.268965,0.248658,0.228352,0.208045,0.187739,0.167432,0.147126,0.126819,0.106513,0.086206,0.0659,0.045593,0.025287,0.00498],"exclude":["ts"]}]
@timesteps[{"id":"ts","label":"Timesteps (override)","arg":"--timesteps","default":"","exclude":["is","sigmas"]}]
@float[{"label":"Guidance Scale", "arg":"--guidance-scales", "default":5, "min":0}]
@int[{"label":"Max Sequence Length", "arg":"--max-sequence-length", "default":512, "min":1, "max":512}]
@float[{"label":"Video Length (seconds)", "arg":"--video-lengths", "default":5, "min":0.1}]
@float[{"label":"Video FPS", "arg":"--video-fps", "default":24, "min":1}]
@dropdown[{"label":"Animation Format", "arg":"--animation-format", "options":["mp4", "gif", "webp", "apng", "frames"], "default":"mp4", "optional":false}]
@switch[{"id":"pipeline-prompt-enhance", "label":"Pipeline Prompt Enhance", "arg":"--pipeline-prompt-enhance", "divider-before":true}]
@stringfile[{"label":"Enhancer System Prompt", "arg":"--pipeline-prompt-enhance", "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@seeds[{"label":"Enhancer Seeds", "optional":true, "default":"", "seeds-arg":"--pipeline-prompt-enhance-seeds", "count-arg":"--pipeline-prompt-enhance-gen-seeds", "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@float[{"label":"Enhancer Temperature", "arg":"--pipeline-prompt-enhance-temperature", "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@float[{"label":"Enhancer Top-P", "arg":"--pipeline-prompt-enhance-top-p", "min":0, "max":1, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@int[{"label":"Enhancer Top-K", "arg":"--pipeline-prompt-enhance-top-k", "min":0, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@float[{"label":"Enhancer Presence Penalty", "arg":"--pipeline-prompt-enhance-presence-penalty", "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@int[{"label":"Enhancer Max New Tokens", "arg":"--pipeline-prompt-enhance-max-new-tokens", "min":1, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@int[{"label":"Enhancer Min New Tokens", "arg":"--pipeline-prompt-enhance-min-new-tokens", "min":0, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@float[{"label":"Enhancer GPU Headroom (GiB)", "arg":"--pipeline-prompt-enhance-gpu-headroom", "min":0, "divider-after":true, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@seeds[{"label":"Seeds"}]
@dir[{"label":"Output Directory", "arg":"--output-path", "default":"output"}]
@switch[{"label":"Output Configs", "arg":"--output-configs"}]
@imagesize[{"label":"Output Size (WxH)", "arg":"--output-size", "default":"864x480"}]
@promptupscaler[{"label":"Prompt Upscaler", "arg":"--prompt-upscaler"}]
@imageprocessor[{"arg":"--post-processors", "label":"Post Processor"}]
@device[{}]
--prompts "add your prompt here"
