title: Stable Diffusion XL

@uri[{"label":"Model Path / HF Slug", "dir":true, "default": "stabilityai/stable-diffusion-xl-base-1.0", "optional":false, "file-types":["models"]}]
@file[{"label": "Original Config (yaml)", "arg": "--original-config", "file-types": ["yaml"]}]
--model-type sdxl
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["float16", "bfloat16", "float32"], "default":"float16"}]
@dropdown[{"label":"Model variant", "arg":"--variant", "options":["fp16", "bf16"], "default":"fp16"}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler"}]
@checkboxwithtwointargs[{"id": "dc", "label":"Use DeepCache", "help-arg":"--deep-cache", "int1-label": "DeepCache Interval", "int1-arg":"--deep-cache-intervals", "int1":5, "int1-min":1, "int2-label":"DeepCache Branch ID", "int2":1, "int2-arg": "--deep-cache-branch-ids", "int2-min":0}]
@conditionalcheckboxes[{"id": "hd", "labels":["Use HiDiffusion", "HiDiffusion No Window Attention", "HiDiffusion No RAUNet"], "args":["--hi-diffusion", "--hi-diffusion-no-win-attn", "--hi-diffusion-no-raunet"]}]
@switch[{"id": "sada", "label":"Use SADA", "arg":"--sada", "exclude": ["hd", "dc"]}]
@switch[{"id": "sp", "label":"Use Spectrum", "arg":"--spectrum", "exclude": ["hd", "dc", "sada"]}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"]}]
@switch[{"label":"Torch Compile", "arg":"--torch-compile"}]
@quantizer[{"model-type":"sdxl", "divider-after":true}]
@submodelbuilder[{"label":"Refiner", "arg":"--sdxl-refiner", "model": "SDXL Refiner", "default":"stabilityai/stable-diffusion-xl-refiner-1.0"}]
@file[{"label": "Refiner Original Config (yaml)", "arg": "--second-model-original-config", "file-types": ["yaml"]}]
@karrasscheduler[{"label":"Refiner Scheduler", "arg":"--second-model-scheduler"}]
@checkboxwithtwointargs[{"label":"Refiner Use DeepCache", "help-arg":"--sdxl-refiner-deep-cache", "int1-label": "Refiner DeepCache Interval", "int1-arg":"--sdxl-refiner-deep-cache-intervals", "int1":5, "int1-min":1, "int2-label":"Refiner DeepCache Branch ID", "int2":1, "int2-arg": "--sdxl-refiner-deep-cache-branch-ids", "int2-min":0}]
@switch[{"label":"Refiner Edit Mode", "arg":"--sdxl-refiner-edit"}]
@switchradio[{"labels":["Refiner CPU Offload", "Refiner Sequential Offload", "Refiner Group Offload"], "args":["--second-model-cpu-offload", "--second-model-sequential-offload", "--second-model-group-offload"]}]
@quantizer[{"model-type":"sdxl", "label": "Refiner Quantizer", "arg":"--second-model-quantizer", "divider-after":true}]
@submodelbuilder[{"label":"VAE", "arg":"--vae", "model": "VAE"}]
@switch[{"label":"VAE Tiling", "arg":"--vae-tiling"}]
@switch[{"label":"VAE Slicing", "arg":"--vae-slicing", "divider-after":true}]
@submodelbuilder[{"label":"LoRA", "arg":"--loras", "model": "LoRA"}]
@float[{"label":"LoRA Fuse Scale","arg":"--lora-fuse-scale","min":0}]
@switch[{"label":"LoRA Disk Fuse", "arg":"--lora-disk-fuse"}]
@submodelbuilder[{"id":"control-net", "label":"Control Net", "arg":"--control-nets", "model": "Control Net"}]
@submodelbuilder[{"id":"control-lora","label":"Control LoRA","arg":"--control-loras","model":"Control LoRA","exclude":"control-net"}]
@float[{"label":"Control LoRA Fuse Scale","arg":"--control-lora-fuse-scale","min":0}]
@submodelbuilder[{"label":"T2I Adapter", "arg":"--t2i-adapters", "model": "T2I Adapter"}]
@submodelbuilder[{"label":"UNet", "arg":"--unet", "model": "UNet"}]
@submodelbuilder[{"label":"Refiner UNet", "arg":"--second-model-unet", "model": "UNet", "divider-after":true}]
@submodelbuilder[{"label":"IP Adapter", "arg":"--ip-adapters", "model": "IP Adapter"}]
@submodelbuilder[{"label":"Image Encoder", "arg":"--image-encoder", "model": "Image Encoder", "divider-after":true}]
@imageseed[{"label":"Image Seed", "arg":"--image-seeds", "file-types":["images-in", "videos-in"], "float-label":"Image Seed Strength", "float-arg":"--image-seed-strengths", "min":0.01, "max":1, "default":"", "float":""}]
@switch[{"label":"No Aspect Correction?", "arg":"--no-aspect"}]
@imageprocessor[{"arg":"--seed-image-processors", "label":"Seed Image Processor"}]
@imageprocessor[{"arg":"--mask-image-processors", "label":"Inpaint Mask Processor"}]
@imageprocessor[{"arg":"--control-image-processors", "label":"Control Image Processor"}]
@latentsprocessor[{"arg":"--img2img-latents-processors", "label":"Img2Img Latents Processor"}]
@latentsprocessor[{"arg":"--latents-processors", "label":"Raw Latents Processor", "divider-after":true}]
@int[{"id":"is","label":"Inference Steps","arg":"--inference-steps","default":30,"min":1,"exclude":["ts"]}]
@string[{"id":"ts","label":"Timesteps (override)","arg":"--timesteps","default":"","exclude":["is"]}]
@float[{"label":"Guidance Scale", "arg":"--guidance-scales", "default":5, "min":0}]
@float[{"label":"Guidance Rescale", "arg":"--guidance-rescales", "min":0}]
@float[{"label":"PAG Scale", "arg":"--pag-scales", "min":0}]
@float[{"label":"Adaptive PAG Scale", "arg":"--pag-adaptive-scales", "min":0}]
@string[{"label":"PAG Applied Layers", "arg":"--pag-applied-layers"}]
@float[{"label":"T2I Adapter Factor", "arg":"--sdxl-t2i-adapter-factors", "min":0}]
@float[{"label":"SDXL High Noise Fraction", "arg":"--sdxl-high-noise-fractions", "default":0.8, "min":0.001, "max":0.99}]
@float[{"label":"Aesthetic Score", "arg":"--sdxl-aesthetic-scores", "min":0}]
@float[{"label":"Negative Aesthetic Score", "arg":"--sdxl-negative-aesthetic-scores", "min":0}]
@string[{"label":"Crop Coords Top Left", "arg":"--sdxl-crops-coords-top-left"}]
@string[{"label":"Negative Crop Coords Top Left", "arg":"--sdxl-negative-crops-coords-top-left"}]
@string[{"label":"Original Size", "arg":"--sdxl-original-sizes"}]
@string[{"label":"Target Size", "arg":"--sdxl-target-sizes"}]
@string[{"label":"Negative Original Size", "arg":"--sdxl-negative-original-sizes"}]
@string[{"label":"Negative Target Size", "arg":"--sdxl-negative-target-sizes"}]
@int[{"label":"Refiner Inference Steps", "arg":"--second-model-inference-steps", "default":50, "min":1}]
@float[{"label":"Refiner Guidance Rescale", "arg":"--sdxl-refiner-guidance-rescales", "min":0}]
@float[{"label":"Refiner Aesthetic Score", "arg":"--sdxl-refiner-aesthetic-scores", "min":0}]
@float[{"label":"Refiner Negative Aesthetic Score", "arg":"--sdxl-refiner-negative-aesthetic-scores", "min":0}]
@string[{"label":"Refiner Crop Coords Top Left", "arg":"--sdxl-refiner-crops-coords-top-left"}]
@string[{"label":"Refiner Negative Crop Coords Top Left", "arg":"--sdxl-refiner-negative-crops-coords-top-left"}]
@string[{"label":"Refiner Original Size", "arg":"--sdxl-refiner-original-sizes"}]
@string[{"label":"Refiner Target Size", "arg":"--sdxl-refiner-target-sizes"}]
@string[{"label":"Refiner Negative Original Size", "arg":"--sdxl-refiner-negative-original-sizes"}]
@string[{"label":"Refiner Negative Target Size", "arg":"--sdxl-refiner-negative-target-sizes"}]
@float[{"label":"Refiner PAG Scale", "arg":"--sdxl-refiner-pag-scales", "min":0}]
@float[{"label":"Refiner Adaptive PAG Scale", "arg":"--sdxl-refiner-pag-adaptive-scales", "min":0}]
@string[{"label":"Refiner PAG Applied Layers", "arg":"--sdxl-refiner-pag-applied-layers"}]
@int[{"label":"Clip Skip", "arg":"--clip-skips", "min":0}]
@seeds[{"label":"Seeds"}]
@int[{"label":"Batch Size", "arg":"--batch-size", "default":"", "min":1}]
@imagesize[{"label":"Batch Grid Size (CxR)", "arg":"--batch-grid-size", "default":"", "divider-after":true}]
@dir[{"label":"Output Directory", "arg":"--output-path", "default":"output"}]
@imageformat[{}]
@switchradio[{"labels":["Output Dgenerate Image Metadata", "Output Automatic1111 Image Metadata"], "args":["--output-metadata", "--output-auto1111-metadata"]}]
@switch[{"label":"Output Configs", "arg":"--output-configs"}]
@imagesize[{"label":"Output Size (WxH)", "arg":"--output-size", "default":"1024x1024", "divider-after":true}]
@promptupscaler[{"label":"Prompt Upscaler", "arg":"--prompt-upscaler"}]
@promptweighter[{"label":"Prompt Weighter", "arg":"--prompt-weighter", "filter":["compel", "sd-embed"]}]
@imageprocessor[{"arg":"--post-processors", "label":"Post Processor"}]
@latentsprocessor[{"arg":"--latents-post-processors", "label":"Latents Post Processor"}]
@device[{}]
--prompts "add your prompt here"
