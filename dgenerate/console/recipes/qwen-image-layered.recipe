title: Qwen-Image Layered

# One image in. Each layer is written as its own file.

@uri[{"label":"Model Path / HF Slug", "dir":true, "default": "Qwen/Qwen-Image-Layered", "optional":false, "file-types":["models"]}]
--model-type qwen-image-layered
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["float16", "bfloat16", "float32"], "default":"bfloat16"}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler", "filter": ["FlowMatchEulerDiscreteScheduler"]}]
@spectrum[{"id": "sp", "divider-after": true}]
@switchfile[{"id": "cd", "label":"Use Cache-DiT", "arg":"--cache-dit", "exclude":["tc", "sada", "sp"], "file-implies-switch":true, "file":{"label":"Cache-DiT YAML Config", "arg":"--cache-dit-config", "mode":"input", "optional":true, "file-types":["yaml"], "divider-after":true}}]
@dype[{"exclude":["cd", "sp"],"divider-after":true}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"], "default":1}]
@switch[{"label":"Torch Compile", "arg":"--torch-compile"}]
@quantizer[{"model-type":"qwen-image-layered"}]
@textencoders[{"model-type":"qwen-image-layered","arg":"--text-encoders", "divider-after":true}]
@imageseed[{"id":"image-seed", "label":"Image Seed", "arg":"--image-seeds", "file-types":["images-in"], "default":"", "float":""}]
@int[{"label":"Layers", "arg":"--qwen-layered-layers", "default":4, "min":1}]
@dropdown[{"label":"Resolution", "arg":"--qwen-layered-resolution", "options":["640", "1024"], "default":"640"}]
@switch[{"label":"English Prompt", "arg":"--qwen-layered-use-en-prompt"}]
@switch[{"label":"CFG Normalize", "arg":"--qwen-layered-cfg-normalize"}]
@int[{"label":"Inference Steps", "arg":"--inference-steps", "default":50, "min":1}]
@float[{"label":"True CFG Scale", "arg":"--guidance-scales", "default":4, "min":0}]
@float[{"label":"Distilled Guidance Scale", "arg":"--qwen-guidance-scale", "min":0}]
@int[{"label":"Max Sequence Length", "arg":"--max-sequence-length", "min":1, "max":1024}]
@switch[{"id":"pipeline-prompt-enhance", "label":"Pipeline Prompt Enhance", "arg":"--pipeline-prompt-enhance", "divider-before":true}]
@stringfile[{"label":"Enhancer System Prompt", "arg":"--pipeline-prompt-enhance", "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@seeds[{"label":"Enhancer Seeds", "optional":true, "default":"", "seeds-arg":"--pipeline-prompt-enhance-seeds", "count-arg":"--pipeline-prompt-enhance-gen-seeds", "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@float[{"label":"Enhancer Temperature", "arg":"--pipeline-prompt-enhance-temperature", "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@float[{"label":"Enhancer Top-P", "arg":"--pipeline-prompt-enhance-top-p", "min":0, "max":1, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@int[{"label":"Enhancer Top-K", "arg":"--pipeline-prompt-enhance-top-k", "min":0, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@float[{"label":"Enhancer Presence Penalty", "arg":"--pipeline-prompt-enhance-presence-penalty", "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@int[{"label":"Enhancer Max New Tokens", "arg":"--pipeline-prompt-enhance-max-new-tokens", "min":1, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@int[{"label":"Enhancer Min New Tokens", "arg":"--pipeline-prompt-enhance-min-new-tokens", "min":0, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@float[{"label":"Enhancer GPU Headroom (GiB)", "arg":"--pipeline-prompt-enhance-gpu-headroom", "min":0, "divider-after":true, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@seeds[{"label":"Seeds"}]
@dir[{"label":"Output Directory", "arg":"--output-path", "default":"output"}]
@imageformat[{}]
@promptupscaler[{"label":"Prompt Upscaler", "arg":"--prompt-upscaler"}]
@imageprocessor[{"arg":"--post-processors", "label":"Post Processor"}]
@device[{}]
--prompts "add your prompt here"
