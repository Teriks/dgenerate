title: Kandinsky 5 Image (GGUF) + Encoders
# Transformer weights are from Teriks/Kandinsky-5.0-T2I-Lite-quants.
# Text encoder fields are filled with a quantized checkpoint. Clear a field to load that encoder from the repository.

@uri[{"label":"Model Path / HF Slug", "dir":true, "default":"kandinskylab/Kandinsky-5.0-T2I-Lite-sft-Diffusers", "optional":false, "file-types":["models"]}]
--model-type kandinsky5-image
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["bfloat16", "float16", "float32"], "default":"bfloat16"}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler", "filter":["FlowMatchEulerDiscreteScheduler"]}]
@spectrum[{"id": "sp", "divider-after": true}]
@switchfile[{"id": "cd", "label":"Use Cache-DiT", "arg":"--cache-dit", "exclude":["sp"], "file-implies-switch":true, "file":{"label":"Cache-DiT YAML Config", "arg":"--cache-dit-config", "mode":"input", "optional":true, "file-types":["yaml"], "divider-after":true}}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"], "default":1}]
@torchcompile[{"model-type":"kandinsky5-image"}]
@quantizer[{"model-type":"kandinsky5-image"}]
@textencoders[{"model-type":"kandinsky5-image", "arg":"--text-encoders", "divider-after":true, "defaults":["Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q4_K_S.gguf", null], "suggestions":[[{"label":"Q4_K_S", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q4_K_S.gguf"}, {"label":"Q2_K", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q2_K.gguf"}, {"label":"Q3_K_S", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q3_K_S.gguf"}, {"label":"Q3_K_M", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q3_K_M.gguf"}, {"label":"Q4_0", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q4_0.gguf"}, {"label":"Q4_1", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q4_1.gguf"}, {"label":"Q4_K_M", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf"}, {"label":"Q5_K_S", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q5_K_S.gguf"}, {"label":"Q5_K_M", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q5_K_M.gguf"}, {"label":"Q6_K", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q6_K.gguf"}, {"label":"Q8_0", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q8_0.gguf"}, {"label":"IQ4_NL", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-IQ4_NL.gguf"}, {"label":"IQ4_XS", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-IQ4_XS.gguf"}, {"label":"Q2_K_L", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q2_K_L.gguf"}], null]}]
@submodelbuilder[{"id":"lora", "label":"LoRA", "arg":"--loras", "model":"LoRA"}]
@float[{"label":"LoRA Fuse Scale","arg":"--lora-fuse-scale","min":0, "enabled-when":{"id":"lora","not-empty":true}}]
@switch[{"label":"LoRA Disk Fuse", "arg":"--lora-disk-fuse", "enabled-when":{"id":"lora","not-empty":true}}]
@submodelbuilder[{"label": "Transformer GGUF", "arg": "--transformer", "model": "Transformer", "default": "https://huggingface.co/Teriks/Kandinsky-5.0-T2I-Lite-quants/blob/main/transformer-Q4_K.gguf", "divider-after": true, "suggestions": [{"label": "Q4_K", "value": "https://huggingface.co/Teriks/Kandinsky-5.0-T2I-Lite-quants/blob/main/transformer-Q4_K.gguf"}, {"label": "Q2_K", "value": "https://huggingface.co/Teriks/Kandinsky-5.0-T2I-Lite-quants/blob/main/transformer-Q2_K.gguf"}, {"label": "Q3_K", "value": "https://huggingface.co/Teriks/Kandinsky-5.0-T2I-Lite-quants/blob/main/transformer-Q3_K.gguf"}, {"label": "Q4_0", "value": "https://huggingface.co/Teriks/Kandinsky-5.0-T2I-Lite-quants/blob/main/transformer-Q4_0.gguf"}, {"label": "Q4_1", "value": "https://huggingface.co/Teriks/Kandinsky-5.0-T2I-Lite-quants/blob/main/transformer-Q4_1.gguf"}, {"label": "Q5_0", "value": "https://huggingface.co/Teriks/Kandinsky-5.0-T2I-Lite-quants/blob/main/transformer-Q5_0.gguf"}, {"label": "Q5_1", "value": "https://huggingface.co/Teriks/Kandinsky-5.0-T2I-Lite-quants/blob/main/transformer-Q5_1.gguf"}, {"label": "Q5_K", "value": "https://huggingface.co/Teriks/Kandinsky-5.0-T2I-Lite-quants/blob/main/transformer-Q5_K.gguf"}, {"label": "Q6_K", "value": "https://huggingface.co/Teriks/Kandinsky-5.0-T2I-Lite-quants/blob/main/transformer-Q6_K.gguf"}, {"label": "Q8_0", "value": "https://huggingface.co/Teriks/Kandinsky-5.0-T2I-Lite-quants/blob/main/transformer-Q8_0.gguf"}, {"label": "IQ4_NL", "value": "https://huggingface.co/Teriks/Kandinsky-5.0-T2I-Lite-quants/blob/main/transformer-IQ4_NL.gguf"}, {"label": "IQ4_XS", "value": "https://huggingface.co/Teriks/Kandinsky-5.0-T2I-Lite-quants/blob/main/transformer-IQ4_XS.gguf"}]}]
@int[{"label":"Inference Steps", "arg":"--inference-steps", "default":50, "min":1}]
@float[{"label":"Guidance Scale", "arg":"--guidance-scales", "default":3.5, "min":0}]
@int[{"label":"Max Sequence Length", "arg":"--max-sequence-length", "default":512, "min":1, "max":1023}]
@switch[{"id":"pipeline-prompt-enhance", "label":"Pipeline Prompt Enhance", "arg":"--pipeline-prompt-enhance", "divider-before":true}]
@stringfile[{"label":"Enhancer System Prompt", "arg":"--pipeline-prompt-enhance", "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@seeds[{"label":"Enhancer Seeds", "optional":true, "default":"", "seeds-arg":"--pipeline-prompt-enhance-seeds", "count-arg":"--pipeline-prompt-enhance-gen-seeds", "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@float[{"label":"Enhancer Temperature", "arg":"--pipeline-prompt-enhance-temperature", "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@float[{"label":"Enhancer Top-P", "arg":"--pipeline-prompt-enhance-top-p", "min":0, "max":1, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@int[{"label":"Enhancer Top-K", "arg":"--pipeline-prompt-enhance-top-k", "min":0, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@float[{"label":"Enhancer Presence Penalty", "arg":"--pipeline-prompt-enhance-presence-penalty", "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@int[{"label":"Enhancer Max New Tokens", "arg":"--pipeline-prompt-enhance-max-new-tokens", "min":1, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@int[{"label":"Enhancer Min New Tokens", "arg":"--pipeline-prompt-enhance-min-new-tokens", "min":0, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@float[{"label":"Enhancer GPU Headroom (GiB)", "arg":"--pipeline-prompt-enhance-gpu-headroom", "min":0, "divider-after":true, "enabled-when":{"id":"pipeline-prompt-enhance","equals":true}}]
@seeds[{"label":"Seeds"}]
@dir[{"label":"Output Directory", "arg":"--output-path", "default":"output"}]
@imageformat[{}]
@imagesize[{"label":"Output Size (WxH)", "arg":"--output-size", "default":"1024x1024"}]
@promptupscaler[{"label":"Prompt Upscaler", "arg":"--prompt-upscaler"}]
@imageprocessor[{"arg":"--post-processors", "label":"Post Processor"}]
@device[{}]
--prompts "add your prompt here"
