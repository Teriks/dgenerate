title: Motif-Video Text to Video (GGUF)

@uri[{"label":"Model Path / HF Slug", "dir":true, "default":"Motif-Technologies/Motif-Video-2B", "optional":false, "file-types":["models"]}]
--model-type motif-video
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["bfloat16", "float16", "float32"], "default":"bfloat16"}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler"}]
@spectrum[{"id": "sp", "divider-after": true}]
@dype[{"exclude":["sp"], "divider-after":true}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"], "default":1}]
@torchcompile[{"model-type":"motif-video"}]
@quantizer[{"model-type":"motif-video", "map-default":"text_encoder"}]
@textencoders[{"model-type":"motif-video","arg":"--text-encoders", "divider-after":true}]
@switch[{"label":"VAE Slicing", "arg":"--vae-slicing"}]
@submodelbuilder[{"id":"lora", "label":"LoRA", "arg":"--loras", "model":"LoRA"}]
@float[{"label":"LoRA Fuse Scale","arg":"--lora-fuse-scale","min":0, "enabled-when":{"id":"lora","not-empty":true}}]
@switch[{"label":"LoRA Disk Fuse", "arg":"--lora-disk-fuse", "enabled-when":{"id":"lora","not-empty":true}}]
@submodelbuilder[{"label":"Transformer", "arg":"--transformer", "model":"Transformer", "default":"https://huggingface.co/Motif-Technologies/Motif-Video-2B-GGUF/blob/main/motifv-2b-dev-Q4_K_M.gguf", "divider-after":true, "suggestions":[{"label":"Q4_K_M", "value":"https://huggingface.co/Motif-Technologies/Motif-Video-2B-GGUF/blob/main/motifv-2b-dev-Q4_K_M.gguf"}, {"label":"Q4_0", "value":"https://huggingface.co/Motif-Technologies/Motif-Video-2B-GGUF/blob/main/motifv-2b-dev-Q4_0.gguf"}, {"label":"Q4_1", "value":"https://huggingface.co/Motif-Technologies/Motif-Video-2B-GGUF/blob/main/motifv-2b-dev-Q4_1.gguf"}, {"label":"Q5_0", "value":"https://huggingface.co/Motif-Technologies/Motif-Video-2B-GGUF/blob/main/motifv-2b-dev-Q5_0.gguf"}, {"label":"Q5_1", "value":"https://huggingface.co/Motif-Technologies/Motif-Video-2B-GGUF/blob/main/motifv-2b-dev-Q5_1.gguf"}, {"label":"Q5_K_M", "value":"https://huggingface.co/Motif-Technologies/Motif-Video-2B-GGUF/blob/main/motifv-2b-dev-Q5_K_M.gguf"}, {"label":"Q6_K", "value":"https://huggingface.co/Motif-Technologies/Motif-Video-2B-GGUF/blob/main/motifv-2b-dev-Q6_K.gguf"}, {"label":"Q8_0", "value":"https://huggingface.co/Motif-Technologies/Motif-Video-2B-GGUF/blob/main/motifv-2b-dev-Q8_0.gguf"}]}]
@int[{"id":"is","label":"Inference Steps","arg":"--inference-steps","default":50,"min":1,"exclude":["ts"]}]
@sigmas[{"id":"sigmas","label":"Sigmas","arg":"--sigmas","base":[1.0,0.979612,0.959224,0.938837,0.918449,0.898061,0.877673,0.857286,0.836898,0.81651,0.796122,0.775735,0.755347,0.734959,0.714571,0.694184,0.673796,0.653408,0.63302,0.612633,0.592245,0.571857,0.551469,0.531082,0.510694,0.490306,0.469918,0.449531,0.429143,0.408755,0.388367,0.36798,0.347592,0.327204,0.306816,0.286429,0.266041,0.245653,0.225265,0.204878,0.18449,0.164102,0.143714,0.123327,0.102939,0.082551,0.062163,0.041776,0.021388,0.001],"exclude":["ts"]}]
@timesteps[{"id":"ts","label":"Timesteps (override)","arg":"--timesteps","default":"","exclude":["is","sigmas"]}]
@float[{"label":"Guidance Scale", "arg":"--guidance-scales", "default":5, "min":0, "divider-after":true}]
@float[{"label":"Video Length (seconds)", "arg":"--video-lengths", "default":5, "min":0.1}]
@float[{"label":"Video FPS", "arg":"--video-fps", "default":24, "min":1}]
@dropdown[{"label":"Animation Format", "arg":"--animation-format", "options":["mp4", "gif", "webp", "apng", "frames"], "default":"mp4", "optional":false}]
@seeds[{"label":"Seeds"}]
@dir[{"label":"Output Directory", "arg":"--output-path", "default":"output"}]
@switch[{"label":"Output Configs", "arg":"--output-configs"}]
@imagesize[{"label":"Output Size (WxH)", "arg":"--output-size", "default":"832x480"}]
@promptupscaler[{"label":"Prompt Upscaler", "arg":"--prompt-upscaler"}]
@imageprocessor[{"arg":"--post-processors", "label":"Post Processor"}]
@device[{}]
--prompts "add your prompt here"
