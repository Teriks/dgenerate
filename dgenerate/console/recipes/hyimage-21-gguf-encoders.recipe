title: HunyuanImage 2.1 (GGUF + Encoders)

# GGUF diffusion transformer (calcuis/hunyuanimage-gguf or similar). Match the base / distilled / refiner Diffusers slug.

@uri[{"label":"Model Path / HF Slug", "dir":true, "default":"hunyuanvideo-community/HunyuanImage-2.1-Diffusers", "optional":false, "file-types":["models"]}]
--model-type hyimage-21
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["bfloat16", "float16", "float32"], "default":"bfloat16"}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler"}]
@spectrum[{"id": "sp", "divider-after": true}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"], "default":1}]
@torchcompile[{"model-type":"hyimage-21"}]
@quantizer[{"model-type":"hyimage-21"}]
@textencoders[{"model-type":"hyimage-21", "arg":"--text-encoders", "divider-after":true, "defaults":["Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q4_K_S.gguf", "T5EncoderModel;model=https://huggingface.co/Comfy-Org/Hunyuan-Image-2.1/blob/main/split_files/text_encoders/byt5_small_glyphxl_fp16.safetensors"], "suggestions":[[{"label":"Q4_K_S", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q4_K_S.gguf"}, {"label":"Q2_K", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q2_K.gguf"}, {"label":"Q3_K_S", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q3_K_S.gguf"}, {"label":"Q3_K_M", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q3_K_M.gguf"}, {"label":"Q4_0", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q4_0.gguf"}, {"label":"Q4_1", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q4_1.gguf"}, {"label":"Q4_K_M", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf"}, {"label":"Q5_K_S", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q5_K_S.gguf"}, {"label":"Q5_K_M", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q5_K_M.gguf"}, {"label":"Q6_K", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q6_K.gguf"}, {"label":"Q8_0", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q8_0.gguf"}, {"label":"IQ4_NL", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-IQ4_NL.gguf"}, {"label":"IQ4_XS", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-IQ4_XS.gguf"}, {"label":"Q2_K_L", "value":"Qwen2_5_VLForConditionalGeneration;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q2_K_L.gguf"}], null]}]
@submodelbuilder[{"label":"Transformer", "arg":"--transformer", "model":"Transformer", "default":"https://huggingface.co/calcuis/hunyuanimage-gguf/blob/main/hunyuanimage2.1-q4_k_m.gguf", "divider-after":true, "suggestions":[{"label":"q4_k_m", "value":"https://huggingface.co/calcuis/hunyuanimage-gguf/blob/main/hunyuanimage2.1-q4_k_m.gguf"}, {"label":"q2_k", "value":"https://huggingface.co/calcuis/hunyuanimage-gguf/blob/main/hunyuanimage2.1-q2_k.gguf"}, {"label":"q3_k_s", "value":"https://huggingface.co/calcuis/hunyuanimage-gguf/blob/main/hunyuanimage2.1-q3_k_s.gguf"}, {"label":"q3_k_m", "value":"https://huggingface.co/calcuis/hunyuanimage-gguf/blob/main/hunyuanimage2.1-q3_k_m.gguf"}, {"label":"q4_0", "value":"https://huggingface.co/calcuis/hunyuanimage-gguf/blob/main/hunyuanimage2.1-q4_0.gguf"}, {"label":"q4_1", "value":"https://huggingface.co/calcuis/hunyuanimage-gguf/blob/main/hunyuanimage2.1-q4_1.gguf"}, {"label":"q4_k_s", "value":"https://huggingface.co/calcuis/hunyuanimage-gguf/blob/main/hunyuanimage2.1-q4_k_s.gguf"}, {"label":"q5_0", "value":"https://huggingface.co/calcuis/hunyuanimage-gguf/blob/main/hunyuanimage2.1-q5_0.gguf"}, {"label":"q5_1", "value":"https://huggingface.co/calcuis/hunyuanimage-gguf/blob/main/hunyuanimage2.1-q5_1.gguf"}, {"label":"q5_k_s", "value":"https://huggingface.co/calcuis/hunyuanimage-gguf/blob/main/hunyuanimage2.1-q5_k_s.gguf"}, {"label":"q5_k_m", "value":"https://huggingface.co/calcuis/hunyuanimage-gguf/blob/main/hunyuanimage2.1-q5_k_m.gguf"}, {"label":"q6_k", "value":"https://huggingface.co/calcuis/hunyuanimage-gguf/blob/main/hunyuanimage2.1-q6_k.gguf"}, {"label":"q8_0", "value":"https://huggingface.co/calcuis/hunyuanimage-gguf/blob/main/hunyuanimage2.1-q8_0.gguf"}, {"label":"iq4_nl", "value":"https://huggingface.co/calcuis/hunyuanimage-gguf/blob/main/hunyuanimage2.1-iq4_nl.gguf"}, {"label":"iq4_xs", "value":"https://huggingface.co/calcuis/hunyuanimage-gguf/blob/main/hunyuanimage2.1-iq4_xs.gguf"}, {"label":"q2_k_s", "value":"https: