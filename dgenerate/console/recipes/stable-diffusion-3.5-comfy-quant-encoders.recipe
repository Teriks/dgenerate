title: Stable Diffusion 3.5 (ComfyUI Quant + Encoders)

# ComfyUI quantizes SD3.5 Large. The parent repo supplies the VAE.

# Stable Diffusion 3 requires a huggingface auth token to access
# you must request access to the repository

\setp auth_token "@string[{"label": "Hugging Face Auth Token", "default":"$HF_TOKEN", "optional":false}]"

\set auth_token {{ '--auth-token ' + quote(auth_token) if auth_token else '' }}

@uri[{"label":"Model Path / HF Slug", "dir":true, "default": "stabilityai/stable-diffusion-3.5-large", "optional":false, "file-types":["models"]}]
--model-type sd3 {{ auth_token }}
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["float16", "bfloat16", "float32"], "default":"float16"}]
@dropdown[{"label":"Model variant", "arg":"--variant", "options":["fp16", "bf16"], "optional":true}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler"}]
@ras[{"id": "ras", "divider-after": true}]
@spectrum[{"id": "sp", "exclude": ["ras"], "divider-after": true}]
@switchfile[{"id": "cd", "label":"Use Cache-DiT", "arg":"--cache-dit", "exclude":["tc", "sada", "sp", "ras"], "file-implies-switch":true, "file":{"label":"Cache-DiT YAML Config", "arg":"--cache-dit-config", "mode":"input", "optional":true, "file-types":["yaml"], "divider-after":true}}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"], "default":0}]
@torchcompile[{"model-type":"sd3"}]
@quantizer[{"model-type":"sd3", "map-default":"text_encoder_3"}]
@textencoders[{"model-type":"sd3", "arg":"--text-encoders", "divider-after":true, "defaults":[null, null, "T5EncoderModel;model=https://huggingface.co/Comfy-Org/stable-diffusion-3.5-fp8/blob/main/text_encoders/t5xxl_fp8_e4m3fn_scaled.safetensors"], "suggestions":[null, null, [{"label":"fp8_e4m3fn_scaled", "value":"T5EncoderModel;model=https://huggingface.co/Comfy-Org/stable-diffusion-3.5-fp8/blob/main/text_encoders/t5xxl_fp8_e4m3fn_scaled.safetensors"}, {"label":"fp8_e4m3fn", "value":"T5EncoderModel;model=https://huggingface.co/Comfy-Org/stable-diffusion-3.5-fp8/blob/main/text_encoders/t5xxl_fp8_e4m3fn.safetensors"}]]}]
@submodelbuilder[{"label":"VAE", "arg":"--vae", "model": "VAE"}]
@switch[{"label":"VAE Slicing", "arg":"--vae-slicing", "divider-after":true}]
@submodelbuilder[{"id":"lora", "label":"LoRA", "arg":"--loras", "model": "LoRA"}]
@float[{"label":"LoRA Fuse Scale","arg":"--lora-fuse-scale","min":0, "enabled-when":{"id":"lora","not-empty":true}}]
@switch[{"label":"LoRA Disk Fuse", "arg":"--lora-disk-fuse", "enabled-when":{"id":"lora","not-empty":true}}]
@submodelbuilder[{"label":"Control Net", "arg":"--control-nets", "model": "Control Net"}]
@submodelbuilder[{"label":"Transformer", "arg":"--transformer", "model": "Transformer", "default":"https://huggingface.co/Comfy-Org/stable-diffusion-3.5-fp8/blob/main/sd3.5_large_fp8_scaled.safetensors", "divider-after":true}]
@submodelbuilder[{"id":"ip-adapter", "label":"IP Adapter", "arg":"--ip-adapters", "model": "IP Adapter"}]
@submodelbuilder[{"label":"Image Encoder", "arg":"--image-encoder", "model": "Image Encoder", "divider-after":true, "enabled-when":{"id":"ip-adapter","not-empty":true}}]
@imageseed[{"id":"image-seed", "label":"Image Seed", "arg":"--image-seeds", "file-types":["images-in", "videos-in"], "float-label":"Image Seed Strength", "float-arg":"--image-seed-strengths", "min":0.01, "max":1, "default":"", "float":""}]
@switch[{"label":"No Aspect Correction?", "arg":"--no-aspect", "enabled-when":{"id":"image-seed","not-empty":true}}]
@imageprocessor[{"arg":"--seed-image-processors", "label":"Seed Image Processor", "enabled-when":{"id":"image-seed","not-empty":true}}]
@imageprocessor[{"arg":"--mask-image-processors", "label":"Inpaint Mask Processor", "enabled-when":{"id":"image-seed","not-empty":true}}]
@imageprocessor[{"arg":"--control-image-processors", "label":"Control Image Processor", "enabled-when":{"id":"image-seed","not-empty":true}}]
@latentsprocessor[{"arg":"--img2img-latents-processors", "label":"Img2Img Latents Processor", "enabled-when":{"id":"image-seed","not-empty":true}}]
@latentsprocessor[{"arg":"--latents-processors", "label":"Raw Latents Processor", "divider-after":true, "enabled-when":{"id":"image-seed","not-empty":true}}]
@int[{"label":"Inference Steps","arg":"--inference-steps","default":28,"min":1,"id":"is","exclude":["ts"]}]
@sigmas[{"id":"sigmas","label":"Sigmas","arg":"--sigmas","base":[1.0,0.963,0.926,0.889,0.852,0.815,0.778,0.741,0.704,0.667,0.63,0.593,0.556,0.519,0.482,0.445,0.408,0.371,0.334,0.297,0.26,0.223,0.186,0.149,0.112,0.075,0.038,0.001],"exclude":["ts"]}]
@timesteps[{"id":"ts","label":"Timesteps (override)","arg":"--timesteps","default":"","exclude":["is","sigmas"]}]
@float[{"label":"Guidance Scale", "arg":"--guidance-scales", "default":5, "min":0}]
@float[{"label":"Guidance Rescale", "arg":"--guidance-rescales", "min":0}]
@float[{"label":"PAG Scale", "arg":"--pag-scales", "min":0}]
@float[{"label":"Adaptive PAG Scale", "arg":"--pag-adaptive-scales", "min":0}]
@string[{"label":"PAG Applied Layers", "arg":"--pag-applied-layers"}]
@int[{"label":"Clip Skip", "arg":"--clip-skips", "min":0}]
@int[{"label":"Max Sequence Length", "arg":"--max-sequence-length", "min":1, "max":512}]
@seeds[{"label":"Seeds"}]
@int[{"label":"Batch Size", "arg":"--batch-size", "default":"", "min":1}]
@imagesize[{"label":"Batch Grid Size (CxR)", "arg":"--batch-grid-size", "default":"", "divider-after":true}]
@dir[{"label":"Output Directory", "arg":"--output-path", "default":"output"}]
@imageformat[{}]
@switchradio[{"labels":["Output Dgenerate Image Metadata", "Output Automatic1111 Image Metadata"], "args":["--output-metadata", "--output-auto1111-metadata"]}]
@switch[{"label":"Output Configs", "arg":"--output-configs"}]
@imagesize[{"label":"Output Size (WxH)", "arg":"--output-size", "default":"1024x1024", "divider-after":true}]
@promptupscaler[{"label":"Prompt Upscaler", "arg":"--prompt-upscaler"}]
@promptweighter[{"label":"Prompt Weighter", "arg":"--prompt-weighter", "filter":["sd-embed"]}]
@imageprocessor[{"arg":"--post-processors", "label":"Post Processor"}]
@latentsprocessor[{"arg":"--latents-post-processors", "label":"Latents Post Processor"}]
@device[{}]
--prompts "add your prompt here"
