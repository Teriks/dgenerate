title: Krea 2 Raw (ComfyUI Quant)

# The transformer is a ComfyUI quantized safetensors file (FP8, INT8 ConvRot, or
# NVFP4). Quantized layers stay packed and use hardware matmuls where available.

# Choose the Raw base checkpoint and a ComfyUI quantized transformer with matching weights.

@uri[{"label":"Model Path / HF Slug", "dir":true, "default":"krea/Krea-2-Raw", "optional":false, "file-types":["models"]}]
--model-type krea2
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["bfloat16", "float16", "float32"], "default":"bfloat16"}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler", "filter":["FlowMatchEulerDiscreteScheduler"]}]
@switch[{"id":"sp", "label":"Use Spectrum", "arg":"--spectrum"}]
@dype[{"exclude":["sp"], "divider-after":true}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"], "default":1}]
@switch[{"label":"Torch Compile", "arg":"--torch-compile"}]
@quantizer[{"model-type":"krea2", "divider-after":true, "map-default":"text_encoder"}]
@submodelbuilder[{"label":"LoRA", "arg":"--loras", "model":"LoRA"}]
@float[{"label":"LoRA Fuse Scale","arg":"--lora-fuse-scale","min":0}]
@submodelbuilder[{"label":"Transformer", "arg":"--transformer", "model":"Transformer", "default":"https://huggingface.co/Comfy-Org/Krea-2/blob/main/diffusion_models/krea2_raw_int8_convrot.safetensors", "divider-after":true}]
@int[{"label":"Inference Steps", "arg":"--inference-steps", "default":28, "min":1}]
@float[{"label":"Guidance Scale", "arg":"--guidance-scales", "default":4.5, "min":0}]
@seeds[{"label":"Seeds"}]
@dir[{"label":"Output Directory", "arg":"--output-path", "default":"output"}]
@imageformat[{}]
@imagesize[{"label":"Output Size (WxH)", "arg":"--output-size", "default":"1024x1024"}]
@device[{}]
--prompts "add your prompt here"
