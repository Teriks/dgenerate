title: MiniMax-H3-Image

# One still image. Guidance is distilled. The checkpoint samples 6 steps.
# Reference images are optional. The prompt names them Picture 1, Picture 2, and so on.

@uri[{"label":"Model Path / HF Slug", "dir":true, "default":"MiniMaxAI/MiniMax-H3-Image", "optional":false, "file-types":["models"]}]
--model-type minimax-h3-image
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["bfloat16", "float16", "float32"], "default":"bfloat16"}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler", "filter":["MiniMaxH3Scheduler"]}]
@switchfile[{"id": "cd", "label":"Use Cache-DiT", "arg":"--cache-dit", "file-implies-switch":true, "file":{"label":"Cache-DiT YAML Config", "arg":"--cache-dit-config", "mode":"input", "optional":true, "file-types":["yaml"], "divider-after":true}}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"], "default":1}]
@torchcompile[{"model-type":"minimax-h3-image"}]
@quantizer[{"model-type":"minimax-h3-image"}]
@textencoders[{"model-type":"minimax-h3-image","arg":"--text-encoders", "divider-after":true}]
@submodelbuilder[{"label":"Transformer", "arg":"--transformer", "model":"Transformer", "divider-after":true}]
@imageseed[{"id":"image-seed", "label":"Reference Images", "arg":"--image-seeds", "file-types":["images-in"], "default":"", "hide-float":true}]
@seeds[{"label":"Seeds"}]
@dir[{"label":"Output Directory", "arg":"--output-path", "default":"output"}]
@switch[{"label":"Output Configs", "arg":"--output-configs"}]
@imageformat[{}]
@imagesize[{"label":"Output Size (WxH)", "arg":"--output-size", "default":"2048x2048"}]
@promptupscaler[{"label":"Prompt Upscaler", "arg":"--prompt-upscaler"}]
@imageprocessor[{"arg":"--post-processors", "label":"Post Processor"}]
@device[{}]
--prompts "add your prompt here"
