title: Wan-Animate
order: 43

# Wan-Animate character animation. The seed is the character still.
# wan-pose= and wan-face= are required, or wan-driving= with --wan-animate-preprocess.
# replace mode also needs wan-background= and mask=. Output length follows
# the pose clip. --video-lengths is rejected.

\setp auth_token "@string[{"label": "Hugging Face Auth Token", "default":"$HF_TOKEN", "optional":false}]"

\set auth_token {{ '--auth-token ' + quote(auth_token) if auth_token else '' }}

\setp character "@file[{"label":"Character Image", "optional":false, "mode":"input", "file-types":["images-in"]}]"
\setp pose_clip "@file[{"label":"Pose Clip", "optional":true, "mode":"input", "file-types":["videos-in"]}]"
\setp face_clip "@file[{"label":"Face Clip", "optional":true, "mode":"input", "file-types":["videos-in"]}]"
\setp driving_clip "@file[{"label":"Driving Clip", "optional":true, "mode":"input", "file-types":["videos-in"]}]"
\setp background_clip "@file[{"label":"Background Clip (replace)", "optional":true, "mode":"input", "file-types":["videos-in"]}]"
\setp mask_clip "@file[{"label":"Mask Clip (replace)", "optional":true, "mode":"input", "file-types":["videos-in"], "divider-after":true}]"

\set image_seeds {{ format_image_seed(seed_images=character, wan_pose_video=pose_clip, wan_face_video=face_clip, wan_driving_video=driving_clip, wan_background_video=background_clip, mask_images=mask_clip) }}
\set image_seeds {{ '--image-seeds ' + quote(image_seeds) if image_seeds else '' }}

@uri[{"label":"Model Path / HF Slug", "dir":true, "default": "Wan-AI/Wan2.2-Animate-14B-Diffusers", "optional":false, "file-types":["models"]}]
--model-type wan-animate {{ image_seeds }} {{ auth_token }}
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["float16", "bfloat16", "float32"], "default":"bfloat16"}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler", "filter": ["UniPCMultistepScheduler"]}]
@switch[{"id": "sp", "label":"Use Spectrum", "arg":"--spectrum"}]
@switchfile[{"id": "cd", "label":"Use Cache-DiT", "arg":"--cache-dit", "exclude":["tc", "sada", "sp"], "file-implies-switch":true, "file":{"label":"Cache-DiT YAML Config", "arg":"--cache-dit-config", "mode":"input", "optional":true, "file-types":["yaml"], "divider-after":true}}]
@dype[{"exclude":["cd", "sp"],"divider-after":true}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"], "default":1}]
@switch[{"label":"Torch Compile", "arg":"--torch-compile"}]
@switch[{"label":"VAE Slicing", "arg":"--vae-slicing"}]
@quantizer[{"divider-after":true}]
@dropdown[{"label":"Animate Mode", "arg":"--wan-animate-mode", "options":["animate", "replace"], "default":"animate"}]
@switch[{"label":"Preprocess wan-driving=", "arg":"--wan-animate-preprocess"}]
@int[{"label":"Segment Frame Length", "arg":"--wan-segment-frame-lengths", "default":77, "min":1}]
@int[{"label":"Previous Segment Frames", "arg":"--wan-prev-segment-frames", "default":1, "min":1}]
@int[{"label":"Motion Encode Batch Size", "arg":"--wan-motion-encode-batch-size", "min":1}]
@switch[{"label":"Save Preprocess Clips", "arg":"--wan-animate-preprocess-output", "divider-after":true}]
@int[{"label":"Inference Steps", "arg":"--inference-steps", "default":20, "min":1}]
@float[{"label":"Guidance Scale", "arg":"--guidance-scales", "default":1, "min":0}]
@float[{"label":"Video FPS", "arg":"--video-fps", "default":"30", "min":1, "divider-after":true}]
@dropdown[{"label":"Animation Format", "arg":"--animation-format", "options":["mp4", "gif", "webp", "apng", "frames"], "default":"mp4", "optional":false}]
@seeds[{"label":"Seeds"}]
@dir[{"label":"Output Directory", "arg":"--output-path", "default":"output"}]
@switchradio[{"labels":["Output Dgenerate Image Metadata", "Output Automatic1111 Image Metadata"], "args":["--output-metadata", "--output-auto1111-metadata"]}]
@switch[{"label":"Output Configs", "arg":"--output-configs"}]
@imagesize[{"label":"Output Size (WxH)", "arg":"--output-size", "default":"832x480", "divider-after":true}]
@promptupscaler[{"label":"Prompt Upscaler", "arg":"--prompt-upscaler"}]
@imageprocessor[{"arg":"--wan-pose-image-processors", "label":"Pose Clip Processor"}]
@imageprocessor[{"arg":"--wan-face-image-processors", "label":"Face Clip Processor"}]
@imageprocessor[{"arg":"--wan-driving-image-processors", "label":"Driving Clip Processor"}]
@imageprocessor[{"arg":"--wan-background-image-processors", "label":"Background Clip Processor"}]
@imageprocessor[{"arg":"--post-processors", "label":"Post Processor"}]
@device[{}]
--prompts "add your prompt here"
