title: LTX-Video
order: 19

# Earlier LTX-Video (2B) with the published transformer. No audio.
# First frame and last frame (end=) are optional, each can be a still or a
# video. A video first frame is an opening clip the output continues from,
# a video last frame is a closing clip the output leads into.
# --scheduler accepts FlowMatchEulerDiscreteScheduler and its URI arguments.

\setp auth_token "@string[{"label": "Hugging Face Auth Token", "default":"$HF_TOKEN", "optional":false}]"

\set auth_token {{ '--auth-token ' + quote(auth_token) if auth_token else '' }}

\setp first_frame "@file[{"label":"First Frame / Opening Clip", "optional":true, "mode":"input", "file-types":["images-in", "videos-in"]}]"
\setp last_frame "@file[{"label":"Last Frame / Closing Clip", "optional":true, "mode":"input", "file-types":["images-in", "videos-in"], "divider-after":true}]"

\set image_seeds {{ (first_frame + ((';end=' + last_frame) if last_frame else '')) if (first_frame or last_frame) else '' }}

\setp first_processor "@imageprocessor[{"label":"First Frame Processor"}]"
\setp last_processor "@imageprocessor[{"label":"Last Frame Processor"}]"

\set seed_processors {{ (quote(first_processor) + ((' + ' + quote(last_processor)) if last_processor else (' +' if last_frame else ''))) if first_processor else (('+ ' + quote(last_processor)) if last_processor else '') }}

@uri[{"label":"Model Path / HF Slug", "dir":true, "default": "Lightricks/LTX-Video", "optional":false, "file-types":["models"]}]
--model-type ltx {{ auth_token }}
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["float16", "bfloat16", "float32"], "default":"bfloat16"}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler", "filter": ["FlowMatchEulerDiscreteScheduler"]}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload"], "args":["--model-cpu-offload", "--model-sequential-offload"], "default":1}]
@quantizer[{"divider-after":true}]
@submodelbuilder[{"label":"LoRA", "arg":"--loras", "model": "LoRA", "divider-after":true}]
@switch[{"label":"No Aspect Correction?", "arg":"--no-aspect", "divider-after":true}]
@int[{"label":"Inference Steps", "arg":"--inference-steps", "default":50, "min":1}]
@float[{"label":"Guidance Scale", "arg":"--guidance-scales", "default":3, "min":0}]
@float[{"label":"Video Length (seconds)", "arg":"--video-lengths", "default":"4.84", "min":0.1}]
@float[{"label":"Video FPS", "arg":"--video-fps", "default":"25", "min":1}]
@dropdown[{"label":"Animation Format", "arg":"--animation-format", "options":["mp4", "gif", "webp", "apng", "frames"], "default":"mp4", "optional":false}]
@seeds[{"label":"Seeds"}]
@dir[{"label":"Output Directory", "arg":"--output-path", "default":"output"}]
@switchradio[{"labels":["Output Dgenerate Image Metadata", "Output Automatic1111 Image Metadata"], "args":["--output-metadata", "--output-auto1111-metadata"]}]
@switch[{"label":"Output Configs", "arg":"--output-configs"}]
@imagesize[{"label":"Output Size (WxH)", "arg":"--output-size", "default":"768x512", "divider-after":true}]
@promptupscaler[{"label":"Prompt Upscaler", "arg":"--prompt-upscaler"}]
@imageprocessor[{"arg":"--post-processors", "label":"Post Processor"}]
@device[{}]
--prompts "add your prompt here; worst quality, inconsistent motion, blurry, jittery, distorted" {{ '--image-seeds ' + quote(image_seeds) if image_seeds else '' }} {{ '--seed-image-processors ' + seed_processors if seed_processors else '' }}
