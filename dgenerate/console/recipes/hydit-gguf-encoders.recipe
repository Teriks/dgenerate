title: Hunyuan-DiT (GGUF + Encoders)
# Transformer GGUF with the BERT safetensors quant and the mT5 GGUF.

# Hunyuan-DiT 1.x text-to-image with optional LoRA, ControlNet, and IP-Adapter.

@uri[{"label":"Model Path / HF Slug", "dir":true, "default":"Tencent-Hunyuan/HunyuanDiT-v1.2-Diffusers", "optional":false, "file-types":["models"]}]
--model-type hydit
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["float16", "bfloat16", "float32"], "default":"float16"}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler"}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"], "default":1}]
@torchcompile[{"model-type":"hydit"}]
@quantizer[{"model-type":"hydit"}]
@textencoders[{"model-type":"hydit", "arg":"--text-encoders", "divider-after":true, "defaults":["BertModel;model=https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/text_encoder-int8_tensorwise.safetensors", "T5EncoderModel;model=https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/text_encoder_2-Q4_K-comfy.gguf"], "suggestions":[[{"label":"int8_tensorwise", "value":"BertModel;model=https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/text_encoder-int8_tensorwise.safetensors"}, {"label":"float8_e4m3fn", "value":"BertModel;model=https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/text_encoder-float8_e4m3fn.safetensors"}], [{"label":"Q4_K", "value":"T5EncoderModel;model=https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/text_encoder_2-Q4_K-comfy.gguf"}, {"label":"Q2_K", "value":"T5EncoderModel;model=https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/text_encoder_2-Q2_K-comfy.gguf"}, {"label":"Q3_K", "value":"T5EncoderModel;model=https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/text_encoder_2-Q3_K-comfy.gguf"}, {"label":"Q4_0", "value":"T5EncoderModel;model=https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/text_encoder_2-Q4_0-comfy.gguf"}, {"label":"Q4_1", "value":"T5EncoderModel;model=https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/text_encoder_2-Q4_1-comfy.gguf"}, {"label":"Q5_0", "value":"T5EncoderModel;model=https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/text_encoder_2-Q5_0-comfy.gguf"}, {"label":"Q5_1", "value":"T5EncoderModel;model=https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/text_encoder_2-Q5_1-comfy.gguf"}, {"label":"Q5_K", "value":"T5EncoderModel;model=https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/text_encoder_2-Q5_K-comfy.gguf"}, {"label":"Q6_K", "value":"T5EncoderModel;model=https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/text_encoder_2-Q6_K-comfy.gguf"}, {"label":"Q8_0", "value":"T5EncoderModel;model=https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/text_encoder_2-Q8_0-comfy.gguf"}, {"label":"IQ4_NL", "value":"T5EncoderModel;model=https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/text_encoder_2-IQ4_NL-comfy.gguf"}, {"label":"IQ4_XS", "value":"T5EncoderModel;model=https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/text_encoder_2-IQ4_XS-comfy.gguf"}]]}]
@submodelbuilder[{"id":"lora", "label":"LoRA", "arg":"--loras", "model":"LoRA"}]
@float[{"label":"LoRA Fuse Scale","arg":"--lora-fuse-scale","min":0, "enabled-when":{"id":"lora","not-empty":true}}]
@switch[{"label":"LoRA Disk Fuse", "arg":"--lora-disk-fuse", "enabled-when":{"id":"lora","not-empty":true}}]
@submodelbuilder[{"label":"Control Net", "arg":"--control-nets", "model":"Control Net"}]
@submodelbuilder[{"id":"ip-adapter", "label":"IP Adapter", "arg":"--ip-adapters", "model":"IP Adapter"}]
@submodelbuilder[{"label":"Image Encoder", "arg":"--image-encoder", "model":"Image Encoder", "enabled-when":{"id":"ip-adapter","not-empty":true}}]
@submodelbuilder[{"label":"Transformer", "arg":"--transformer", "model":"Transformer", "default":"https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/transformer-Q4_K.gguf", "divider-after":true, "suggestions":[{"label":"Q4_K", "value":"https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/transformer-Q4_K.gguf"}, {"label":"Q2_K", "value":"https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/transformer-Q2_K.gguf"}, {"label":"Q3_K", "value":"https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/transformer-Q3_K.gguf"}, {"label":"Q4_0", "value":"https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/transformer-Q4_0.gguf"}, {"label":"Q4_1", "value":"https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/transformer-Q4_1.gguf"}, {"label":"Q5_0", "value":"https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/transformer-Q5_0.gguf"}, {"label":"Q5_1", "value":"https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/transformer-Q5_1.gguf"}, {"label":"Q5_K", "value":"https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/transformer-Q5_K.gguf"}, {"label":"Q6_K", "value":"https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/transformer-Q6_K.gguf"}, {"label":"Q8_0", "value":"https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/transformer-Q8_0.gguf"}, {"label":"IQ4_NL", "value":"https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/transformer-IQ4_NL.gguf"}, {"label":"IQ4_XS", "value":"https://huggingface.co/Teriks/HunyuanDiT-v1.2-quants/blob/main/transformer-IQ4_XS.gguf"}]}]
@imageseed[{"id":"image-seed", "label":"Control / IP Adapter Image", "arg":"--image-seeds", "file-types":["images-in"], "default":"", "hide-float":true}]
@imageprocessor[{"arg":"--control-image-processors", "label":"Control Image Processor", "enabled-when":{"id":"image-seed","not-empty":true}}]
@imageprocessor[{"arg":"--seed-image-processors", "label":"Seed Image Processor", "divider-after":true, "enabled-when":{"id":"image-seed","not-empty":true}}]
@int[{"label":"Inference Steps", "arg":"--inference-steps", "default":50, "min":1}]
@float[{"label":"Guidance Scale", "arg":"--guidance-scales", "default":5, "min":0}]
@seeds[{"label":"Seeds"}]
@dir[{"label":"Output Directory", "arg":"--output-path", "default":"output"}]
@imageformat[{}]
@imagesize[{"label":"Output Size (WxH)", "arg":"--output-size", "default":"1024x1024"}]
@promptupscaler[{"label":"Prompt Upscaler", "arg":"--prompt-upscaler"}]
@imageprocessor[{"arg":"--post-processors", "label":"Post Processor"}]
@device[{}]
--prompts "add your prompt here"
