title: HunyuanVideo 1.5 Image to Video (GGUF + Encoders)

@uri[{"label":"Model Path / HF Slug", "dir":true, "default":"hunyuanvideo-community/HunyuanVideo-1.5-Diffusers-480p_i2v", "optional":false, "file-types":["models"]}]
--model-type hyvideo-15
@file[{"id":"image-seed", "label":"First Frame", "arg":"--image-seeds", "optional":false, "mode":"input", "file-types":["images-in"]}]
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["bfloat16", "float16", "float32"], "default":"bfloat16"}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler"}]
@spectrum[{"id": "sp", "divider-after": true}]
@switchfile[{"id":"cd", "label":"Use Cache-DiT", "arg":"--cache-dit", "exclude":["sp"], "file-implies-switch":true, "file":{"label":"Cache-DiT YAML Config", "arg":"--cache-dit-config", "mode":"input", "optional":true, "file-types":["yaml"], "divider-after":true}}]
@dype[{"exclude":["cd", "sp"], "divider-after":true}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"], "default":1}]
@torchcompile[{"model-type":"hyvideo-15"}]
@quantizer[{"model-type":"hyvideo-15"}]
@textencoders[{"model-type":"hyvideo-15", "arg":"--text-encoders", "divider-after":true, "defaults":["Qwen2_5_VLTextModel;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q4_K_S.gguf", null], "suggestions":[[{"label":"Q4_K_S", "value":"Qwen2_5_VLTextModel;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q4_K_S.gguf"}, {"label":"Q2_K", "value":"Qwen2_5_VLTextModel;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q2_K.gguf"}, {"label":"Q3_K_S", "value":"Qwen2_5_VLTextModel;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q3_K_S.gguf"}, {"label":"Q3_K_M", "value":"Qwen2_5_VLTextModel;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q3_K_M.gguf"}, {"label":"Q4_0", "value":"Qwen2_5_VLTextModel;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q4_0.gguf"}, {"label":"Q4_1", "value":"Qwen2_5_VLTextModel;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q4_1.gguf"}, {"label":"Q4_K_M", "value":"Qwen2_5_VLTextModel;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf"}, {"label":"Q5_K_S", "value":"Qwen2_5_VLTextModel;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q5_K_S.gguf"}, {"label":"Q5_K_M", "value":"Qwen2_5_VLTextModel;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q5_K_M.gguf"}, {"label":"Q6_K", "value":"Qwen2_5_VLTextModel;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q6_K.gguf"}, {"label":"Q8_0", "value":"Qwen2_5_VLTextModel;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q8_0.gguf"}, {"label":"IQ4_NL", "value":"Qwen2_5_VLTextModel;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-IQ4_NL.gguf"}, {"label":"IQ4_XS", "value":"Qwen2_5_VLTextModel;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-IQ4_XS.gguf"}, {"label":"Q2_K_L", "value":"Qwen2_5_VLTextModel;model=https://huggingface.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF/blob/main/Qwen2.5-VL-7B-Instruct-Q2_K_L.gguf"}], null]}]
@switch[{"label":"VAE Slicing", "arg":"--vae-slicing"}]
@submodelbuilder[{"id":"lora", "label":"LoRA", "arg":"--loras", "model":"LoRA"}]
@float[{"label":"LoRA Fuse Scale","arg":"--lora-fuse-scale","min":0, "enabled-when":{"id":"lora","not-empty":true}}]
@switch[{"label":"LoRA Disk Fuse", "arg":"--lora-disk-fuse", "enabled-when":{"id":"lora","not-empty":true}}]
@submodelbuilder[{"label":"Transformer", "arg":"--transformer", "model":"Transformer", "default":"https://huggingface.co/jayn7/HunyuanVideo-1.5_I2V_480p-GGUF/blob/main/480p/hunyuanvideo1.5_480p_i2v-Q4_K_S.gguf", "divider-after":true, "suggestions":[{"label":"Q4_K_S", "value":"https://huggingface.co/jayn7/HunyuanVideo-1.5_I2V_480p-GGUF/blob/main/480p/hunyuanvideo1.5_480p_i2v-Q4_K_S.gguf"}, {"label":"Q4_K_M", "value":"https://huggingface.co/jayn7/HunyuanVideo-1.5_I2V_480p-GGUF/blob/main/480p/hunyuanvideo1.5_480p_i2v-Q4_K_M.gguf"}, {"label":"Q5_K_S", "value":"https://huggingface.co/jayn7/HunyuanVideo-1.5_I2V_480p-GGUF/blob/main/480p/hunyuanvideo1.5_480p_i2v-Q5_K_S.gguf"}, {"label":"Q5_K_M", "value":"https://huggingface.co/jayn7/HunyuanVideo-1.5_I2V_480p-GGUF/blob/main/480p/hunyuanvideo1.5_480p_i2v-Q5_K_M.gguf"}, {"label":"Q6_K", "value":"https://huggingface.co/jayn7/HunyuanVideo-1.5_I2V_480p-GGUF/blob/main/480p/hunyuanvideo1.5_480p_i2v-Q6_K.gguf"}, {"label":"Q8_0", "value":"https://huggingface.co/jayn7/HunyuanVideo-1.5_I2V_480p-GGUF/blob/main/480p/hunyuanvideo1.5_480p_i2v-Q8_0.gguf"}]}]
@imageprocessor[{"arg":"--seed-image-processors", "label":"First Frame Processor", "enabled-when":{"id":"image-seed","not-empty":true}}]
@int[{"id":"is","label":"Inference Steps","arg":"--inference-steps","default":50,"min":1,"exclude":["ts"]}]
@sigmas[{"id":"sigmas","label":"Sigmas","arg":"--sigmas","base":[1.0,0.98,0.96,0.94,0.92,0.9,0.88,0.86,0.84,0.82,0.8,0.78,0.76,0.74,0.72,0.7,0.68,0.66,0.64,0.62,0.6,0.58,0.56,0.54,0.52,0.5,0.48,0.46,0.44,0.42,0.4,0.38,0.36,0.34,0.32,0.3,0.28,0.26,0.24,0.22,0.2,0.18,0.16,0.14,0.12,0.1,0.08,0.06,0.04,0.02],"exclude":["ts"]}]
@timesteps[{"id":"ts","label":"Timesteps (override)","arg":"--timesteps","default":"","exclude":["is","sigmas"]}]
@float[{"label":"Guidance Scale", "arg":"--guidance-scales", "default":6, "min":0}]
@float[{"label":"Video Length (seconds)", "arg":"--video-lengths", "default":4, "min":0.1}]
@float[{"label":"Video FPS", "arg":"--video-fps", "default":15, "min":1}]
@dropdown[{"label":"Animation Format", "arg":"--animation-format", "options":["mp4", "gif", "webp", "apng", "frames"], "default":"mp4", "optional":false}]
@seeds[{"label":"Seeds"}]
@dir[{"label":"Output Directory", "arg":"--output-path", "default":"output"}]
@switch[{"label":"Output Configs", "arg":"--output-configs"}]
@imagesize[{"label":"Output Size (WxH)", "arg":"--output-size", "default":"848x480"}]
@promptupscaler[{"label":"Prompt Upscaler", "arg":"--prompt-upscaler"}]
@imageprocessor[{"arg":"--post-processors", "label":"Post Processor"}]
@device[{}]
--prompts "add your prompt here"
