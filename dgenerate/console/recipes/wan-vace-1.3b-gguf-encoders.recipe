title: Wan 2.1 VACE 1.3B (GGUF + Encoders)

# Wan VACE control. control= is the control clip, mask= is optional,
# reference= is a still. --wan-conditioning-scales is a scalar or
# a comma-separated per-layer list.

\setp auth_token "@string[{"label": "Hugging Face Auth Token", "default":"$HF_TOKEN", "optional":false}]"

\set auth_token {{ '--auth-token ' + quote(auth_token) if auth_token else '' }}

\setp first_frame "@file[{"id":"image-seed-3", "label":"First Frame (optional)", "optional":true, "mode":"input", "file-types":["images-in"]}]"
\setp control_clip "@file[{"id":"image-seed-2", "label":"Control Clip", "optional":false, "mode":"input", "file-types":["images-in", "videos-in"]}]"
\setp mask_clip "@file[{"id":"image-seed", "label":"Mask Clip", "optional":true, "mode":"input", "file-types":["images-in", "videos-in"]}]"
\setp reference "@file[{"id":"image-seed-4", "label":"Reference Image", "optional":true, "mode":"input", "file-types":["images-in"], "divider-after":true}]"

\set image_seeds {{ format_image_seed(seed_images=first_frame, control_images=control_clip, mask_images=mask_clip, reference_images=reference, preserve_control=True) }}
\set image_seeds {{ '--image-seeds ' + quote(image_seeds) if image_seeds else '' }}

@uri[{"label":"Model Path / HF Slug", "dir":true, "default": "Wan-AI/Wan2.1-VACE-1.3B-diffusers", "optional":false, "file-types":["models"]}]
--model-type wan {{ image_seeds }} {{ auth_token }}
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["float16", "bfloat16", "float32"], "default":"bfloat16"}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler"}]
@spectrum[{"id": "sp", "divider-after": true}]
@switchfile[{"id": "cd", "label":"Use Cache-DiT", "arg":"--cache-dit", "exclude":["tc", "sada", "sp"], "file-implies-switch":true, "file":{"label":"Cache-DiT YAML Config", "arg":"--cache-dit-config", "mode":"input", "optional":true, "file-types":["yaml"], "divider-after":true}}]
@dype[{"exclude":["cd", "sp"],"divider-after":true}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"], "default":1}]
@torchcompile[{"model-type":"wan"}]
@switch[{"label":"VAE Slicing", "arg":"--vae-slicing"}]
@quantizer[{"model-type":"wan"}]
@textencoders[{"model-type":"wan", "arg":"--text-encoders", "divider-after":true, "defaults":["UMT5EncoderModel;model=https://huggingface.co/city96/umt5-xxl-encoder-gguf/blob/main/umt5-xxl-encoder-Q4_K_S.gguf"], "suggestions":[[{"label":"Q4_K_S", "value":"UMT5EncoderModel;model=https://huggingface.co/city96/umt5-xxl-encoder-gguf/blob/main/umt5-xxl-encoder-Q4_K_S.gguf"}, {"label":"Q3_K_S", "value":"UMT5EncoderModel;model=https://huggingface.co/city96/umt5-xxl-encoder-gguf/blob/main/umt5-xxl-encoder-Q3_K_S.gguf"}, {"label":"Q3_K_M", "value":"UMT5EncoderModel;model=https://huggingface.co/city96/umt5-xxl-encoder-gguf/blob/main/umt5-xxl-encoder-Q3_K_M.gguf"}, {"label":"Q4_K_M", "value":"UMT5EncoderModel;model=https://huggingface.co/city96/umt5-xxl-encoder-gguf/blob/main/umt5-xxl-encoder-Q4_K_M.gguf"}, {"label":"Q5_K_S", "value":"UMT5EncoderModel;model=https://huggingface.co/city96/umt5-xxl-encoder-gguf/blob/main/umt5-xxl-encoder-Q5_K_S.gguf"}, {"label":"Q5_K_M", "value":"UMT5EncoderModel;model=https://huggingface.co/city96/umt5-xxl-encoder-gguf/blob/main/umt5-xxl-encoder-Q5_K_M.gguf"}, {"label":"Q6_K", "value":"UMT5EncoderModel;model=https://huggingface.co/city96/umt5-xxl-encoder-gguf/blob/main/umt5-xxl-encoder-Q6_K.gguf"}, {"label":"Q8_0", "value":"UMT5EncoderModel;model=https://huggingface.co/city96/umt5-xxl-encoder-gguf/blob/main/umt5-xxl-encoder-Q8_0.gguf"}]]}]
@submodelbuilder[{"id":"lora", "label":"LoRA", "arg":"--loras", "model": "LoRA"}]
@float[{"label":"LoRA Fuse Scale","arg":"--lora-fuse-scale","min":0, "enabled-when":{"id":"lora","not-empty":true}}]
@switch[{"label":"LoRA Disk Fuse", "arg":"--lora-disk-fuse", "enabled-when":{"id":"lora","not-empty":true}}]
@submodelbuilder[{"label": "Transformer GGUF", "arg": "--transformer", "model": "Transformer", "default": "https://huggingface.co/Teriks/Wan2.1-VACE-1.3B-quants/blob/main/transformer-Q4_K-comfy.gguf", "divider-after": true, "suggestions": [{"label": "Q4_K", "value": "https://huggingface.co/Teriks/Wan2.1-VACE-1.3B-quants/blob/main/transformer-Q4_K-comfy.gguf"}, {"label": "Q2_K", "value": "https://huggingface.co/Teriks/Wan2.1-VACE-1.3B-quants/blob/main/transformer-Q2_K-comfy.gguf"}, {"label": "Q3_K", "value": "https://huggingface.co/Teriks/Wan2.1-VACE-1.3B-quants/blob/main/transformer-Q3_K-comfy.gguf"}, {"label": "Q4_0", "value": "https://huggingface.co/Teriks/Wan2.1-VACE-1.3B-quants/blob/main/transformer-Q4_0-comfy.gguf"}, {"label": "Q4_1", "value": "https://huggingface.co/Teriks/Wan2.1-VACE-1.3B-quants/blob/main/transformer-Q4_1-comfy.gguf"}, {"label": "Q5_0", "value": "https://huggingface.co/Teriks/Wan2.1-VACE-1.3B-quants/blob/main/transformer-Q5_0-comfy.gguf"}, {"label": "Q5_1", "value": "https://huggingface.co/Teriks/Wan2.1-VACE-1.3B-quants/blob/main/transformer-Q5_1-comfy.gguf"}, {"label": "Q5_K", "value": "https://huggingface.co/Teriks/Wan2.1-VACE-1.3B-quants/blob/main/transformer-Q5_K-comfy.gguf"}, {"label": "Q6_K", "value": "https://huggingface.co/Teriks/Wan2.1-VACE-1.3B-quants/blob/main/transformer-Q6_K-comfy.gguf"}, {"label": "Q8_0", "value": "https://huggingface.co/Teriks/Wan2.1-VACE-1.3B-quants/blob/main/transformer-Q8_0-comfy.gguf"}, {"label": "IQ4_NL", "value": "https://huggingface.co/Teriks/Wan2.1-VACE-1.3B-quants/blob/main/transformer-IQ4_NL-comfy.gguf"}, {"label": "IQ4_XS", "value": "https://huggingface.co/Teriks/Wan2.1-VACE-1.3B-quants/blob/main/transformer-IQ4_XS-comfy.gguf"}]}]
@switch[{"label":"No Aspect Correction?", "arg":"--no-aspect", "divider-after":true, "enabled-when":{"any":[{"id":"image-seed","not-empty":true},{"id":"image-seed-2","not-empty":true},{"id":"image-seed-3","not-empty":true},{"id":"image-seed-4","not-empty":true}]}}]
@int[{"label":"Inference Steps","arg":"--inference-steps","default":30,"min":1,"id":"is","exclude":["ts"]}]
@sigmas[{"id":"sigmas","label":"Sigmas","arg":"--sigmas","base":[0.999999,0.9667,0.9334,0.9001,0.8668,0.8335,0.8002,0.7669,0.7336,0.7003,0.667,0.6337,0.6004,0.5671,0.5338,0.5005,0.4672,0.4339,0.4006,0.3673,0.334,0.3007,0.2674,0.2341,0.2008,0.1675,0.1342,0.1009,0.0676,0.0343],"exclude":["ts"]}]
@timesteps[{"id":"ts","label":"Timesteps (override)","arg":"--timesteps","default":"","exclude":["is","sigmas"]}]
@float[{"label":"Guidance Scale", "arg":"--guidance-scales", "default":5, "min":0}]
@string[{"label":"VACE Conditioning Scales", "arg":"--wan-conditioning-scales"}]
@float[{"label":"Video Length (seconds)", "arg":"--video-lengths", "min":0.1}]
@float[{"label":"Video FPS", "arg":"--video-fps", "default":"16", "min":1, "divider-after":true}]
@dropdown[{"label":"Animation Format", "arg":"--animation-format", "options":["mp4", "gif", "webp", "apng", "frames"], "default":"mp4", "optional":false}]
@seeds[{"label":"Seeds"}]
@dir[{"label":"Output Directory", "arg":"--output-path", "default":"output"}]
@switchradio[{"labels":["Output Dgenerate Image Metadata", "Output Automatic1111 Image Metadata"], "args":["--output-metadata", "--output-auto1111-metadata"]}]
@switch[{"label":"Output Configs", "arg":"--output-configs"}]
@imagesize[{"label":"Output Size (WxH)", "arg":"--output-size", "default":"832x480", "divider-after":true}]
@promptupscaler[{"label":"Prompt Upscaler", "arg":"--prompt-upscaler"}]
@imageprocessor[{"arg":"--mask-image-processors", "label":"Mask Clip Processor", "enabled-when":{"id":"image-seed","not-empty":true}}]
@imageprocessor[{"arg":"--control-image-processors", "label":"Control Clip Processor", "enabled-when":{"any":[{"id":"image-seed","not-empty":true},{"id":"image-seed-2","not-empty":true},{"id":"image-seed-3","not-empty":true},{"id":"image-seed-4","not-empty":true}]}}]
@imageprocessor[{"arg":"--post-processors", "label":"Post Processor"}]
@device[{}]
--prompts "add your prompt here"
