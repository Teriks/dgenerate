title: Qwen-Image 2.1 (GGUF)

# Select a GGUF transformer compatible with the chosen Qwen-Image 2.1 checkpoint.

@uri[{"label":"Model Path / HF Slug", "dir":true, "default":"Qwen/Qwen-Image-2.1", "optional":false, "file-types":["models"]}]
--model-type qwen-image-21
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["bfloat16", "float16", "float32"], "default":"bfloat16"}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler", "filter":["FlowMatchEulerDiscreteScheduler"]}]
@switch[{"label":"Use Spectrum", "arg":"--spectrum"}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"], "default":1}]
@switch[{"label":"Torch Compile", "arg":"--torch-compile"}]
@switch[{"label":"Disable KV Cache", "arg":"--qwen21-no-kv-cache"}]
@quantizer[{"divider-after":true}]
@submodelbuilder[{"label":"LoRA", "arg":"--loras", "model":"LoRA"}]
@submodelbuilder[{"label":"Transformer", "arg":"--transformer", "model":"Transformer", "default":"https://huggingface.co/molbal/Qwen-Image-2.1-GGUF/blob/main/qwen_image_2.1_Q4_0.gguf", "divider-after":true}]
@imageseed[{"label":"Condition Image", "arg":"--image-seeds", "file-types":["images-in"], "hide-float":true}]
@int[{"label":"Inference Steps", "arg":"--inference-steps", "default":40, "min":1}]
@float[{"label":"True CFG Scale", "arg":"--guidance-scales", "default":1, "min":0}]
@seeds[{"label":"Seeds"}]
@dir[{"label":"Output Directory", "arg":"--output-path", "default":"output"}]
@imageformat[{}]
@imagesize[{"id":"os", "label":"Output Size", "arg":"--output-size", "default":"1024x1024", "exclude":["qres"]}]
@int[{"id":"qres", "label":"Target Resolution (Aspect-Correct)", "arg":"--qwen21-output-resolution", "optional":true, "min":256, "exclude":["os"]}]
@device[{}]
--prompts "add your prompt here"
