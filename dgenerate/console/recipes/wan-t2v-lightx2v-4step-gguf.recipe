title: Wan 2.1 Text to Video (4-step LoRA, GGUF)

# LightX2V 4-step LoRA for the undistilled Wan 2.1 14B text-to-video model.
# Guidance stays at 1. UniPC flow-shift=5 with 4 steps is the LightX2V schedule.

\setp auth_token "@string[{"label": "Hugging Face Auth Token", "default":"$HF_TOKEN", "optional":false}]"

\set auth_token {{ '--auth-token ' + quote(auth_token) if auth_token else '' }}

@uri[{"label":"Model Path / HF Slug", "dir":true, "default": "Wan-AI/Wan2.1-T2V-14B-Diffusers", "optional":false, "file-types":["models"]}]
--model-type wan {{ auth_token }}
@dropdown[{"label":"Model dtype", "arg":"--dtype", "options":["float16", "bfloat16", "float32"], "default":"bfloat16"}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler", "filter": ["UniPCMultistepScheduler"], "optional":false, "default":"UniPCMultistepScheduler;flow-shift=5"}]
@spectrum[{"id": "sp", "divider-after": true}]
@switchfile[{"id": "cd", "label":"Use Cache-DiT", "arg":"--cache-dit", "exclude":["tc", "sada", "sp"], "file-implies-switch":true, "file":{"label":"Cache-DiT YAML Config", "arg":"--cache-dit-config", "mode":"input", "optional":true, "file-types":["yaml"], "divider-after":true}}]
@dype[{"exclude":["cd", "sp"],"divider-after":true}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"], "default":1}]
@torchcompile[{"model-type":"wan"}]
@quantizer[{"model-type":"wan", "map-default":"text_encoder"}]
@textencoders[{"model-type":"wan","arg":"--text-encoders", "divider-after":true}]
@switch[{"label":"VAE Slicing", "arg":"--vae-slicing"}]
@submodelbuilder[{"label":"VAE", "arg":"--vae", "model": "VAE"}]
@submodelbuilder[{"id":"lora", "label":"LoRA", "arg":"--loras", "model": "LoRA", "default":"lightx2v/Wan2.1-Distill-Loras;scale=1.0;weight-name=wan2.1_t2v_14b_lora_rank64_lightx2v_4step.safetensors"}]
@float[{"label":"LoRA Fuse Scale","arg":"--lora-fuse-scale","min":0, "enabled-when":{"id":"lora","not-empty":true}}]
@switch[{"label":"LoRA Disk Fuse", "arg":"--lora-disk-fuse", "enabled-when":{"id":"lora","not-empty":true}}]
@submodelbuilder[{"label":"Transformer", "arg":"--transformer", "model":"Transformer", "default":"https://huggingface.co/city96/Wan2.1-T2V-14B-gguf/blob/main/wan2.1-t2v-14b-Q4_K_S.gguf", "divider-after":true, "suggestions":[{"label":"Q4_K_S", "value":"https://huggingface.co/city96/Wan2.1-T2V-14B-gguf/blob/main/wan2.1-t2v-14b-Q4_K_S.gguf"}, {"label":"Q3_K_S", "value":"https://huggingface.co/city96/Wan2.1-T2V-14B-gguf/blob/main/wan2.1-t2v-14b-Q3_K_S.gguf"}, {"label":"Q3_K_M", "value":"https://huggingface.co/city96/Wan2.1-T2V-14B-gguf/blob/main/wan2.1-t2v-14b-Q3_K_M.gguf"}, {"label":"Q4_0", "value":"https://huggingface.co/city96/Wan2.1-T2V-14B-gguf/blob/main/wan2.1-t2v-14b-Q4_0.gguf"}, {"label":"Q4_1", "value":"https://huggingface.co/city96/Wan2.1-T2V-14B-gguf/blob/main/wan2.1-t2v-14b-Q4_1.gguf"}, {"label":"Q4_K_M", "value":"https://huggingface.co/city96/Wan2.1-T2V-14B-gguf/blob/main/wan2.1-t2v-14b-Q4_K_M.gguf"}, {"label":"Q5_0", "value":"https://huggingface.co/city96/Wan2.1-T2V-14B-gguf/blob/main/wan2.1-t2v-14b-Q5_0.gguf"}, {"label":"Q5_1", "value":"https://huggingface.co/city96/Wan2.1-T2V-14B-gguf/blob/main/wan2.1-t2v-14b-Q5_1.gguf"}, {"label":"Q5_K_S", "value":"https://huggingface.co/city96/Wan2.1-T2V-14B-gguf/blob/main/wan2.1-t2v-14b-Q5_K_S.gguf"}, {"label":"Q5_K_M", "value":"https://huggingface.co/city96/Wan2.1-T2V-14B-gguf/blob/main/wan2.1-t2v-14b-Q5_K_M.gguf"}, {"label":"Q6_K", "value":"https://huggingface.co/city96/Wan2.1-T2V-14B-gguf/blob/main/wan2.1-t2v-14b-Q6_K.gguf"}, {"label":"Q8_0", "value":"https://huggingface.co/city96/Wan2.1-T2V-14B-gguf/blob/main/wan2.1-t2v-14b-Q8_0.gguf"}]}]
@switch[{"label":"No Aspect Correction?", "arg":"--no-aspect", "divider-after":true}]
@int[{"label":"Inference Steps", "arg":"--inference-steps", "default":4, "min":1}]
@float[{"label":"Guidance Scale", "arg":"--guidance-scales", "default":1, "min":0, "divider-after":true}]
@float[{"label":"Video Length (seconds)", "arg":"--video-lengths", "default":5, "min":0.1}]
@float[{"label":"Video FPS", "arg":"--video-fps", "default":"16", "min":1, "divider-after":true}]
@dropdown[{"label":"Animation Format", "arg":"--animation-format", "options":["mp4", "gif", "webp", "apng", "frames"], "default":"mp4", "optional":false}]
@seeds[{"label":"Seeds"}]
@dir[{"label":"Output Directory", "arg":"--output-path", "default":"output"}]
@switchradio[{"labels":["Output Dgenerate Image Metadata", "Output Automatic1111 Image Metadata"], "args":["--output-metadata", "--output-auto1111-metadata"]}]
@switch[{"label":"Output Configs", "arg":"--output-configs"}]
@imagesize[{"label":"Output Size (WxH)", "arg":"--output-size", "default":"832x480", "divider-after":true}]
@promptupscaler[{"label":"Prompt Upscaler", "arg":"--prompt-upscaler"}]
@imageprocessor[{"arg":"--post-processors", "label":"Post Processor"}]
@device[{}]
--prompts "add your prompt here"
