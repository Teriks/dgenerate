title: Upscaling (Stable Diffusion x2)

@uri[{"label":"Model Path / HF Slug", "dir":true, "default": "stabilityai/sd-x2-latent-upscaler", "optional":false, "file-types":["models"]}]
@file[{"label": "Original Config (yaml)", "arg": "--original-config", "file-types": ["yaml"]}]
@karrasscheduler[{"label":"Scheduler", "arg":"--scheduler"}]
@switchradio[{"labels":["Model CPU Offload", "Model Sequential Offload", "Model Group Offload"], "args":["--model-cpu-offload", "--model-sequential-offload", "--model-group-offload"]}]
@torchcompile[{"model-type":"upscaler-x2"}]
@quantizer[{"model-type":"upscaler-x2"}]
@textencoders[{"model-type":"upscaler-x2","arg":"--text-encoders", "divider-after":true}]
--model-type upscaler-x2
--dtype float16
@file[{"id":"image-seed", "label":"Input Image File", "arg":"--image-seeds", "optional":false, "mode":"input", "file-types":["images-in", "videos-in"]}]
@imageprocessor[{"arg":"--seed-image-processors", "label":"Input Image Processor", "divider-after":true, "enabled-when":{"id":"image-seed","not-empty":true}}]
@submodelbuilder[{"label":"VAE", "arg":"--vae", "model": "VAE"}]
@switch[{"label":"VAE Tiling", "arg":"--vae-tiling"}]
@switch[{"label":"VAE Slicing", "arg":"--vae-slicing", "divider-after":true}]
@int[{"label":"Inference Steps","arg":"--inference-steps","default":30,"min":1,"id":"is","exclude":["ts"]}]
@sigmas[{"id":"sigmas","label":"Sigmas","arg":"--sigmas","base":[14.614641,11.879323,9.655955,7.848719,6.37973,5.185681,4.215114,3.426201,2.784944,2.263706,1.840024,1.49564,1.215712,0.988175,0.803226,0.652892,0.530695,0.431368,0.350632,0.285007,0.231664,0.188305,0.153061,0.124414,0.101128,0.082201,0.066816,0.05431,0.044146,0.035883],"exclude":["ts"]}]
@timesteps[{"id":"ts","label":"Timesteps (override)","arg":"--timesteps","default":"","exclude":["is","sigmas"]}]
@float[{"label":"Guidance Scale", "arg":"--guidance-scales", "default":5, "min":0}]
@float[{"label":"Guidance Rescale", "arg":"--guidance-rescales", "min":0}]
@seeds[{"label":"Seeds"}]
@int[{"label":"Batch Size", "arg":"--batch-size", "default":"", "min":1}]
@imagesize[{"label":"Batch Grid Size (CxR)", "arg":"--batch-grid-size", "default":"", "divider-after":true}]
@dir[{"label":"Output Directory", "arg":"--output-path", "default":"output"}]
@imageformat[{}]
@switchradio[{"labels":["Output Dgenerate Image Metadata", "Output Automatic1111 Image Metadata"], "args":["--output-metadata", "--output-auto1111-metadata"]}]
@switch[{"label":"Output Configs", "arg":"--output-configs"}]
@imagesize[{"label":"Input Resize (WxH)", "arg":"--output-size", "default":""}]
@promptupscaler[{"label":"Prompt Upscaler", "arg":"--prompt-upscaler"}]
@imageprocessor[{"arg":"--post-processors", "label":"Post Processor"}]
@device[{}]
--prompts "add your prompt here"
